---
import PageHero from './PageHero.astro';
import Imports2026 from './Imports2026.astro';
import CTA from './CTA.astro';
import { langFromPath, t } from '../i18n';
const lang = langFromPath(Astro.url.pathname) as 'en' | 'fa' | 'zh' | 'tr';
const s = t(lang);
const H = {
  en: { title: 'Import activity', desc: 'What Hanpars brought into Iran in 2026: customs-cleared value month by month, and the molecules behind it.' },
  fa: { title: 'فعالیت واردات', desc: 'آنچه هانیا پرسان دارو در ۲۰۲۶ وارد ایران کرده است: ارزش ترخیص گمرکی ماه به ماه و مولکول‌های پشت آن.' },
  zh: { title: '进口动态', desc: 'Hanpars 2026 年输入伊朗的药品：逐月清关金额及其背后的分子。' },
  tr: { title: 'İthalat faaliyeti', desc: 'Hanpars’ın 2026’da İran’a getirdikleri: aylara göre gümrükten çekilen değer ve bunun ardındaki moleküller.' },
}[lang];
const company = (s.groups as { label: string; items: { href: string }[] }[]).find(g => g.items.some(i => i.href === '/about-us'))?.label;
---
<PageHero title={H.title} category={company} description={H.desc} />
<Imports2026 variant="page" />
<CTA />
