---
/** One regulatory-affairs service page (/regulatory-affairs/<slug>), with Service + FAQPage structured data. */
import PageHero from './PageHero.astro';
import Icon from './Icon.astro';
import { raServices, raUi, type RaService, type RaLang } from '../data/ra-services';
import { langFromPath, localePath } from '../i18n';
interface Props { service: RaService }
const { service } = Astro.props;
const site = { origin: (Astro.site?.origin) || 'https://hanpars.com' };
const lang = langFromPath(Astro.url.pathname) as RaLang;
const c = service.t[lang] || service.t.en;
const ui = raUi[lang] || raUi.en;
const L = (p: string) => localePath(p, lang);
const num = (i: number) => (lang === 'fa' ? (i + 1).toLocaleString('fa-IR') : String(i + 1).padStart(2, '0'));
const enquiry = L(`/contact-us-1?type=regulatory${service.formItem ? `&service=${service.formItem}` : ''}`);
const url = `${site.origin}${L(`/regulatory-affairs/${service.slug}`)}`;
const icons = ['file', 'search', 'molecule', 'layers', 'shield', 'globe'];
const others = raServices.filter(s => s.slug !== service.slug);
const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', '@id': `${url}#service`, name: c.title, serviceType: service.serviceType, description: c.metaDesc, url,
    provider: { '@id': `${site.origin}/#organization` }, areaServed: ['Iran', 'European Union', 'United Kingdom', 'Türkiye', 'Russia', 'Middle East'], availableLanguage: ['en', 'fa'],
    hasOfferCatalog: { '@type': 'OfferCatalog', name: c.whatTitle, itemListElement: c.what.map(w => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: w.h, description: w.p } })) } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<PageHero title={c.title} category={ui.category} description={c.lead} action={ui.cta} href={enquiry}/>

<section class="section rs-intro">
  <div class="container rs-intro-grid">
    <h2>{c.introTitle}</h2>
    <div class="rs-intro-copy">{c.intro.map(p => <p>{p}</p>)}</div>
  </div>
</section>

<section class="section section-paper">
  <div class="container">
    <div class="section-head"><h2>{c.whatTitle}</h2></div>
    <ol class="rs-grid">
      {c.what.map((w, i) => <li class="rs-card"><div class="rs-card-head"><span class="rs-ico"><Icon name={icons[i % icons.length]} size={20}/></span><span class="rs-num" aria-hidden="true">{num(i)}</span></div><h3>{w.h}</h3><p>{w.p}</p></li>)}
    </ol>
  </div>
</section>

{c.extra && c.extra.length > 0 && <section class="section rs-extra-sec">
  <div class="container rs-extra">
    {c.extra.map((x, i) => <article class="rs-extra-card"><span class="rs-ico"><Icon name={i === 0 ? 'file' : 'layers'} size={20}/></span><h2>{x.h}</h2><p>{x.p}</p><ul>{x.items.map(it => <li><Icon name="check" size={17} class="rs-check"/><span>{it}</span></li>)}</ul></article>)}
  </div>
</section>}

<section class="section">
  <div class="container rs-split">
    <div class="rs-deliv">
      <h2>{c.delivTitle}</h2>
      <ul>{c.deliv.map(d => <li><Icon name="check" size={17} class="rs-check"/><span>{d}</span></li>)}</ul>
    </div>
    <aside class="rs-note">
      <p class="rs-note-title">{ui.record}</p>
      <p>{ui.recordNote}</p>
      <a class="text-link" href={L('/regulatory-affairs#record')}>{ui.back}</a>
    </aside>
  </div>
</section>

<section class="section rs-band">
  <div class="container">
    <div class="section-head"><h2>{c.stepsTitle}</h2></div>
    <ol class="rs-steps" style={`--n:${c.steps.length}`}>
      {c.steps.map((s, i) => <li class="rs-step"><span class="rs-step-num" aria-hidden="true">{num(i)}</span><h3>{s.h}</h3><p>{s.p}</p></li>)}
    </ol>
  </div>
</section>

<section class="section">
  <div class="container rs-faq-grid">
    <h2>{ui.faqTitle}</h2>
    <div class="rs-faq">{c.faq.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </div>
</section>

<section class="section section-paper">
  <div class="container">
    <div class="section-head"><h2>{ui.related}</h2></div>
    <ul class="rs-related">
      {others.map(o => <li><a href={L(`/regulatory-affairs/${o.slug}`)}><Icon name={o.icon} size={20}/><span>{(o.t[lang] || o.t.en).nav}</span><Icon name="arrow" size={16} class="rs-arrow"/></a></li>)}
      <li><a href={L('/regulatory-affairs')}><Icon name="globe" size={20}/><span>{ui.back}</span><Icon name="arrow" size={16} class="rs-arrow"/></a></li>
    </ul>
  </div>
</section>

<section class="invite"><div class="container invite-inner"><div>
  <h2>{ui.cta}</h2><p class="lede">{ui.ctaText}</p>
  <div class="actions"><a class="button button-navy" href={enquiry} rel="nofollow">{ui.cta}</a></div>
</div></div></section>

{ld.map(b => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}

<style>
  .rs-intro-grid { display:grid; grid-template-columns:minmax(0,5fr) minmax(0,7fr); gap:clamp(28px,5vw,72px); align-items:start; }
  .rs-intro-copy p { font-size:18px; color:var(--ink); }
  .rs-intro-copy p:last-child { margin-bottom:0; color:var(--muted); }
  .rs-grid { list-style:none; padding:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
  .rs-card { display:flex; flex-direction:column; gap:10px; padding:22px 22px 24px; border:1px solid var(--line); border-radius:18px; background:var(--white); }
  .rs-card-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:4px; }
  .rs-ico { display:inline-grid; place-items:center; width:42px; height:42px; border-radius:12px; background:var(--glacier-soft); color:var(--lapis-deep); }
  .rs-num { font:600 15px/1 var(--display); color:var(--faint); }
  .rs-card h3 { font-size:19px; }
  .rs-card p { margin:0; font-size:16px; line-height:1.55; color:var(--muted); }
  .rs-split { display:grid; grid-template-columns:minmax(0,7fr) minmax(0,5fr); gap:clamp(28px,5vw,64px); align-items:start; }
  .rs-deliv ul { list-style:none; padding:0; margin:20px 0 0; display:grid; }
  .rs-deliv li { display:flex; gap:12px; padding:14px 0; border-top:1px solid var(--line); line-height:1.5; }
  .rs-check { flex:none; margin-top:4px; color:var(--lapis); }
  .rs-note { padding:26px; border-radius:20px; background:var(--paper); border:1px solid var(--line); }
  .rs-note-title { font-weight:600; color:var(--ink); margin:0 0 8px; }
  .rs-note p { color:var(--muted); font-size:15.5px; }
  .rs-band { background:var(--black); color:var(--on-navy); }
  .rs-band h2, .rs-band h3 { color:#fff; }
  .rs-steps { list-style:none; padding:0; display:grid; grid-template-columns:repeat(var(--n),minmax(0,1fr)); gap:0; }
  .rs-step { position:relative; padding:22px 20px 4px 0; border-top:1px solid #ffffff2e; }
  :global([dir=rtl]) .rs-step { padding:22px 0 4px 20px; }
  .rs-step::before { content:''; position:absolute; top:-5px; inset-inline-start:0; width:9px; height:9px; border-radius:50%; background:var(--glacier); }
  .rs-step-num { display:block; margin:6px 0 12px; font:600 30px/1 var(--display); color:var(--glacier); }
  .rs-step h3 { font-size:18px; margin-bottom:8px; }
  .rs-step p { margin:0; font-size:15.5px; line-height:1.55; color:var(--on-navy-muted); }
  .rs-faq-grid { display:grid; grid-template-columns:minmax(0,4fr) minmax(0,8fr); gap:clamp(24px,4vw,56px); align-items:start; }
  .rs-faq details { border-top:1px solid var(--line); padding:16px 0; } .rs-faq details:last-child { border-bottom:1px solid var(--line); }
  .rs-faq summary { cursor:pointer; font-weight:600; font-size:17px; list-style:none; display:flex; justify-content:space-between; gap:16px; }
  .rs-faq summary::after { content:'+'; color:var(--lapis); font-weight:500; } .rs-faq details[open] summary::after { content:'–'; }
  .rs-faq p { margin:12px 0 0; color:var(--muted); line-height:1.65; max-width:72ch; }
  .rs-related { list-style:none; padding:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
  .rs-related a { display:flex; align-items:center; gap:12px; padding:18px 20px; border:1px solid var(--line); border-radius:16px; background:var(--white); color:var(--ink); text-decoration:none; font-weight:600; height:100%; }
  .rs-related a:hover { border-color:var(--lapis); }
  .rs-related span { flex:1; }
  .rs-arrow { color:var(--lapis); flex:none; }
  :global([dir=rtl]) .rs-arrow { transform:scaleX(-1); }
  .rs-extra { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
  .rs-extra-card { display:flex; flex-direction:column; gap:12px; padding:28px; border:1px solid var(--line); border-radius:20px; background:var(--glacier-soft); }
  .rs-extra-card h2 { font-size:24px; margin:4px 0 0; }
  .rs-extra-card p { margin:0; color:var(--ink); line-height:1.6; }
  .rs-extra-card ul { list-style:none; padding:0; margin:4px 0 0; display:grid; }
  .rs-extra-card li { display:flex; gap:12px; padding:10px 0; border-top:1px solid var(--line); line-height:1.5; font-size:15.5px; }
  .rs-extra-card .rs-ico { background:var(--white); }
  @media (max-width:860px) { .rs-extra { grid-template-columns:1fr; } }
  @media (max-width:980px) { .rs-grid, .rs-related { grid-template-columns:repeat(2,minmax(0,1fr)); } .rs-steps { grid-template-columns:1fr 1fr; row-gap:18px; } }
  @media (max-width:860px) { .rs-intro-grid, .rs-split, .rs-faq-grid { grid-template-columns:1fr; } }
  @media (max-width:620px) { .rs-grid, .rs-related, .rs-steps { grid-template-columns:1fr; } }
</style>
