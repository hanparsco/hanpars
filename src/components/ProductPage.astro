---
import Icon from './Icon.astro';
import DosageFormIcon from './DosageFormIcon.astro';
import CTA from './CTA.astro';
import fdf from '../data/fdf.json';
import info from '../data/fdf-info.json';
import { infoL } from '../data/locale-info';
import editorial from '../data/fdf-editorial.json';
import molecules from '../data/molecules.json';
import portfolio from '../data/portfolio.json';
import { parseFdf, fdfSlug, infoKey, prettyName, slugify, sameIngredientIndex, labelUsable } from '../data/fdf-parse';
import { langFromPath, localePath, t, htmlLang, dir } from '../i18n';
import { locName, catalogueName, formL, ROUTE_L } from '../data/locale';
interface Props { entry: { name: string; code: string } }
const { entry } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const s = t(lang);
const m = s.product;
const L = (p: string) => localePath(p, lang);
const p0 = parseFdf(entry.name);
const unit = (x: string) => x.replace(/(\d)(dose|puff)/g, '$1 $2').replace(/(\d)\{dose\}/g, '$1 dose').replace(/\{dose\}/g, 'doses').replace(/\{([a-z]+)\}/g, '$1').replace(/\bug\b/g, 'µg');
const p = { ...p0, strength: unit(p0.strength), pack: unit(p0.pack) };
type Info = { generic:string; brand?:string; pharmClass?:string[]; moaClass?:string[]; routes?:string[]; forms?:string[]; moa?:string; indications?:string; dosage?:string; contraindications?:string; warnings?:string; boxed?:string; pregnancy?:string; storage?:string; setId?:string; effective?:string; missing?:boolean };
const infos = info as Record<string, Info>;
const comboKey = p.ingredients.length > 1 ? p.ingredients.map(i => infoKey(i)).sort().join(' + ') : '';
const parts = [...(comboKey ? [{ name: p.ingredient, key: comboKey, info: infos[comboKey] }] : []), ...(p.ingredients.length > 1 ? [] : p.ingredients.map(i => ({ name: i, key: infoKey(i), info: infos[infoKey(i)] })))];
const fdaPart = parts.find(x => labelUsable(x.key, x.info, p));
const edKey = comboKey || infoKey(p.ingredient);
const ed = !fdaPart ? (editorial as Record<string, any>)[edKey] : undefined;
const isEditorial = !!ed;
const mainPart = fdaPart || (ed ? { name: p.ingredient, key: edKey, info: { generic: prettyName(p.ingredient), ...ed.en, pharmClass: ed.en.pharmClass ? [ed.en.pharmClass] : [] } } : undefined);
const main = mainPart?.info as any;
type InfoFa = { moa?:string; indications?:string; dosage?:string; contraindications?:string; warnings?:string; boxed?:string; pregnancy?:string; storage?:string; pharmClass?:string };
const fa: InfoFa = lang !== 'en' && mainPart ? (isEditorial ? (ed![lang] || {}) : ((infoL[lang] as Record<string, InfoFa>)[mainPart.key] || {})) : {};
const T = (k: keyof InfoFa, en?: string) => fa[k] ? { text: fa[k] as string, fa: true } : { text: en || '', fa: false };
const sec = { moa: T('moa', main?.moa), indications: T('indications', main?.indications), dosage: T('dosage', main?.dosage), contraindications: T('contraindications', main?.contraindications), warnings: T('warnings', main?.warnings), boxed: T('boxed', main?.boxed), pregnancy: T('pregnancy', main?.pregnancy), storage: T('storage', main?.storage) };
const L1 = (x: { fa: boolean }) => x.fa ? { lang: htmlLang[lang], dir: dir(lang) } : { lang: 'en', dir: 'ltr' };
const title = prettyName(p.ingredient);
const formLabel = prettyName(p.form);
const routeLabel = p.route ? prettyName(p.route) : '';
// form and route in the page language (English data otherwise)
const fL = (form: string, route?: string) => (lang === 'en' ? '' : formL[lang](form, route || '')) || prettyName(form);
const rL = (route?: string) => !route ? '' : (lang === 'en' ? '' : ROUTE_L[lang][route.toUpperCase()]) || prettyName(route);
const locLang = lang === 'en' ? {} : { lang: htmlLang[lang], dir: dir(lang) };
const formShown = fL(p.form, p.route); const routeShown = rL(p.route);
const formIcon = (form: string, route: string) => {
  const f = (form + ' ' + route).toUpperCase();
  if (/INHAL|AEROSOL|SPRAY|NEBUL/.test(f)) return 'inhaler';
  if (/CREAM|OINTMENT|GEL|LOTION|PASTE|FOAM|SHAMPOO|PATCH|PLASTER/.test(f)) return 'gel';
  if (/POWDER|GRANUL|SACHET|LYOPHIL/.test(f) && !/INJECT|INFUSION|INTRAVENOUS/.test(f)) return 'powder';
  if (/CAPSULE/.test(f)) return 'capsule';
  if (/TABLET|LOZENGE|PASTILLE|CHEWABLE|ORODISPERSIBLE/.test(f)) return 'tablet';
  return 'vial';
};
const sameIngredient = (sameIngredientIndex(fdf as { name: string; code: string }[]).get(infoKey(p.ingredient)) || []).filter(e => e.code !== entry.code).slice(0, 40);
const mols = molecules as Record<string, { cid?: number | null; name: string; cas?: string }>;
const molLinks = p.ingredients.map(i => { const k = slugify(i); const hit = Object.keys(mols).find(sl => mols[sl].cid && (sl === k || sl.startsWith(k + '-') || k.startsWith(sl))); return hit ? { name: prettyName(i), href: L(`/api/${hit}`), cas: mols[hit].cas || '' } : null; }).filter(Boolean) as { name: string; href: string; cas: string }[];
const inPortfolio = (portfolio as any).groups?.some((g: any) => g.products?.some((pr: any) => infoKey(pr.name || '') === infoKey(p.ingredient)));
const enquiry = L(`/contact-us-1?type=sourcing&product=${encodeURIComponent(entry.name)}`);
const effective = main?.effective ? `${main.effective.slice(0,4)}-${main.effective.slice(4,6)}-${main.effective.slice(6,8)}` : '';
const dailymed = main?.setId ? `https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=${main.setId}` : '';
const locTitle0 = lang === 'en' ? '' : (locName(lang, title) || catalogueName(lang, 'fdf', entry.name) || '');
const locForm = lang === 'en' ? '' : formL[lang](p.form, p.route);
const locTitle = lang === 'tr' && locTitle0 ? locTitle0.charAt(0).toLocaleUpperCase('tr') + locTitle0.slice(1) : locTitle0;
const nameBoth = locTitle ? (lang === 'zh' ? `${locTitle}（${title}）` : `${locTitle} (${title})`) : title;
const labelName = main ? `${main.generic}${main.brand ? ` (${main.brand})` : ''}` : '';
const srcLine = ({
  en: `${m.source}: ${labelName} — US FDA prescribing information${effective ? `, ${effective}` : ''}`,
  fa: `${m.source}: اطلاعات تجویز مصوب FDA آمریکا برای ${labelName}${effective ? `، نسخهٔ ${effective}` : ''}؛`,
  zh: `${m.source}：美国 FDA 处方信息（${labelName}${effective ? `，${effective} 版` : ''}）`,
  tr: `${m.source}: ${labelName} için ABD FDA reçeteleme bilgisi${effective ? `, ${effective}` : ''}`,
} as Record<string, string>)[lang];
const seoNote = ({
  en: `${title} ${formLabel.toLowerCase()}${p.strength ? ' ' + p.strength : ''}: import of this medicine into the Iranian market can be arranged on request through Haniya Parsan Darou Co. (Hanpars), pharmaceutical importer of finished medicines and APIs, including emergency (urgent) import. Availability and registration status are confirmed per enquiry.`,
  fa: `${nameBoth}${locForm ? ' ' + locForm : ''}${p.strength ? ' ' + p.strength : ''}: امکان واردات و تأمین این داروی خارجی برای بازار ایران از طریق شرکت هانیا پرسان دارو، واردکنندهٔ دارو، فرآوردهٔ دارویی و مواد اولیهٔ دارویی، در صورت استعلام؛ از جمله داروی فوریتی. موجود بودن و وضعیت ثبت هر دارو هنگام استعلام اعلام می‌شود.`,
  zh: `${nameBoth}${locForm ? ' ' + locForm : ''}${p.strength ? ' ' + p.strength : ''}：可应要求由汉帕斯（汉尼亚帕尔桑药业有限公司）安排进口至伊朗市场，包括紧急进口；供应情况与注册状态以询盘确认为准。`,
  tr: `${nameBoth}${locForm ? ' ' + locForm : ''}${p.strength ? ' ' + p.strength : ''}: Talep üzerine Haniya Parsan Darou Co. (Hanpars) aracılığıyla İran pazarına ithal edilebilir, acil ithalat dahil; temin ve ruhsat durumu her talepte teyit edilir.`,
} as Record<string, string>)[lang];

---
<section class="hero page-hero"><div class="container">
  <div class="hero-main prod-hero">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={L('/')}>{s.breadcrumbHome}</a><span aria-hidden="true">/</span><a href={L('/fdf#fdf-reference')}>{m.list}</a><span aria-hidden="true">/</span><span lang="en" dir="ltr">{title}</span></nav>
    <p class="ph-badges"><span class="ph-badge">{m.kicker}</span>{inPortfolio && <span class="ph-badge ph-badge-ok"><Icon name="check" size={14}/>{m.registered}</span>}</p>
    <h1>{locTitle ? <><span lang={htmlLang[lang]} dir={dir(lang)}>{locTitle}</span><span class="h1-en" lang="en" dir="ltr">{title}</span></> : <span lang="en" dir="ltr">{title}</span>}</h1>
    <ul class="ph-chips" {...locLang}><li>{formShown}</li>{routeShown && <li>{routeShown}</li>}{p.strength && <li class="ph-chip-strong"><bdi lang="en" dir="ltr">{p.strength}</bdi></li>}{p.pack && <li><bdi lang="en" dir="ltr">{p.pack}</bdi></li>}</ul>
    <dl class="mol-keyfacts">
      <div><dt>{m.code}</dt><dd lang="en" dir="ltr">{entry.code}</dd></div>
      {p.salt && <div><dt>{m.salt}</dt><dd lang="en" dir="ltr">{prettyName(p.salt)}</dd></div>}
      {fa.pharmClass ? <div lang={htmlLang[lang]} dir={dir(lang)}><dt>{m.class}</dt><dd>{fa.pharmClass}</dd></div> : (main?.pharmClass && main.pharmClass.length > 0 && <div><dt>{m.class}</dt><dd lang="en" dir="ltr">{main.pharmClass.map((c: string) => c.replace(/\s*\[EPC\]/, '')).join(' · ')}</dd></div>)}
    </dl>
    <div class="hero-actions"><a class="button button-light" href={enquiry}>{m.enquire}</a><a class="text-link" href={L('/fdf#fdf-reference')}>{m.back}</a></div>
    <p class="prod-seo-note" lang={htmlLang[lang]} dir={dir(lang)}>{seoNote}</p>
    {lang === 'fa' && <p class="prod-patient-note" role="note"><Icon name="shield" size={16}/><span>این صفحه مرجع اطلاعات دارویی برای متخصصان و شرکای تجاری است و فروش به بیمار ندارد؛ برای تهیه و مصرف دارو به داروخانه و پزشک خود مراجعه کنید.</span></p>}
  </div>
</div></section>

<section class="section"><div class="container mol-body">
  <div class="mol-main prod-main">
    {main ? <>
      {sec.boxed.text && <div class="prod-boxed" {...L1(sec.boxed)}><strong>{m.boxed}</strong><p>{sec.boxed.text}</p></div>}
      {(sec.moa.text || (main.moaClass?.length ?? 0) > 0) && <section class="pd-sec pd-moa"><h2><span class="pd-ico"><Icon name="molecule" size={18}/></span>{m.what}</h2>{sec.moa.text && <p {...L1(sec.moa)}>{sec.moa.text}</p>}{main.moaClass && main.moaClass.length > 0 && <p class="form-hint" lang="en" dir="ltr">{m.moaClass}: {main.moaClass.map((c: string) => c.replace(/\s*\[MoA\]/, '')).join(' · ')}</p>}</section>}
      {sec.indications.text && <section class="pd-sec pd-indications"><h2><span class="pd-ico"><Icon name="check" size={18}/></span>{m.indications}</h2><p {...L1(sec.indications)}>{sec.indications.text}</p></section>}
      {sec.dosage.text && <section class="pd-sec pd-dosage"><h2><span class="pd-ico"><Icon name="capsule" size={18}/></span>{m.dosage}</h2><p {...L1(sec.dosage)}>{sec.dosage.text}</p></section>}
      {sec.contraindications.text && <section class="pd-sec pd-contraindications"><h2><span class="pd-ico"><Icon name="close" size={18}/></span>{m.contra}</h2><p {...L1(sec.contraindications)}>{sec.contraindications.text}</p></section>}
      {sec.warnings.text && <section class="pd-sec pd-warnings"><h2><span class="pd-ico"><Icon name="shield" size={18}/></span>{m.warnings}</h2><p {...L1(sec.warnings)}>{sec.warnings.text}</p></section>}
      {sec.pregnancy.text && <section class="pd-sec pd-pregnancy"><h2><span class="pd-ico"><Icon name="leaf" size={18}/></span>{m.pregnancy}</h2><p {...L1(sec.pregnancy)}>{sec.pregnancy.text}</p></section>}
      {sec.storage.text && <section class="pd-sec pd-storage"><h2><span class="pd-ico"><Icon name="box" size={18}/></span>{m.storage}</h2><p {...L1(sec.storage)}>{sec.storage.text}</p></section>}
      {isEditorial ? <p class="form-hint prod-source">{m.editorialSource}</p> :
      <p class="form-hint prod-source" lang={htmlLang[lang]} dir={dir(lang)}>{srcLine}{dailymed && <>{' '}<a class="text-link" href={dailymed} target="_blank" rel="noopener noreferrer" lang="en" dir="ltr">DailyMed</a></>}{lang === 'en' ? '. ' : ' '}{m.sourceNote}</p>}
    </> : <p class="archive-note">{m.noInfo}</p>}
  </div>
  <aside class="mol-aside">
    <h3>{m.thisEntry}</h3>
    <dl class="mol-props">
      <div><dt>{m.form}</dt><dd {...locLang}>{formShown}</dd></div>
      {routeShown && <div><dt>{m.route}</dt><dd {...locLang}>{routeShown}</dd></div>}
      {p.strength && <div><dt>{m.strength}</dt><dd dir="ltr" lang="en">{p.strength}</dd></div>}
      {p.pack && <div><dt>{m.pack}</dt><dd dir="ltr" lang="en">{p.pack}</dd></div>}
      <div><dt>{m.code}</dt><dd dir="ltr" lang="en">{entry.code}</dd></div>
    </dl>
    {molLinks.length > 0 && <><h3>{m.activeIngredient}</h3><ul class="link-list prod-links" lang="en" dir="ltr">{molLinks.map(l => <li><a href={l.href}>{l.name}<small>{l.cas}</small></a></li>)}</ul></>}
    <h3>{m.sourcing}</h3>
    <ul class="check-list mol-checks">{m.sourcingPoints.map(x => <li>{x}</li>)}</ul>
    <a class="button button-navy" href={enquiry}>{m.enquire}</a>
  </aside>
</div></section>

{sameIngredient.length > 0 && <section class="section section-paper section-tight"><div class="container">
  <div class="section-head"><h2>{m.otherForms}</h2></div>
  <ul class="same-grid" {...locLang}>{sameIngredient.map(e => { const q = parseFdf(e.name); return <li><a class="same-card" href={L(`/fdf/${fdfSlug(e)}`)}>
    <span class="same-ico"><DosageFormIcon name={formIcon(q.form, q.route)} label={fL(q.form, q.route)} size={24}/></span>
    <span class="same-body"><strong>{fL(q.form, q.route)}</strong><span class="same-tags">{q.route && <span>{rL(q.route)}</span>}{q.strength && <span><bdi lang="en" dir="ltr">{unit(q.strength)}</bdi></span>}{q.pack && <span><bdi lang="en" dir="ltr">{unit(q.pack)}</bdi></span>}</span></span>
    <span class="same-code" dir="ltr">{e.code}</span><Icon name="arrow" size={16} class="same-arrow"/>
  </a></li>; })}</ul>
</div></section>}

<section class="section-tight"><div class="container">{Array.isArray(m.note) ? <ul class="reference-note reference-note-list">{(m.note as string[]).map((x: string) => <li>{x}</li>)}</ul> : <p class="reference-note">{m.note}</p>}</div></section>
<CTA title={m.ctaTitle} />
