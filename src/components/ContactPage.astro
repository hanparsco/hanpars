---
import PageHero from './PageHero.astro';
import { liveContact } from '../data/site';
---
<PageHero title="Tell us what you are looking for." category="Contact" description="A product to source, a dossier to file, a project to set up. Write the brief here, then send it through the contact form on hanpars.com, or simply call the office in Tehran." action="Open the contact form" href={liveContact}/>
<section class="section"><div class="container contact-layout">
  <div class="brief-panel" id="enquiry"><h2>Write the brief</h2><p>Choose the kind of request, fill in what you know, and we will turn it into a short brief you can copy into the contact form or an email. Nothing is sent from this page.</p>
    <div class="enquiry-tabs" role="tablist" aria-label="Enquiry type"><button id="enquiry-sourcing" type="button" class="enquiry-tab" role="tab" aria-selected="true" aria-controls="brief-form" data-enquiry-type="sourcing">Product sourcing</button><button id="enquiry-regulatory" type="button" class="enquiry-tab" role="tab" aria-selected="false" aria-controls="brief-form" data-enquiry-type="regulatory" tabindex="-1">Regulatory affairs</button><button id="enquiry-cdmo" type="button" class="enquiry-tab" role="tab" aria-selected="false" aria-controls="brief-form" data-enquiry-type="cdmo" tabindex="-1">FDF CDMO project</button></div>
    <form id="brief-form" aria-labelledby="enquiry-sourcing" role="tabpanel">
      <div class="form-grid">
        <div class="form-field full"><label for="brief-product" data-product-label>Product or ingredient name <span aria-hidden="true">*</span></label><input id="brief-product" name="product" placeholder="For example the INN, API or ingredient" required maxlength="500"/></div>
        <div class="form-field"><label for="brief-spec" data-spec-label>Specification, grade or strength</label><input id="brief-spec" name="specification" placeholder="If known" maxlength="500"/></div>
        <div class="form-field"><label for="brief-quantity" data-quantity-label>Quantity or project scale</label><input id="brief-quantity" name="quantity" placeholder="With units, if known" maxlength="300"/></div>
        <div class="form-field"><label for="brief-market">Target market or destination</label><input id="brief-market" name="market" placeholder="Where the product is going" maxlength="300"/></div>
        <div class="form-field"><label for="brief-timing">Timing</label><input id="brief-timing" name="timing" placeholder="When you need it" maxlength="300"/></div>
        <div class="form-field full"><label for="brief-message" data-message-label>Documentation needs and other details</label><textarea id="brief-message" name="message" placeholder="Specifications, documents, dossier status, or the support you need." maxlength="5000" rows="4"></textarea></div>
      </div>
      <div class="form-actions"><button class="button button-navy" type="submit" data-prepare-brief disabled>Prepare the brief</button><a class="text-link" href={liveContact} target="_blank" rel="noopener noreferrer">Skip this and open the contact form</a></div>
      <noscript><p class="form-hint">Preparing a brief needs JavaScript. You can use the contact form on hanpars.com directly.</p></noscript>
      <p class="form-disclaimer">The brief is prepared in your browser and is not stored or submitted by this page. Please leave out confidential personal or medical information. Preparing a brief does not confirm a quotation, availability or timeline.</p>
    </form>
    <div class="brief-result" id="brief-result" aria-live="polite" hidden><h3>Your brief is ready</h3><p style="color:var(--muted)">Copy it into the message field of the contact form, or into an email to <a href="mailto:contact@hanpars.com">contact@hanpars.com</a>. Nothing has been sent yet.</p><pre id="brief-text"></pre><div class="brief-actions"><button class="button button-outline button-small" type="button" id="copy-brief">Copy the brief</button><button class="button button-outline button-small" type="button" id="download-brief">Download as text</button><a class="button button-navy button-small" href={liveContact} target="_blank" rel="noopener noreferrer">Open the contact form</a></div><p class="result-status" id="brief-status" role="status"></p></div>
  </div>
  <aside class="contact-aside"><h3>Or reach us directly</h3><p>The office is in Tehran. Enquiries sent through the hanpars.com contact form arrive in the same inbox.</p>
    <div class="contact-detail"><strong>Telephone</strong><p><a href="tel:+982188883325">+98 21 8888 3325</a></p></div>
    <div class="contact-detail"><strong>Email</strong><p><a href="mailto:contact@hanpars.com">contact@hanpars.com</a></p></div>
    <div class="contact-detail"><strong>Office</strong><p>Haniya Parsan Darou<br/>3rd floor, No. 326, Zafar Street<br/>Africa Boulevard, Tehran 1968734974<br/>Iran</p></div>
    <div class="contact-detail"><strong>Hours</strong><p>09:00–17:00, Tehran time</p><span class="form-hint">Please confirm before visiting.</span></div>
  </aside>
</div></section>
