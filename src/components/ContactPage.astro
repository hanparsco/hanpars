---
import PageHero from './PageHero.astro';
import { formEndpoint, formAccessKey, contactEmail, raEmail, mEnc, mShow } from '../data/site';
import { langFromPath, t } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const c = t(lang).contact;
const types = ['sourcing', 'regulatory', 'cdmo'] as const;
const officeLines = {
  fa: ['هانیا پرسان دارو', 'تهران، بلوار آفریقا، خیابان ظفر', 'پلاک ۳۲۶، طبقهٔ سوم', 'کد پستی ۱۹۶۸۷۳۴۹۷۴'],
  zh: ['Haniya Parsan Darou', '伊朗德黑兰非洲大道', '扎法尔街 326 号 3 层', '邮编 1968734974'],
  tr: ['Haniya Parsan Darou', 'Zafar Caddesi No: 326, Kat: 3', 'Afrika Bulvarı, Tahran 1968734974', 'İran'],
  en: ['Haniya Parsan Darou', '3rd floor, No. 326, Zafar Street', 'Africa Boulevard, Tehran 1968734974', 'Iran'],
}[lang];
const sv = (d: string) => `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const icons: Record<string, string> = {
  sourcing: sv('<path d="M9 3h6M10 3v5.5L5.2 17.4A2.4 2.4 0 0 0 7.3 21h9.4a2.4 2.4 0 0 0 2.1-3.6L14 8.5V3"/><path d="M7.5 14h9"/>'),
  regulatory: sv('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13l2 2 4-4"/>'),
  cdmo: sv('<path d="M3 21V10l5 3V10l5 3V6l8 4v11z"/><path d="M7 17h2M12 17h2M17 17h1"/>'),
  phone: sv('<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>'),
  mail: sv('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>'),
  pin: sv('<path d="M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>'),
  clock: sv('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'),
};
const i18n = JSON.stringify({ labels: c.labels, notConnected: c.notConnected, sent: c.sent, failed: c.failed, sending: c.sending, send: c.send });
---
<PageHero title={c.title} category={c.category} description={c.lede} action={c.action} href="#enquiry"/>
<section class="section section-paper contact-section"><div class:list={['container', 'contact-layout', { 'contact-layout-solo': lang === 'fa' }]}>
  <div class="brief-panel" id="enquiry">
    <div class="brief-head"><h2>{c.formTitle}</h2><p>{c.formLede}</p></div>
    <p class="brief-legend" id="enquiry-type-legend">{c.typeLegend}</p>
    <div class="enquiry-tabs" role="tablist" aria-labelledby="enquiry-type-legend">{types.map((k, i) => <button id={`enquiry-${k}`} type="button" class="enquiry-tab" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-controls="brief-form" data-enquiry-type={k} tabindex={i === 0 ? 0 : -1}><span class="enquiry-icon" aria-hidden="true" set:html={icons[k]}/><span class="enquiry-text"><strong>{c.tabs[k]}</strong><small>{c.tabHints[k]}</small></span></button>)}</div>
    <form id="brief-form" aria-labelledby="enquiry-sourcing" role="tabpanel" action={formEndpoint} method="POST" data-access-key={formAccessKey} data-i18n={i18n} data-email={mEnc(contactEmail)} data-ra-email={mEnc(raEmail)} data-t0="0" novalidate>
      <input type="hidden" name="access_key" value={formAccessKey} />
      <input type="hidden" name="subject" value="Website enquiry" data-subject />
      <input type="hidden" name="from_name" value="hanpars.com website" />
      <input type="hidden" name="enquiry_type" value="sourcing" data-type-field />
      <input type="hidden" name="language" value={lang} />
      <input type="hidden" name="ccemail" value="" data-cc-field />
      <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <fieldset class="form-step"><legend><span class="step-num" data-fa-digits>1</span>{c.step1}</legend>
        <div class="form-grid">
          <div class="form-field full"><label for="brief-product"><span data-product-label>{c.product}</span> <span class="req" aria-hidden="true">*</span></label><input id="brief-product" name="product" placeholder={c.productPh} required maxlength="500"/></div>
          <div class="form-field"><label for="brief-spec"><span data-spec-label>{c.spec}</span><small class="opt">{c.optional}</small></label><input id="brief-spec" name="specification" placeholder={c.specPh} maxlength="500"/></div>
          <div class="form-field"><label for="brief-quantity"><span data-quantity-label>{c.quantity}</span><small class="opt">{c.optional}</small></label><input id="brief-quantity" name="quantity" placeholder={c.quantityPh} maxlength="300"/></div>
          <div class="form-field"><label for="brief-market">{c.market}<small class="opt">{c.optional}</small></label><input id="brief-market" name="market" placeholder={c.marketPh} maxlength="300"/></div>
          <div class="form-field"><label for="brief-timing">{c.timing}<small class="opt">{c.optional}</small></label><input id="brief-timing" name="timing" placeholder={c.timingPh} maxlength="300"/><div class="chips" role="group" aria-label={c.timing}>{c.timingChips.map(v => <button type="button" class="chip" data-chip-for="brief-timing" data-chip-value={v} aria-pressed="false">{v}</button>)}</div></div>
          <div class="form-field full"><label for="brief-message"><span data-message-label>{c.message}</span><small class="opt">{c.optional}</small></label><textarea id="brief-message" name="message" placeholder={c.messagePh} maxlength="5000" rows="4"></textarea></div>
        </div>
      </fieldset>
      <fieldset class="form-step"><legend><span class="step-num" data-fa-digits>2</span>{c.step2}</legend>
        <div class="form-grid">
          <div class="form-field"><label for="brief-name">{c.name} <span class="req" aria-hidden="true">*</span></label><input id="brief-name" name="name" required maxlength="200" autocomplete="name"/></div>
          <div class="form-field"><label for="brief-company">{c.company}<small class="opt">{c.optional}</small></label><input id="brief-company" name="company" maxlength="200" autocomplete="organization"/></div>
          <div class="form-field"><label for="brief-email">{c.email} <span class="req" aria-hidden="true">*</span></label><input id="brief-email" name="email" type="email" required maxlength="200" autocomplete="email" dir="ltr"/></div>
          <div class="form-field"><label for="brief-phone">{c.phone}<small class="opt">{c.optional}</small></label><input id="brief-phone" name="phone" type="tel" maxlength="60" autocomplete="tel" dir="ltr"/></div>
        </div>
      </fieldset>
      <div class="form-actions"><button class="button button-navy brief-submit" type="submit" data-send-brief>{c.send}</button><a class="text-link" href="#brief-form" data-or-email data-m={mEnc(contactEmail)} rel="nofollow">{c.orEmail} <span dir="ltr" data-m-text>{mShow(contactEmail)}</span></a></div>
      <p class="form-status" id="brief-status" role="status" aria-live="polite"></p>
      <p class="form-disclaimer">{c.disclaimer}</p>
    </form>
  </div>
  {lang !== 'fa' && <aside class="contact-aside">{lang !== 'fa' && <><h3>{c.asideTitle}</h3><p>{c.asideText}</p></>}
    {lang !== 'fa' && <div class="contact-detail"><span class="cd-icon" aria-hidden="true" set:html={icons.phone}/><div><strong>{c.phone}</strong><p><a href="tel:+982188883325" dir="ltr" data-fa-digits>+98 21 8888 3325</a></p></div></div>}
    <div class="contact-detail"><span class="cd-icon" aria-hidden="true" set:html={icons.mail}/><div><strong>{c.email}</strong><p><a href="#brief-form" data-m={mEnc(contactEmail)} rel="nofollow" dir="ltr" data-m-text>{mShow(contactEmail)}</a><br/><a href="#brief-form" data-m={mEnc(raEmail)} rel="nofollow" dir="ltr" data-m-text>{mShow(raEmail)}</a></p></div></div>
    {lang !== 'fa' && <div class="contact-detail"><span class="cd-icon" aria-hidden="true" set:html={icons.pin}/><div><strong>{c.office}</strong><p>{officeLines.map((l, n) => <>{n > 0 && <br/>}{l}</>)}</p></div></div>}
    {lang !== 'fa' && <div class="contact-detail"><span class="cd-icon" aria-hidden="true" set:html={icons.clock}/><div><strong>{c.hours}</strong><p>{c.hoursText}</p><span class="form-hint">{c.confirmVisit}</span></div></div>}
  </aside>}
</div></section>
