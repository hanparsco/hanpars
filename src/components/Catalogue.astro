---
import Icon from './Icon.astro';
interface Props { entries: {name:string;code?:string}[]; type:'fdf'|'api'; }
const { entries, type } = Astro.props;
const total = entries.length.toLocaleString('en-US');
---
<div class="catalogue-panel" data-catalogue data-page-size="25">
  <div class="catalogue-toolbar"><div><h2>{type==='fdf'?'Finished product reference list':'API reference range'}</h2><p class="catalogue-count"><span data-filter-count>{total}</span> entries <span data-count-suffix>in the list</span></p></div><label class="search-input"><Icon name="search" size={18}/><input type="search" placeholder={type==='fdf'?'Search by name, strength or code':'Search for a substance'} aria-label={type==='fdf'?'Search finished products by name, strength or code':'Search API reference substances'} data-catalogue-search autocomplete="off"/></label></div>
  <div class="catalogue-scroll" tabindex="0" role="region" aria-label={type==='fdf'?'Finished dosage forms catalogue':'API catalogue'}>
    <table class="catalogue-table"><thead><tr><th scope="col">{type==='fdf'?'Product':'Substance'}</th>{type==='fdf'&&<th scope="col">Code</th>}<th scope="col">Enquiry</th></tr></thead><tbody>{entries.map((entry,index)=><tr data-catalogue-row data-search={`${entry.name} ${entry.code||''}`.toLowerCase()} data-index={index}><td>{entry.name}</td>{type==='fdf'&&<td class="table-code">{entry.code}</td>}<td><a class="table-request" href={`/contact-us-1?type=sourcing&product=${encodeURIComponent(entry.name)}`} aria-label={`Prepare an enquiry about ${entry.name}`}>Enquire</a></td></tr>)}</tbody></table>
    <div class="catalogue-empty" data-catalogue-empty hidden>Nothing in the list matches that. Try another name or code, or <a class="text-link" href="/contact-us-1?type=sourcing">ask us directly</a>.</div>
  </div>
  <div class="catalogue-foot"><span aria-live="polite" data-catalogue-status>All {total} original entries available</span><div class="catalogue-pager" data-catalogue-pager hidden><button type="button" data-catalogue-prev>Previous</button><span data-page-label></span><button type="button" data-catalogue-next>Next</button></div></div>
</div>
<p class="reference-note">A reference list for enquiries, not a statement of stock, registration or guaranteed availability. Names and codes are kept exactly as in the original working list; specifications, documentation and commercial terms are discussed per request.</p>
