---
import Icon from './Icon.astro';
interface Props { entries: {name:string;code?:string}[]; type:'fdf'|'api'; }
const { entries, type } = Astro.props;
---
<div class="catalogue-panel" data-catalogue data-page-size="25">
  <div class="catalogue-toolbar"><div><h2>{type==='fdf'?'Finished product reference range':'API reference range'}</h2><p class="catalogue-count"><span data-filter-count>{entries.length.toLocaleString('en-US')}</span> entries <span data-count-suffix>in the reference list</span></p></div><label class="search-input"><Icon name="search" size={19}/><input type="search" placeholder={type==='fdf'?'Search by INN, strength or code…':'Search for an API…'} aria-label={type==='fdf'?'Search FDF reference by INN, strength or code':'Search API reference substances'} data-catalogue-search autocomplete="off"/></label></div>
  <div class="catalogue-scroll" tabindex="0" role="region" aria-label={type==='fdf'?'Finished dosage forms catalogue':'API catalogue'}>
    <table class="catalogue-table"><thead><tr><th scope="col">{type==='fdf'?'PRODUCT / INN':'SUBSTANCE'}</th>{type==='fdf'&&<th scope="col">INN CODE</th>}<th scope="col"><span>ENQUIRY</span></th></tr></thead><tbody>{entries.map((entry,index)=><tr data-catalogue-row data-search={`${entry.name} ${entry.code||''}`.toLowerCase()} data-index={index}><td>{entry.name}</td>{type==='fdf'&&<td class="table-code">{entry.code}</td>}<td><a class="table-request" href={`/contact-us-1?type=sourcing&product=${encodeURIComponent(entry.name)}`} aria-label={`Prepare an enquiry about ${entry.name}`}>Enquire <Icon name="diagonal" size={14}/></a></td></tr>)}</tbody></table>
    <div class="catalogue-empty" data-catalogue-empty hidden>No matching entries. Try another name or reference code, or <a class="text-link" href="/contact-us-1?type=sourcing">send an enquiry</a>.</div>
  </div>
  <div class="catalogue-foot"><span aria-live="polite" data-catalogue-status>All {entries.length.toLocaleString('en-US')} original entries available</span><div class="catalogue-pager" data-catalogue-pager hidden><button type="button" data-catalogue-prev>Previous</button><span data-page-label></span><button type="button" data-catalogue-next>Next</button></div></div>
</div>
<p class="reference-note">This is a reference list for enquiries, not a statement of stock, registration or guaranteed availability. Product specifications, documentation and commercial details need to be addressed for your request. Original names and codes are retained.</p>
