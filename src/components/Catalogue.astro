---
import Icon from './Icon.astro';
import { langFromPath, localePath, t } from '../i18n';
interface Props { entries: {name:string;code?:string}[]; type:'fdf'|'api'; }
const { entries, type } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const s = t(lang).catalogue;
const L = (p: string) => localePath(p, lang);
const total = entries.length.toLocaleString('en-US');
const i18n = JSON.stringify({ inList: s.inList, matching: s.matching, none: s.none, showing: s.showingTpl });
---
<div class="catalogue-panel" data-catalogue data-page-size="25" data-i18n={i18n}>
  <div class="catalogue-toolbar"><div><h2>{type==='fdf'?s.fdfTitle:s.apiTitle}</h2><p class="catalogue-count"><span data-filter-count>{total}</span> {s.entries} <span data-count-suffix>{s.inList}</span></p></div><label class="search-input"><Icon name="search" size={18}/><input type="search" placeholder={type==='fdf'?s.searchFdf:s.searchApi} aria-label={type==='fdf'?s.searchFdf:s.searchApi} data-catalogue-search autocomplete="off"/></label></div>
  <div class="catalogue-scroll" tabindex="0" role="region" aria-label={type==='fdf'?s.fdfTitle:s.apiTitle}>
    <table class="catalogue-table"><thead><tr><th scope="col">{type==='fdf'?s.product:s.substance}</th>{type==='fdf'&&<th scope="col">{s.code}</th>}<th scope="col">{s.enquiry}</th></tr></thead><tbody>{entries.map((entry,index)=><tr data-catalogue-row data-search={`${entry.name} ${entry.code||''}`.toLowerCase()} data-index={index}><td dir="ltr">{entry.name}</td>{type==='fdf'&&<td class="table-code" dir="ltr">{entry.code}</td>}<td><a class="table-request" href={L(`/contact-us-1?type=sourcing&product=${encodeURIComponent(entry.name)}`)} aria-label={`${s.enquire}: ${entry.name}`}>{s.enquire}</a></td></tr>)}</tbody></table>
    <div class="catalogue-empty" data-catalogue-empty hidden>{s.empty} <a class="text-link" href={L('/contact-us-1?type=sourcing')}>{s.askDirect}</a>.</div>
  </div>
  <div class="catalogue-foot"><span aria-live="polite" data-catalogue-status>{s.allAvailable(total)}</span><div class="catalogue-pager" data-catalogue-pager hidden><button type="button" data-catalogue-prev>{s.prev}</button><span data-page-label></span><button type="button" data-catalogue-next>{s.next}</button></div></div>
</div>
<p class="reference-note">{s.note}</p>
