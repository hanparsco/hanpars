---
import Icon from './Icon.astro';
import { langFromPath, localePath, t } from '../i18n';
interface Props { entries: {name:string;code?:string;extra?:string;group?:string}[]; type:'fdf'|'api'|'exc'; filters?: [string,string][]; }
const { entries, type, filters = [] } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const s = t(lang).catalogue;
const L = (p: string) => localePath(p, lang);
const total = entries.length.toLocaleString('en-US');
const title = type==='fdf'?s.fdfTitle:type==='exc'?s.excTitle:s.apiTitle;
const search = type==='fdf'?s.searchFdf:type==='exc'?s.searchExc:s.searchApi;
const hasCode = true;
const i18n = JSON.stringify({ inList: s.inList, matching: s.matching, none: s.none, showing: s.showingTpl });
---
<div class="catalogue-panel" id={type==='exc'?'excipient-list':undefined} style={type==='exc'?'scroll-margin-top:40px':undefined} data-catalogue data-page-size="25" data-i18n={i18n}>
  <div class="catalogue-toolbar"><div><h2>{title}</h2><p class="catalogue-count"><span data-filter-count>{total}</span> {s.entries} <span data-count-suffix>{s.inList}</span></p></div><label class="search-input"><Icon name="search" size={18}/><input type="search" placeholder={search} aria-label={search} data-catalogue-search autocomplete="off"/></label></div>
  {filters.length>0&&<div class="claims-filters" role="group">{filters.map(([id,label])=><button type="button" data-catalogue-filter={id} aria-pressed={id===''?'true':'false'}>{label}</button>)}</div>}
  <div class="catalogue-scroll" tabindex="0" role="region" aria-label={title}>
    <table class="catalogue-table"><thead><tr><th scope="col">{type==='fdf'?s.product:type==='exc'?s.ingredient:s.substance}</th>{type==='exc'&&<th scope="col">{s.function}</th>}{hasCode&&<th scope="col">{type==='fdf'?s.code:s.cas}</th>}<th scope="col">{s.enquiry}</th></tr></thead><tbody>{entries.map((entry,index)=><tr data-catalogue-row data-status={entry.group} data-search={`${entry.name} ${entry.code||''} ${entry.extra||''}`.toLowerCase()} data-index={index}><td dir="ltr" class={type==='exc'?'table-name':undefined}>{entry.name}</td>{type==='exc'&&<td class="table-function">{entry.extra||''}</td>}{hasCode&&<td class="table-code" dir="ltr">{entry.code||'—'}</td>}<td><a class="table-request" href={L(`/contact-us-1?type=sourcing&product=${encodeURIComponent(entry.name)}`)} aria-label={`${s.enquire}: ${entry.name}`}>{s.enquire}</a></td></tr>)}</tbody></table>
    <div class="catalogue-empty" data-catalogue-empty hidden>{s.empty} <a class="text-link" href={L('/contact-us-1?type=sourcing')}>{s.askDirect}</a>.</div>
  </div>
  <div class="catalogue-foot"><span aria-live="polite" data-catalogue-status>{s.allAvailable(total)}</span><div class="catalogue-pager" data-catalogue-pager hidden><button type="button" data-catalogue-prev>{s.prev}</button><span data-page-label></span><button type="button" data-catalogue-next>{s.next}</button></div></div>
</div>
<p class="reference-note">{type==='exc'?s.noteExc:s.note}</p>
