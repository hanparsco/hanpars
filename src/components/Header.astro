---
import Brand from './Brand.astro';
interface Props { brand?: 'default' | 'regulatory' }
const { brand = 'default' } = Astro.props;
import Icon from './Icon.astro';
import Flag from './Flag.astro';
import { langFromPath, stripLang, localePath, t, langs, langNames, htmlLang, dir } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const path = stripLang(Astro.url.pathname);
const s = t(lang);
const L = (p: string) => localePath(p, lang);
const switchPath = /^\/(home|404)(\.html)?\/?$/.test(path) ? '/' : path;  // pages that exist only in English
const others = langs.map(l => ({ l, href: localePath(switchPath, l) }));
const sv = (d: string) => `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const icons: Record<string, string> = {
  '/fdf': sv('<rect x="3" y="8" width="18" height="8" rx="4"/><path d="M12 8v8"/>'),
  '/api': sv('<path d="M9 3h6M10 3v5.5L5.2 17.4A2.4 2.4 0 0 0 7.3 21h9.4a2.4 2.4 0 0 0 2.1-3.6L14 8.5V3"/><path d="M7.5 14h9"/>'),
  '/excipient': sv('<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>'),
  '/nutrition': sv('<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19 13 11"/>'),
  '/regulatory-affairs': sv('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13l2 2 4-4"/>'),
  '/fdf-cdmo': sv('<path d="M3 21V10l5 3V10l5 3V6l8 4v11z"/><path d="M7 17h2M12 17h2M17 17h1"/>'),
  '/about-us': sv('<path d="M4 21V7l8-4 8 4v14"/><path d="M9 21v-6h6v6M9 10h.01M15 10h.01"/>'),
  '/import-activity': sv('<path d="M4 20h16"/><path d="M7 16v-4M12 16V8M17 16v-6"/><path d="m6 9 5-4 3 3 4-4"/>'),
  '/culture': sv('<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>'),
  '/markets': sv('<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>'),
  '/news': sv('<path d="M4 5h13v14H6a2 2 0 0 1-2-2z"/><path d="M17 9h3v8a2 2 0 0 1-2 2M8 9h5M8 13h5"/>'),
  '/blog-1': sv('<path d="M4 4h6a2 2 0 0 1 2 2v14a2 2 0 0 0-2-2H4zM20 4h-6a2 2 0 0 0-2 2v14a2 2 0 0 1 2-2h6z"/>'),
};
const arrow = dir(lang) === 'rtl' ? '←' : '→';
---
<header class:list={['site-header', { 'hanpars-zh-hans': lang === 'zh' }]}>
  <div class="container header-inner">
    <Brand variant={brand} />
    <button class="menu-toggle" type="button" aria-label={s.openNav} aria-expanded="false" aria-controls="main-nav" data-label-open={s.openNav} data-label-close={s.closeNav}><Icon name="menu" class="mt-open"/><Icon name="close" class="mt-close"/></button>
    <nav id="main-nav" class="main-nav" aria-label="Main navigation">
      <a class:list={['nav-link', { active: path === '/' || path === '/home' }]} href={L('/')}>{s.nav.home}</a>
      {s.groups.map((group, gi) => <details class="nav-dropdown">
        <summary class:list={['nav-link', { active: group.items.some((item) => item.href === path) || (group.items.some((item) => item.href === '/blog-1') && path.startsWith('/insights/')) }]}>{group.label}<Icon name="down" size={13}/></summary>
        <div class:list={['dropdown-panel', { 'dropdown-wide': group.items.length > 3 }]}>
          <p class="dropdown-label">{group.label}</p>
          <div class="dropdown-grid">{group.items.map((item) => <a href={L(item.href)} class:list={{ current: item.href === path }}><span class="dd-icon" set:html={icons[item.href] || ''}/><span class="dd-text"><strong>{item.label}</strong><small>{item.note}</small></span><span class="dd-arrow" aria-hidden="true">{arrow}</span></a>)}</div>
          {gi === 0 && <a class="dropdown-foot" href={L('/contact-us-1?type=sourcing')}>{s.nav.enquiry}<span aria-hidden="true">{arrow}</span></a>}
        </div>
      </details>)}
      <a class:list={['nav-link', { active: path === '/contact-us-1' }]} href={L('/contact-us-1')}>{s.nav.contact}</a>
      <details class="nav-dropdown nav-lang-menu">
        <summary class="nav-link nav-lang" aria-label="Language"><Flag lang={lang} size={18}/><span>{langNames[lang]}</span><Icon name="down" size={13}/></summary>
        <div class="dropdown-panel lang-panel">{others.map(o => <a href={o.href} hreflang={htmlLang[o.l]} lang={htmlLang[o.l]} dir={dir(o.l)} aria-current={o.l === lang ? 'true' : undefined} class:list={{ current: o.l === lang }}><Flag lang={o.l} size={22}/><strong>{langNames[o.l]}</strong></a>)}</div>
      </details>
      <div class="mobile-langs" role="group" aria-label="Language">{others.map(o => <a href={o.href} hreflang={htmlLang[o.l]} lang={htmlLang[o.l]} aria-current={o.l === lang ? 'true' : undefined} class:list={{ current: o.l === lang }}><Flag lang={o.l} size={20}/><span>{langNames[o.l]}</span></a>)}</div>
      <a class="button button-ghost nav-cta" href={L('/contact-us-1')}>{s.nav.enquiry}</a>
    </nav>
  </div>
</header>
