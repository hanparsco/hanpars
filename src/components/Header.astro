---
import Brand from './Brand.astro';
interface Props { brand?: 'default' | 'regulatory' }
const { brand = 'default' } = Astro.props;
import Icon from './Icon.astro';
import { langFromPath, stripLang, localePath, t, langs, langNames, htmlLang, dir } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const path = stripLang(Astro.url.pathname);
const s = t(lang);
const L = (p: string) => localePath(p, lang);
const others = langs.map(l => ({ l, href: localePath(path, l) }));
---
<header class="site-header">
  <div class="container header-inner">
    <Brand variant={brand} />
    <button class="menu-toggle" type="button" aria-label={s.openNav} aria-expanded="false" aria-controls="main-nav" data-label-open={s.openNav} data-label-close={s.closeNav}><Icon name="menu"/></button>
    <nav id="main-nav" class="main-nav" aria-label="Main navigation">
      <a class:list={['nav-link', { active: path === '/' || path === '/home' }]} href={L('/')}>{s.nav.home}</a>
      {s.groups.map((group) => <details class="nav-dropdown">
        <summary class:list={['nav-link', { active: group.items.some((item) => item.href === path) || (group.items.some((item) => item.href === '/blog-1') && path.startsWith('/insights/')) }]}>{group.label}<Icon name="down" size={13}/></summary>
        <div class="dropdown-panel">{group.items.map((item) => <a href={L(item.href)}><strong>{item.label}</strong><small>{item.note}</small></a>)}</div>
      </details>)}
      <a class:list={['nav-link', { active: path === '/contact-us-1' }]} href={L('/contact-us-1')}>{s.nav.contact}</a>
      <details class="nav-dropdown nav-lang-menu">
        <summary class="nav-link nav-lang" aria-label="Language"><Icon name="globe" size={15}/><span>{langNames[lang]}</span><Icon name="down" size={13}/></summary>
        <div class="dropdown-panel lang-panel">{others.map(o => <a href={o.href} hreflang={htmlLang[o.l]} lang={htmlLang[o.l]} dir={dir(o.l)} aria-current={o.l === lang ? 'true' : undefined} class:list={{ current: o.l === lang }}><strong>{langNames[o.l]}</strong></a>)}</div>
      </details>
      <a class="button button-ghost nav-cta" href={L('/contact-us-1')}>{s.nav.enquiry}</a>
    </nav>
  </div>
</header>
