---
import Icon from './Icon.astro';
import WeChatIcon from './WeChatIcon.astro';
interface Props { brand?: 'default' | 'regulatory' }
const { brand = 'default' } = Astro.props;
import { langFromPath, localePath, stripLang, t, dir } from '../i18n';
import { contactEmail, raEmail, mEnc, mShow, wechatId } from '../data/site';
const email = brand === 'regulatory' ? raEmail : contactEmail;
const lang = langFromPath(Astro.url.pathname);
const s = t(lang);
const L = (p: string) => localePath(p, lang);
const wxLabel = ({ en: `WeChat: ${wechatId}`, fa: `وی‌چت: ${wechatId}`, zh: `微信：${wechatId}`, tr: `WeChat: ${wechatId}` } as Record<string, string>)[lang];
const f = ({
  en: { name: 'Haniya Parsan Darou Co.', reach: 'Get in touch', phone: 'Telephone', email: 'Email', office: 'Head office', hoursLabel: 'Office hours', offices: 'Our offices', hq: 'Head office', partner: 'Partner office', wholesaler: 'Our exclusive wholesaler office', cities: ['Tehran', 'Istanbul', 'Hangzhou', 'Zhenjiang'], countries: ['Iran', 'Türkiye', 'China', 'China'], top: 'Back to top', enquire: 'Send an enquiry' },
  fa: { name: 'شرکت هانیا پرسان دارو', reach: 'ارتباط با ما', phone: 'تلفن', email: 'ایمیل', office: 'دفتر مرکزی', hoursLabel: 'ساعت کاری', offices: 'دفاتر ما', hq: 'دفتر مرکزی', partner: '', wholesaler: 'دفتر عمده‌فروش انحصاری ما', cities: ['تهران', 'استانبول', 'هانگژو', 'ژن‌جیانگ'], countries: ['ایران', 'ترکیه', 'چین', 'چین'], top: 'بازگشت به بالا', enquire: 'ثبت درخواست' },
  zh: { name: '汉尼亚帕尔桑药业有限公司（汉帕斯）', reach: '联系我们', phone: '电话', email: '电子邮件', office: '总部', hoursLabel: '办公时间', offices: '办事机构', hq: '总部', partner: '合作伙伴办事处', wholesaler: '合作伙伴办事处', cities: ['德黑兰', '伊斯坦布尔', '杭州', '镇江'], countries: ['伊朗', '土耳其', '中国', '中国'], top: '返回顶部', enquire: '提交询盘' },
  tr: { name: 'Haniya Parsan Darou Co.', reach: 'Bize ulaşın', phone: 'Telefon', email: 'E-posta', office: 'Genel merkez', hoursLabel: 'Çalışma saatleri', offices: 'Ofislerimiz', hq: 'Genel merkez', partner: 'Ortak ofis', wholesaler: 'Münhasır toptancımızın ofisi', cities: ['Tahran', 'İstanbul', 'Hangzhou', 'Zhenjiang'], countries: ['İran', 'Türkiye', 'Çin', 'Çin'], top: 'Başa dön', enquire: 'Talep gönderin' },
} as const)[lang];
const path0 = stripLang(Astro.url.pathname);
const switchPath = /^\/(home|404)(\.html)?\/?$/.test(path0) ? '/' : path0;  // keep the same page when switching language
const langs = ([
  { l: 'en', label: 'English' }, { l: 'fa', label: 'فارسی' },
  { l: 'zh', label: '中文' }, { l: 'tr', label: 'Türkçe' },
] as const).map(x => ({ ...x, href: localePath(switchPath, x.l) }));
---
<footer class:list={['site-footer', { 'hanpars-zh-hans': lang === 'zh' }]} dir={dir(lang)}>
  <img class="ft-watermark" src={brand === 'regulatory' ? '/brand/hanpars-regulatory-light.png' : '/brand/hanpars-logo-transparent.png'} alt="" aria-hidden="true" width="222" height="123" loading="lazy" decoding="async" />
  <div class="container ft-inner">
    <div class="ft-top">
      <div class="ft-brand">
        <p class="ft-name">{f.name}</p>
        <p>{s.footer.intro}</p>
        {lang !== 'fa' && <a class="button button-light ft-cta" href={L('/contact-us-1')}>{f.enquire}<Icon name="arrow" size={18} class="ft-arrow" /></a>}
      </div>
      <div class="ft-contact" aria-label={f.reach}>
        <h2 class="ft-label">{f.reach}</h2>
        {lang !== 'fa' && <a class="ft-card" href="tel:+982188883325"><span class="ft-ico"><Icon name="phone" size={18} /></span><span><small>{f.phone}</small><strong dir="ltr" data-fa-digits>+98 21 8888 3325</strong></span></a>}
        <a class="ft-card" href={L(brand === 'regulatory' ? '/contact-us-1?type=regulatory' : '/contact-us-1')} data-m={mEnc(email)}><span class="ft-ico"><Icon name="mail" size={18} /></span><span><small>{f.email}</small><strong dir="ltr" lang="en" data-m-text>{mShow(email)}</strong></span></a>
        {lang === 'zh' && wechatId && <div class="ft-card"><span class="ft-ico"><WeChatIcon size={18} uid="ftc" /></span><span><small>微信</small><a href={L('/contact-us-1#wechat')} data-wechat><strong dir="ltr" lang="en">{wechatId}</strong></a></span></div>}
        {lang !== 'fa' && <div class="ft-card"><span class="ft-ico"><Icon name="pin" size={18} /></span><span><small>{f.office}</small><strong>{s.footer.address}</strong></span></div>}
        {lang !== 'fa' && <div class="ft-card"><span class="ft-ico"><Icon name="clock" size={18} /></span><span><small>{s.contact.hours}</small><strong>{s.contact.hoursText}</strong></span></div>}
      </div>
    </div>

    <nav class="ft-links" aria-label="Footer">
      {s.groups.map(group => (
        <details class="ft-group" open>
          <summary><h3>{group.label}</h3><Icon name="down" size={18} class="ft-chev" /></summary>
          <ul>{group.items.map(item => <li><a href={L(item.href)}>{item.label}</a></li>)}</ul>
        </details>
      ))}
    </nav>

    <div class="ft-offices">
      <span class="ft-label">{f.offices}</span>
      <ul>{f.cities.map((c, i) => <li><strong>{c}</strong><span>{[f.countries[i], i === 0 ? f.hq : i === 3 ? f.wholesaler : f.partner].filter(Boolean).join(' · ')}</span></li>)}</ul>
    </div>

    <div class="ft-bottom">
      <span>© {new Date().getFullYear()} {s.footer.rights}</span>
      <ul class="ft-langs">{langs.map(x => <li><a href={x.href} lang={x.l} hreflang={x.l} aria-current={x.l === lang ? 'true' : undefined}>{x.label}</a></li>)}</ul>
      <span class="ft-socials"><a class="ft-social" href="https://www.linkedin.com/company/hanpars/" target="_blank" rel="noopener noreferrer me" aria-label={({ en: 'Hanpars on LinkedIn', fa: 'هانیا پرسان دارو در لینکدین', zh: 'Hanpars 领英主页', tr: 'LinkedIn’de Hanpars' } as Record<string, string>)[lang]} title="LinkedIn"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11.25H3zM9.5 9.75h3.83v1.54h.06c.53-1 1.84-2.06 3.79-2.06 4.05 0 4.8 2.67 4.8 6.13V21h-4v-5c0-1.2-.02-2.73-1.66-2.73-1.67 0-1.92 1.3-1.92 2.64V21h-4z"/></svg></a><a class="ft-social ft-social-tg" href="https://t.me/hanpars" target="_blank" rel="noopener noreferrer me" aria-label={({ en: 'Message Hanpars on Telegram', fa: 'گفت‌وگو با هانیا پرسان دارو در تلگرام', zh: '通过 Telegram 联系 Hanpars', tr: 'Telegram’da Hanpars ile yazışın' } as Record<string, string>)[lang]} title="Telegram"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M21.4 4.2 2.9 11.3c-1 .4-1 1.6 0 1.9l4.6 1.5 1.8 5.6c.2.7 1.1.9 1.6.4l2.6-2.4 4.7 3.5c.6.4 1.4.1 1.6-.6l3.2-15.3c.2-1-.7-1.9-1.6-1.7zM9.6 14.2l-.5 3.7-1.3-4.3 9.8-6.3z"/></svg></a>{wechatId && <a class="ft-social ft-social-wx" href={L('/contact-us-1#wechat')} data-wechat aria-label={wxLabel} title={wxLabel}><WeChatIcon size={16} uid="ftr" /></a>}</span>
      <a class="ft-top-link" href="#">{f.top}<Icon name="down" size={16} class="ft-up" /></a>
    </div>
  </div>
</footer>
<script>
  // Link groups start open (no-JS and desktop); on phones they collapse into an accordion.
  const mq = window.matchMedia('(max-width:700px)');
  const sync = () => document.querySelectorAll<HTMLDetailsElement>('.ft-group').forEach(d => { d.open = !mq.matches; });
  sync(); mq.addEventListener('change', sync);
</script>
