---
import Icon from './Icon.astro';
import DosageFormIcon from './DosageFormIcon.astro';
import portfolio from '../data/portfolio.json';
const products = portfolio.groups.flatMap(group => group.products.map(product => ({ ...product, area:group.title, areaId:group.id })));
const searchText = (product:typeof products[number]) => [product.name, product.atc, product.area, product.statusLabel, ...product.origins, ...product.forms.flatMap(form => [form.form,form.strength])].join(' ').toLowerCase();
---
<section class="portfolio-section section-navy" id="product-portfolio" aria-labelledby="portfolio-title" data-portfolio>
  <div class="container">
    <div class="portfolio-intro">
      <div><h2 id="portfolio-title">The Hanpars portfolio</h2><p class="portfolio-lede">{portfolio.description}</p><div class="actions"><a class="button button-light" href="/contact-us-1?type=sourcing">Discuss a product</a><a class="text-link" href="#fdf-reference">Skip to the full reference list</a></div></div>
      <dl class="portfolio-stats"><div><dt>Medicines registered</dt><dd class="num">{portfolio.counts.total}</dd></div><div><dt>Available in Iran</dt><dd class="num">{portfolio.counts.available}</dd></div><div><dt>Launching</dt><dd class="num">{portfolio.counts.launching}</dd></div><div><dt>Therapeutic areas</dt><dd class="num">{portfolio.counts.areas}</dd></div></dl>
    </div>
    <div class="portfolio-capabilities">{portfolio.trust.map(item=><article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
  </div>
  <div class="portfolio-body">
    <div class="container">
      <div class="portfolio-browse-heading"><h3>Browse by therapeutic area</h3><p>Dosage forms, strengths and WHO ATC codes as licensed. Status as of {portfolio.snapshot}.</p></div>
      <div class="portfolio-controls">
        <div class="portfolio-filter-row"><label class="search-input portfolio-search"><Icon name="search" size={18}/><input type="search" placeholder="Search by molecule, ATC code or strength" aria-label="Search the product portfolio by molecule, ATC code or strength" data-portfolio-search autocomplete="off"/></label><div class="portfolio-view" role="group" aria-label="Portfolio view"><button type="button" data-portfolio-view="cards" aria-pressed="true" aria-controls="portfolio-cards">Cards</button><button type="button" data-portfolio-view="table" aria-pressed="false" aria-controls="portfolio-table">Table</button></div></div>
        <div class="portfolio-area-filters" role="group" aria-label="Filter portfolio by therapeutic area"><button type="button" data-portfolio-area="all" aria-pressed="true">All areas <span>{portfolio.counts.total}</span></button>{portfolio.groups.map(group=><button type="button" data-portfolio-area={group.id} aria-pressed="false">{group.title}<span>{group.products.length}</span></button>)}</div>
      </div>
      <div class="portfolio-results"><span class="portfolio-result-count" data-portfolio-count aria-live="polite">46 molecules across 9 therapeutic areas</span><button type="button" class="portfolio-clear" data-portfolio-reset>Clear filters</button></div>
      <div id="portfolio-cards" data-portfolio-cards>
        {portfolio.groups.map(group=><section class="portfolio-group" data-portfolio-group={group.id} aria-labelledby={`portfolio-${group.id}`}><div class="portfolio-group-head"><div><h3 id={`portfolio-${group.id}`}>{group.title}</h3><p class="portfolio-kicker">{group.kicker}</p><p>{group.description}</p></div><span class="portfolio-group-count"><strong data-portfolio-group-count>{group.products.length}</strong> <span data-portfolio-group-label>{group.products.length===1?'molecule':'molecules'}</span></span></div><div class="portfolio-card-grid">{group.products.map(product=>{
          const entry = {...product,area:group.title,areaId:group.id};
          return <article class="portfolio-product-card" data-portfolio-card data-area={group.id} data-search={searchText(entry)}><div class="portfolio-card-top"><h4>{product.name}</h4><span class="portfolio-form-icons">{product.formIcons.map(icon=><DosageFormIcon name={icon.id} label={icon.label}/>)}</span></div><dl class="portfolio-forms">{product.forms.map(form=><div><dt>{form.form}</dt><dd>{form.strength}</dd></div>)}</dl><div class="portfolio-card-meta"><span class="portfolio-origin">{product.origins.join(', ')}</span><span class:list={['portfolio-badge',product.status==='available'?'portfolio-available':'portfolio-launching']}>{product.statusLabel}</span></div><a class="portfolio-enquire" href={`/contact-us-1?type=sourcing&product=${encodeURIComponent(product.name)}`} aria-label={`Prepare an enquiry about ${product.name}`}>Discuss this product</a></article>;
        })}</div></section>)}
      </div>
      <div id="portfolio-table" class="portfolio-table-wrap" data-portfolio-table hidden><div class="portfolio-table-scroll" tabindex="0" role="region" aria-label="Product portfolio table"><table class="portfolio-table"><thead><tr><th scope="col">Molecule</th><th scope="col">ATC</th><th scope="col">Dosage form and strength</th><th scope="col">Therapeutic area</th><th scope="col">Origin</th><th scope="col">Status</th><th scope="col">Enquiry</th></tr></thead><tbody>{products.slice().sort((a,b)=>a.name.localeCompare(b.name,'en')).map(product=><tr data-portfolio-row data-area={product.areaId} data-search={searchText(product)}><td><strong>{product.name}</strong></td><td><code>{product.atc}</code></td><td>{product.forms.map(form=><div class="portfolio-table-form"><span>{form.form}</span><strong>{form.strength}</strong></div>)}</td><td>{product.area}</td><td>{product.origins.join(', ')}</td><td><span class:list={['portfolio-badge',product.status==='available'?'portfolio-available':'portfolio-launching']}>{product.statusLabel}</span></td><td><a class="text-link" href={`/contact-us-1?type=sourcing&product=${encodeURIComponent(product.name)}`} aria-label={`Enquire about ${product.name}`}>Enquire</a></td></tr>)}</tbody></table></div></div>
      <div class="portfolio-empty" data-portfolio-empty hidden><h3>No matching products</h3><p>Try another molecule, ATC code or therapeutic area.</p><button class="button button-outline button-small" type="button" data-portfolio-reset>Clear filters</button></div>
      <p class="portfolio-status-note">Portfolio status reflects IFDA licensing and import scheduling as of {portfolio.snapshot}. Dosage forms and strengths are as licensed by the IFDA; manufacturer details and certificates are available to healthcare institutions and partners on request. Confirm current availability and launch timing when enquiring.</p>
      <div class="portfolio-manufacturer"><div><h3>{portfolio.manufacturer.title}</h3><p>{portfolio.manufacturer.description}</p><div class="actions"><a class="button button-navy" href="/contact-us-1?type=regulatory">Discuss representation in Iran</a><a class="text-link" href={portfolio.manufacturer.contactHref}>Email the regulatory team</a></div></div><ul>{portfolio.manufacturer.services.map(service=><li>{service}</li>)}</ul></div>
    </div>
  </div>
</section>
<script>import '../scripts/portfolio';</script>

<style>
  .portfolio-section { padding:0; }
  .portfolio-intro { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); gap:72px; padding:104px 0 64px; align-items:end; }
  .portfolio-lede { color:var(--on-navy); font-size:19px; line-height:1.65; max-width:34em; margin:26px 0 36px; }
  .portfolio-stats { margin:0; display:grid; grid-template-columns:1fr 1fr; gap:36px 32px; }
  .portfolio-stats div { border-top:1px solid var(--line-dark); padding-top:18px; }
  .portfolio-stats dt { font-size:14.5px; color:var(--on-navy-muted); margin-bottom:8px; }
  .portfolio-stats dd { margin:0; font-size:54px; line-height:1; color:#fff; }
  .portfolio-capabilities { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:40px; padding:40px 0 88px; border-top:1px solid var(--line-dark); }
  .portfolio-capabilities h3 { font-size:21px; line-height:1.3; margin-bottom:12px; color:#fff; font-variation-settings:'opsz' 24; }
  .portfolio-capabilities p { font-size:15px; line-height:1.65; color:var(--on-navy-muted); margin:0; }
  .portfolio-body { background:#fff; color:var(--ink); padding-bottom:96px; }
  .portfolio-body h3 { color:var(--navy); }
  .portfolio-body :global(.text-link) { color:var(--navy); border-color:var(--line); }
  .portfolio-body :global(.text-link:hover) { color:var(--lapis); border-color:var(--lapis); }
  .portfolio-browse-heading { display:flex; justify-content:space-between; align-items:flex-end; gap:40px; padding:88px 0 32px; }
  .portfolio-browse-heading h3 { font-size:34px; }
  .portfolio-browse-heading p { font-size:15.5px; color:var(--muted); margin:0; max-width:30em; text-align:right; }
  .portfolio-controls { padding:24px 0; border-top:1px solid var(--navy); }
  .portfolio-filter-row { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; margin-bottom:22px; }
  .portfolio-search { width:min(460px,100%); }
  .portfolio-view { display:flex; border:1px solid var(--line); flex:none; }
  .portfolio-view button { background:transparent; border:0; color:var(--muted); font-size:14px; padding:9px 18px; min-height:40px; transition:background .2s,color .2s; }
  .portfolio-view button[aria-pressed=true] { background:var(--navy); color:#fff; }
  .portfolio-area-filters { display:flex; flex-wrap:wrap; gap:8px 8px; }
  .portfolio-area-filters button { display:inline-flex; align-items:center; gap:8px; background:transparent; border:1px solid var(--line); border-radius:999px; padding:7px 14px; min-height:38px; color:var(--ink); font-size:14px; transition:border-color .2s,background .2s,color .2s; }
  .portfolio-area-filters button>span { color:var(--faint); font-size:13px; }
  .portfolio-area-filters button:hover { border-color:var(--navy); }
  .portfolio-area-filters button[aria-pressed=true] { background:var(--navy); color:#fff; border-color:var(--navy); }
  .portfolio-area-filters button[aria-pressed=true]>span { color:var(--on-navy-muted); }
  .portfolio-results { display:flex; justify-content:space-between; align-items:center; gap:20px; padding:16px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .portfolio-result-count { font-size:14px; color:var(--muted); }
  .portfolio-clear { background:none; border:0; color:var(--lapis); font-size:14px; padding:6px 0; border-bottom:1px solid transparent; }
  .portfolio-clear:hover { border-bottom-color:var(--lapis); }
  .portfolio-group { padding:56px 0 24px; border-bottom:1px solid var(--line); }
  .portfolio-group-head { display:flex; justify-content:space-between; align-items:flex-start; gap:32px; margin-bottom:32px; }
  .portfolio-group-head h3 { font-size:32px; margin-bottom:6px; }
  .portfolio-kicker { font-family:var(--serif); font-style:italic; color:var(--lapis); font-size:18px; margin-bottom:12px; }
  .portfolio-group-head p { color:var(--muted); font-size:16px; max-width:40em; margin:0; }
  .portfolio-group-count { font-size:14px; color:var(--muted); white-space:nowrap; padding-top:12px; }
  .portfolio-group-count strong { font-family:var(--serif); font-weight:400; font-size:26px; color:var(--navy); margin-right:4px; }
  .portfolio-card-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:40px 48px; padding-bottom:32px; }
  .portfolio-product-card { display:flex; flex-direction:column; padding-top:20px; border-top:1px solid var(--line); }
  .portfolio-card-top { display:flex; align-items:flex-start; gap:16px; justify-content:space-between; margin-bottom:18px; }
  .portfolio-card-top h4 { font-size:23px; line-height:1.25; overflow-wrap:anywhere; color:var(--navy); }
  .portfolio-form-icons { display:inline-flex; align-items:center; gap:6px; flex:none; color:var(--lapis); padding-top:4px; }
  .portfolio-form-icons :global(svg) { display:block; }
  .portfolio-forms { padding:0; margin:0 0 18px; }
  .portfolio-forms>div { display:flex; justify-content:space-between; gap:16px; padding:8px 0; border-top:1px dotted var(--line); font-size:15px; line-height:1.5; }
  .portfolio-forms>div:first-child { border-top:0; }
  .portfolio-forms dt { color:var(--muted); }
  .portfolio-forms dd { margin:0; text-align:right; color:var(--ink); font-weight:500; }
  .portfolio-card-meta { display:flex; align-items:baseline; flex-wrap:wrap; gap:8px 16px; justify-content:space-between; margin-top:auto; font-size:14px; }
  .portfolio-origin { color:var(--muted); }
  .portfolio-badge { font-size:13.5px; color:var(--muted); white-space:nowrap; }
  .portfolio-badge:before { content:''; display:inline-block; width:7px; height:7px; border-radius:50%; margin-right:7px; background:currentColor; vertical-align:middle; }
  .portfolio-available { color:var(--lapis); }
  .portfolio-launching { color:var(--faint); }
  .portfolio-enquire { margin-top:18px; align-self:flex-start; color:var(--navy); font-size:15px; font-weight:500; border-bottom:1px solid var(--line); padding-bottom:2px; transition:border-color .2s,color .2s; }
  .portfolio-enquire:hover { color:var(--lapis); border-color:var(--lapis); }
  .portfolio-table-wrap { margin-top:8px; border-bottom:1px solid var(--line); }
  .portfolio-table-scroll { overflow:auto; }
  .portfolio-table { width:100%; border-collapse:collapse; font-size:15px; }
  .portfolio-table th { text-align:left; color:var(--muted); padding:14px 20px 14px 0; font-size:13px; font-weight:500; border-bottom:1px solid var(--line); white-space:nowrap; letter-spacing:.02em; }
  .portfolio-table td { padding:16px 20px 16px 0; border-bottom:1px solid var(--line); vertical-align:top; color:var(--muted); }
  .portfolio-table tbody tr:last-child td { border-bottom:0; }
  .portfolio-table td:first-child { color:var(--navy); min-width:175px; font-family:var(--serif); font-size:18px; }
  .portfolio-table td:first-child strong { font-weight:400; }
  .portfolio-table td:nth-child(3) { min-width:190px; }
  .portfolio-table code { color:var(--ink); font-size:14px; white-space:nowrap; }
  .portfolio-table-form { margin-bottom:8px; }
  .portfolio-table-form:last-child { margin:0; }
  .portfolio-table-form span,.portfolio-table-form strong { display:block; font-size:13.5px; }
  .portfolio-table-form strong { color:var(--ink); font-weight:500; }
  .portfolio-status-note { color:var(--muted); font-size:14.5px; margin:32px 0 0; line-height:1.7; max-width:60em; }
  .portfolio-manufacturer { margin-top:88px; display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); gap:64px; padding-top:40px; border-top:1px solid var(--navy); }
  .portfolio-manufacturer h3 { font-size:32px; line-height:1.2; margin-bottom:18px; max-width:14em; }
  .portfolio-manufacturer p { color:var(--muted); font-size:17px; line-height:1.7; max-width:36em; margin-bottom:28px; }
  .portfolio-manufacturer ul { list-style:none; padding:0; margin:0; }
  .portfolio-manufacturer li { padding:14px 0; border-bottom:1px solid var(--line); color:var(--ink); font-size:16.5px; }
  .portfolio-manufacturer li:first-child { border-top:1px solid var(--line); }
  .portfolio-empty { padding:56px 0; color:var(--muted); }
  .portfolio-empty h3 { font-size:26px; margin-bottom:10px; }
  .portfolio-empty p { margin-bottom:20px; }
  @media(max-width:1100px) { .portfolio-intro { gap:40px; } .portfolio-stats dd { font-size:44px; } .portfolio-capabilities { grid-template-columns:repeat(2,minmax(0,1fr)); gap:32px; } .portfolio-card-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:32px 40px; } }
  @media(max-width:860px) { .portfolio-intro { grid-template-columns:1fr; padding:72px 0 48px; gap:40px; } .portfolio-stats { grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; } .portfolio-stats dd { font-size:36px; } .portfolio-stats dt { font-size:12.5px; } .portfolio-capabilities { padding:32px 0 64px; } .portfolio-browse-heading { flex-direction:column; align-items:flex-start; gap:12px; padding:64px 0 24px; } .portfolio-browse-heading p { text-align:left; } .portfolio-browse-heading h3 { font-size:30px; } .portfolio-group-head { flex-direction:column; gap:10px; } .portfolio-group-count { padding-top:0; } .portfolio-manufacturer { grid-template-columns:1fr; gap:32px; margin-top:64px; } .portfolio-body { padding-bottom:64px; } }
  @media(max-width:560px) { .portfolio-stats { grid-template-columns:1fr 1fr; gap:24px 20px; } .portfolio-stats dd { font-size:40px; } .portfolio-capabilities { grid-template-columns:1fr; } .portfolio-filter-row { flex-wrap:wrap; gap:14px; } .portfolio-search { width:100%; } .portfolio-view button { font-size:13px; min-height:36px; padding:8px 14px; } .portfolio-area-filters button { font-size:13px; padding:6px 11px; } .portfolio-card-grid { grid-template-columns:1fr; gap:28px; } .portfolio-group-head h3 { font-size:27px; } .portfolio-manufacturer h3 { font-size:27px; } }
</style>
