---
import Icon from './Icon.astro';
import DosageFormIcon from './DosageFormIcon.astro';
import portfolio from '../data/portfolio.json';
import { portfolioL, locName } from '../data/locale';
import { htmlLang } from '../i18n';
import { langFromPath, localePath, t } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const fa = lang === 'fa';
const pl: any = lang === 'en' ? null : portfolioL[lang];
const sep = lang === 'fa' ? '، ' : lang === 'zh' ? '、' : ', ';
const s = t(lang).portfolio;
const L = (p: string) => localePath(p, lang);
const G = (g:{id:string;title:string;kicker:string;description:string}) => pl ? { ...g, ...(pl.groups[g.id] ?? {}) } : g;
const F = (form:string) => pl ? (pl.forms?.[form] ?? form) : form;
const O = (o:string) => pl ? (pl.origins?.[o] ?? o) : o;
const S = (status:string) => pl ? (status === 'available' ? s.statusAvailable : s.statusLaunching) : undefined;
const snapshot = pl ? pl.snapshot : portfolio.snapshot;
const description = pl ? pl.description : portfolio.description;
const trust = pl ? pl.trust : portfolio.trust;
const manufacturer = pl ? { ...portfolio.manufacturer, ...pl.manufacturer } : portfolio.manufacturer;
const products = portfolio.groups.flatMap(group => group.products.map(product => ({ ...product, area:G(group).title, areaId:group.id })));
const searchText = (product:typeof products[number]) => [product.name, product.atc, product.area, product.statusLabel, ...product.origins, ...product.forms.flatMap(form => [form.form,form.strength])].join(' ').toLowerCase();
const i18n = JSON.stringify({ count: s.count(987654,123456).replace('987654','{n}').replace('123456','{a}'), filtered: s.countFiltered, molecule: s.molecule, molecules: s.molecules });
---
<section class="portfolio-section section-navy" id="product-portfolio" aria-labelledby="portfolio-title" data-portfolio data-i18n={i18n}>
  <div class="container">
    <div class="portfolio-intro">
      <div><h2 id="portfolio-title">{s.title}</h2><p class="portfolio-lede">{description}</p><div class="actions"><a class="button button-light" href={L('/contact-us-1?type=sourcing')}>{s.discuss}</a><a class="text-link" href="#fdf-reference">{s.skip}</a></div></div>
      <dl class="portfolio-stats"><div><dt>{s.registered}</dt><dd class="num">{portfolio.counts.total}</dd></div><div><dt>{s.available}</dt><dd class="num">{portfolio.counts.available}</dd></div><div><dt>{s.launching}</dt><dd class="num">{portfolio.counts.launching}</dd></div><div><dt>{s.areas}</dt><dd class="num">{portfolio.counts.areas}</dd></div></dl>
    </div>
    <div class="portfolio-capabilities">{trust.map((item: any)=><article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
  </div>
  <div class="portfolio-body">
    <div class="container">
      <div class="portfolio-browse-heading"><h3>{s.browse}</h3><p>{s.browseNote(snapshot)}</p></div>
      <div class="portfolio-controls">
        <div class="portfolio-filter-row"><label class="search-input portfolio-search"><Icon name="search" size={18}/><input type="search" placeholder={s.search} aria-label={s.search} data-portfolio-search autocomplete="off"/></label><div class="portfolio-view" role="group" aria-label="View"><button type="button" data-portfolio-view="cards" aria-pressed="true" aria-controls="portfolio-cards">{s.cards}</button><button type="button" data-portfolio-view="table" aria-pressed="false" aria-controls="portfolio-table">{s.table}</button></div></div>
        <div class="portfolio-area-filters" role="group" aria-label={s.browse}><button type="button" data-portfolio-area="all" aria-pressed="true">{s.allAreas} <span>{portfolio.counts.total}</span></button>{portfolio.groups.map(group=><button type="button" data-portfolio-area={group.id} aria-pressed="false">{G(group).title}<span>{group.products.length}</span></button>)}</div>
      </div>
      <div class="portfolio-results"><span class="portfolio-result-count" data-portfolio-count aria-live="polite">{s.count(portfolio.counts.total, portfolio.counts.areas)}</span><button type="button" class="portfolio-clear" data-portfolio-reset>{s.clear}</button></div>
      <div id="portfolio-cards" data-portfolio-cards>
        {portfolio.groups.map(group=><section class="portfolio-group" data-portfolio-group={group.id} aria-labelledby={`portfolio-${group.id}`}><div class="portfolio-group-head"><div><h3 id={`portfolio-${group.id}`}>{G(group).title}</h3><p class="portfolio-kicker">{G(group).kicker}</p><p>{G(group).description}</p></div><span class="portfolio-group-count"><strong data-portfolio-group-count>{group.products.length}</strong> <span data-portfolio-group-label>{group.products.length===1?s.molecule:s.molecules}</span></span></div><div class="portfolio-card-grid">{group.products.map(product=>{
          const entry = {...product,area:G(group).title,areaId:group.id};
          return <article class="portfolio-product-card" data-portfolio-card data-area={group.id} data-search={searchText(entry)}><div class="portfolio-card-top"><span class="portfolio-form-icons">{product.formIcons.slice(0,2).map(icon=><DosageFormIcon name={icon.id} label={icon.label} size={24}/>)}</span><div class="portfolio-card-title"><h4 dir="ltr">{product.name}</h4>{lang !== 'en' && lang !== 'fa' && locName(lang, product.name.replace(/\s*\(.*\)\s*/g, '')) && <span class="portfolio-loc" lang={htmlLang[lang]}>{locName(lang, product.name.replace(/\s*\(.*\)\s*/g, ''))}</span>}<code class="portfolio-atc" dir="ltr">{product.atc}</code></div></div><dl class="portfolio-forms">{product.forms.map(form=><div><dt>{F(form.form)}</dt><dd dir="ltr">{form.strength}</dd></div>)}</dl><div class="portfolio-card-meta"><span class="portfolio-origin"><Icon name="globe" size={15}/>{product.origins.map(O).join(sep)}</span><span class:list={['portfolio-badge',product.status==='available'?'portfolio-available':'portfolio-launching']}>{S(product.status) ?? product.statusLabel}</span></div><a class="portfolio-enquire" href={L(`/contact-us-1?type=sourcing&product=${encodeURIComponent(product.name)}`)} aria-label={`${s.discussProduct}: ${product.name}`}><span>{s.discussProduct}</span><span class="portfolio-arrow" aria-hidden="true">{fa ? '←' : '→'}</span></a></article>;
        })}</div></section>)}
      </div>
      <div id="portfolio-table" class="portfolio-table-wrap" data-portfolio-table hidden><div class="portfolio-table-scroll" tabindex="0" role="region" aria-label={s.table}><table class="portfolio-table"><thead><tr>{s.th.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{products.slice().sort((a,b)=>a.name.localeCompare(b.name,'en')).map(product=><tr data-portfolio-row data-area={product.areaId} data-search={searchText(product)}><td dir="ltr"><strong>{product.name}</strong></td><td><code>{product.atc}</code></td><td>{product.forms.map(form=><div class="portfolio-table-form"><span>{F(form.form)}</span><strong dir="ltr">{form.strength}</strong></div>)}</td><td>{product.area}</td><td>{product.origins.map(O).join(sep)}</td><td><span class:list={['portfolio-badge',product.status==='available'?'portfolio-available':'portfolio-launching']}>{S(product.status) ?? product.statusLabel}</span></td><td><a class="text-link" href={L(`/contact-us-1?type=sourcing&product=${encodeURIComponent(product.name)}`)} aria-label={`${s.discussProduct}: ${product.name}`}>{t(lang).catalogue.enquire}</a></td></tr>)}</tbody></table></div></div>
      <div class="portfolio-empty" data-portfolio-empty hidden><h3>{s.emptyTitle}</h3><p>{s.emptyText}</p><button class="button button-outline button-small" type="button" data-portfolio-reset>{s.clear}</button></div>
      <p class="portfolio-status-note">{s.statusNote(snapshot)}</p>
      <div class="portfolio-manufacturer"><div><h3>{manufacturer.title}</h3><p>{manufacturer.description}</p><div class="actions"><a class="button button-navy" href={L('/contact-us-1?type=regulatory')}>{s.represent}</a><a class="text-link" href={portfolio.manufacturer.contactHref}>{s.emailRa}</a></div></div><ul>{manufacturer.services.map((service: string)=><li>{service}</li>)}</ul></div>
    </div>
  </div>
</section>
<script>import '../scripts/portfolio';</script>

<style>
  .portfolio-section { padding:0; }
  .portfolio-intro { display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); gap:72px; padding:104px 0 64px; align-items:end; }
  .portfolio-lede { color:var(--on-navy); font-size:19px; line-height:1.65; max-width:34em; margin:26px 0 36px; }
  .portfolio-stats { margin:0; display:grid; grid-template-columns:1fr 1fr; gap:36px 32px; }
  .portfolio-stats div { border-top:1px solid var(--line-dark); padding-top:18px; }
  .portfolio-stats dt { font-size:14.5px; color:var(--on-navy-muted); margin-bottom:8px; }
  .portfolio-stats dd { margin:0; font-size:46px; line-height:1; color:var(--glacier); }
  .portfolio-capabilities { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:40px; padding:40px 0 88px; border-top:1px solid var(--line-dark); }
  .portfolio-capabilities h3 { font-size:17px; line-height:1.35; margin-bottom:12px; color:#fff; }
  .portfolio-capabilities p { font-size:15px; line-height:1.65; color:var(--on-navy-muted); margin:0; }
  .portfolio-body { background:var(--paper); color:var(--ink); padding-bottom:96px; }
  .portfolio-body h3 { color:var(--navy); }
  .portfolio-body :global(.text-link) { color:var(--navy); border-color:var(--line); }
  .portfolio-body :global(.text-link:hover) { color:var(--lapis); border-color:var(--lapis); }
  .portfolio-browse-heading { display:flex; justify-content:space-between; align-items:flex-end; gap:40px; padding:88px 0 32px; }
  .portfolio-browse-heading h3 { font-size:28px; }
  .portfolio-browse-heading p { font-size:15.5px; color:var(--muted); margin:0; max-width:30em; text-align:right; }
  .portfolio-controls { padding:24px 0; border-top:1px solid var(--black); }
  .portfolio-filter-row { display:flex; align-items:flex-end; justify-content:space-between; gap:24px; margin-bottom:22px; }
  .portfolio-search { width:min(460px,100%); }
  .portfolio-view { display:flex; border:1px solid var(--line); flex:none; }
  .portfolio-view button { background:transparent; border:0; color:var(--muted); font-size:14px; padding:9px 18px; min-height:40px; transition:background .2s,color .2s; }
  .portfolio-view button[aria-pressed=true] { background:var(--navy); color:#fff; }
  .portfolio-area-filters { display:flex; flex-wrap:wrap; gap:8px 8px; }
  .portfolio-area-filters button { display:inline-flex; align-items:center; gap:8px; background:transparent; border:1px solid var(--line); border-radius:999px; padding:7px 14px; min-height:38px; color:var(--ink); font-size:14px; transition:border-color .2s,background .2s,color .2s; }
  .portfolio-area-filters button>span { color:var(--faint); font-size:13px; }
  .portfolio-area-filters button:hover { border-color:var(--navy); }
  .portfolio-area-filters button[aria-pressed=true] { background:var(--navy); color:#fff; border-color:var(--navy); }
  .portfolio-area-filters button[aria-pressed=true]>span { color:var(--on-navy-muted); }
  .portfolio-results { display:flex; justify-content:space-between; align-items:center; gap:20px; padding:16px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
  .portfolio-result-count { font-size:14px; color:var(--muted); }
  .portfolio-clear { background:none; border:0; color:var(--lapis); font-size:14px; padding:6px 0; border-bottom:1px solid transparent; }
  .portfolio-clear:hover { border-bottom-color:var(--lapis); }
  .portfolio-group { padding:56px 0 24px; border-bottom:1px solid var(--line); }
  .portfolio-group-head { display:flex; justify-content:space-between; align-items:flex-start; gap:32px; margin-bottom:32px; }
  .portfolio-group-head h3 { font-size:26px; margin-bottom:6px; }
  .portfolio-kicker { font-family:var(--display); font-weight:600; font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:var(--lapis); margin-bottom:12px; }
  .portfolio-group-head p { color:var(--muted); font-size:16px; max-width:40em; margin:0; }
  .portfolio-group-count { font-size:14px; color:var(--muted); white-space:nowrap; padding-top:12px; }
  .portfolio-group-count strong { font-family:var(--display); font-weight:600; font-size:22px; color:var(--navy); margin-inline-end:4px; }
  .portfolio-card-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; padding-bottom:32px; }
  .portfolio-product-card { position:relative; display:flex; flex-direction:column; background:#fff; border:1px solid var(--line); border-radius:14px; padding:22px 22px 0; box-shadow:0 1px 2px #1414140a; transition:transform .25s var(--ease),box-shadow .25s var(--ease),border-color .25s; }
  .portfolio-product-card:before { content:''; position:absolute; inset-inline:22px; top:-1px; height:3px; border-radius:0 0 3px 3px; background:var(--glacier); opacity:0; transition:opacity .25s; }
  .portfolio-product-card:hover { transform:translateY(-3px); box-shadow:0 18px 36px -18px #14141440; border-color:#c9d9df; }
  .portfolio-product-card:hover:before { opacity:1; }
  .portfolio-card-top { display:flex; align-items:center; gap:14px; margin-bottom:18px; }
  .portfolio-form-icons { display:inline-flex; align-items:center; justify-content:center; gap:4px; flex:none; min-width:48px; height:48px; padding:0 10px; border-radius:12px; background:#e9f3f7; color:var(--lapis-deep); }
  .portfolio-form-icons :global(svg) { display:block; }
  .portfolio-card-title { min-width:0; }
  .portfolio-card-top h4 { font-size:18.5px; line-height:1.25; overflow-wrap:anywhere; color:var(--navy); margin:0 0 4px; }
  .portfolio-loc { display:block; font-size:13.5px; color:var(--muted); margin:-2px 0 6px; }
  .portfolio-atc { display:inline-block; font-size:12px; letter-spacing:.06em; color:var(--muted); background:var(--paper); border-radius:6px; padding:2px 7px; }
  .portfolio-forms { padding:4px 14px; margin:0 0 18px; background:var(--white); border:1px solid #ece8df; border-radius:10px; }
  .portfolio-forms>div { display:flex; justify-content:space-between; align-items:baseline; gap:16px; padding:10px 0; border-top:1px dashed var(--line); font-size:14.5px; line-height:1.45; }
  .portfolio-forms>div:first-child { border-top:0; }
  .portfolio-forms dt { color:var(--muted); }
  .portfolio-forms dd { margin:0; text-align:end; color:var(--ink); font-family:var(--display); font-weight:600; font-size:14px; font-variant-numeric:tabular-nums; white-space:nowrap; }
  .portfolio-card-meta { display:flex; align-items:center; flex-wrap:wrap; gap:10px 16px; justify-content:space-between; margin-top:auto; font-size:14px; }
  .portfolio-origin { display:inline-flex; align-items:center; gap:6px; color:var(--muted); }
  .portfolio-origin :global(svg) { color:var(--faint); flex:none; }
  .portfolio-badge { display:inline-flex; align-items:center; font-size:13px; font-weight:500; white-space:nowrap; padding:4px 11px; border-radius:999px; background:var(--paper); color:var(--muted); }
  .portfolio-badge:before { content:''; display:inline-block; width:7px; height:7px; border-radius:50%; margin-inline-end:7px; background:currentColor; }
  .portfolio-available { background:#e3f1f6; color:var(--lapis-deep); }
  .portfolio-launching { background:var(--paper); color:var(--muted); }
  .portfolio-enquire { display:flex; justify-content:space-between; align-items:center; margin:18px -22px 0; padding:15px 22px; border-top:1px solid #ece8df; border-radius:0 0 14px 14px; color:var(--navy); font-size:15px; font-weight:600; transition:background .2s,color .2s; }
  .portfolio-arrow { font-size:18px; line-height:1; transition:transform .25s var(--ease); }
  .portfolio-enquire:hover { background:var(--navy); color:#fff; }
  .portfolio-enquire:hover .portfolio-arrow { transform:translateX(4px); }
  [dir=rtl] .portfolio-enquire:hover .portfolio-arrow { transform:translateX(-4px); }
  .portfolio-table-wrap { margin-top:8px; border-bottom:1px solid var(--line); }
  .portfolio-table-scroll { overflow:auto; }
  .portfolio-table { width:100%; border-collapse:collapse; font-size:15px; }
  .portfolio-table th { text-align:left; color:var(--muted); padding:14px 20px 14px 0; font-size:13px; font-weight:500; border-bottom:1px solid var(--line); white-space:nowrap; letter-spacing:.02em; }
  .portfolio-table td { padding:16px 20px 16px 0; border-bottom:1px solid var(--line); vertical-align:top; color:var(--muted); }
  .portfolio-table tbody tr:last-child td { border-bottom:0; }
  .portfolio-table td:first-child { color:var(--navy); min-width:175px; font-family:var(--display); font-weight:500; font-size:15px; }
  .portfolio-table td:first-child strong { font-weight:500; }
  .portfolio-table td:nth-child(3) { min-width:190px; }
  .portfolio-table code { color:var(--ink); font-size:14px; white-space:nowrap; }
  .portfolio-table-form { margin-bottom:8px; }
  .portfolio-table-form:last-child { margin:0; }
  .portfolio-table-form span,.portfolio-table-form strong { display:block; font-size:13.5px; }
  .portfolio-table-form strong { color:var(--ink); font-weight:500; }
  .portfolio-status-note { color:var(--muted); font-size:14.5px; margin:32px 0 0; line-height:1.7; max-width:60em; }
  .portfolio-manufacturer { margin-top:88px; display:grid; grid-template-columns:minmax(0,1.3fr) minmax(0,1fr); gap:64px; padding-top:40px; border-top:1px solid var(--black); }
  .portfolio-manufacturer h3 { font-size:26px; line-height:1.25; margin-bottom:18px; max-width:16em; }
  .portfolio-manufacturer p { color:var(--muted); font-size:17px; line-height:1.7; max-width:36em; margin-bottom:28px; }
  .portfolio-manufacturer ul { list-style:none; padding:0; margin:0; }
  .portfolio-manufacturer li { padding:14px 0; border-bottom:1px solid var(--line); color:var(--ink); font-size:16.5px; }
  .portfolio-manufacturer li:first-child { border-top:1px solid var(--line); }
  .portfolio-empty { padding:56px 0; color:var(--muted); }
  .portfolio-empty h3 { font-size:22px; margin-bottom:10px; }
  .portfolio-empty p { margin-bottom:20px; }
  @media(max-width:1100px) { .portfolio-intro { gap:40px; } .portfolio-stats dd { font-size:44px; } .portfolio-capabilities { grid-template-columns:repeat(2,minmax(0,1fr)); gap:32px; } .portfolio-card-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; } }
  @media(max-width:860px) { .portfolio-intro { grid-template-columns:1fr; padding:72px 0 48px; gap:40px; } .portfolio-stats { grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; } .portfolio-stats dd { font-size:36px; } .portfolio-stats dt { font-size:12.5px; } .portfolio-capabilities { padding:32px 0 64px; } .portfolio-browse-heading { flex-direction:column; align-items:flex-start; gap:12px; padding:64px 0 24px; } .portfolio-browse-heading p { text-align:left; } .portfolio-browse-heading h3 { font-size:30px; } .portfolio-group-head { flex-direction:column; gap:10px; } .portfolio-group-count { padding-top:0; } .portfolio-manufacturer { grid-template-columns:1fr; gap:32px; margin-top:64px; } .portfolio-body { padding-bottom:64px; } }
  @media(max-width:560px) { .portfolio-stats { grid-template-columns:1fr 1fr; gap:24px 20px; } .portfolio-stats dd { font-size:40px; } .portfolio-capabilities { grid-template-columns:1fr; } .portfolio-filter-row { flex-wrap:wrap; gap:14px; } .portfolio-search { width:100%; } .portfolio-view button { font-size:13px; min-height:36px; padding:8px 14px; } .portfolio-area-filters button { font-size:13px; padding:6px 11px; } .portfolio-card-grid { grid-template-columns:1fr; gap:16px; } .portfolio-product-card { padding:18px 18px 0; } .portfolio-enquire { margin:16px -18px 0; padding:14px 18px; } .portfolio-group-head h3 { font-size:27px; } .portfolio-manufacturer h3 { font-size:27px; } }
</style>
