---
/** FAQ block (same five questions in en/fa/zh/tr). Shown on the home page (with FAQPage structured data) and the About page (markup only once, on home). */
import faqZh from '../data/faq.zh.json';
import faqTr from '../data/faq.tr.json';
import faqEn from '../data/faq.en.json';
interface Props { schema?: boolean }
const { schema: withSchema = true } = Astro.props;
import { langFromPath, hreflangOf } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const faqFa = [
  { q: 'شرکت هانیا پرسان دارو چه محصولاتی وارد می‌کند؟', a: 'هانیا پرسان دارو فرآورده‌های داروییٔ بیمارستانی و تخصصی، مواد اولیهٔ دارویی (API)، مواد جانبی دارویی (اکسیپیان) و مواد اولیهٔ مکمل‌های دارویی و غذایی را برای بازار ایران تأمین و وارد می‌کند.' },
  { q: 'واردات فوریتی دارو چیست و هانیا پرسان دارو چه نقشی دارد؟', a: 'واردات فوریتی، تأمین داروهایی است که برای رفع کمبود یا نیاز درمانی فوری با مجوز سازمان غذا و دارو وارد می‌شوند. هانیا پرسان دارو دارندهٔ مجوز واردات از سازمان غذا و دارو است و تأمین، ثبت و توزیع سراسری این داروها را از طریق پخش‌های معتبر دارویی انجام می‌دهد.' },
  { q: 'آیا هانیا پرسان دارو ثبت دارو در سازمان غذا و دارو را انجام می‌دهد؟', a: 'بله. تیم رگولاتوری شرکت تشکیل پرونده، اخذ کد IRC، فارماکوویژیلانس و مدیریت تغییرات و تمدید پروانه را برای محصولات وارداتی خود و برای تولیدکنندگان خارجی انجام می‌دهد.' },
  { q: 'مواد اولیهٔ دارویی (API) از چه کشورهایی تأمین می‌شود؟', a: 'مواد مؤثره و مواد جانبی از تولیدکنندگان دارای گواهی GMP معتبر در چین، هند، ترکیه و اروپا و همراه با مستندات لازم مانند CoA، DMF یا CEP تأمین می‌شود.' },
  { q: 'چگونه برای خرید یا استعلام دارو و مواد اولیه درخواست ثبت کنیم؟', a: 'نام محصول یا مادهٔ مؤثره، گرید یا دوز، مقدار و بازار مقصد را از طریق فرم تماس وب‌سایت ارسال کنید. برای امور رگولاتوری به نشانی RA [at] hanpars.com ایمیل کنید.' },
];
const faqs = lang === 'zh' ? faqZh : lang === 'tr' ? faqTr : lang === 'en' ? faqEn : faqFa;
const heading = { fa: 'پرسش‌های متداول', zh: '常见问题', tr: 'Sık sorulan sorular', en: 'Frequently asked questions' }[lang];
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: hreflangOf[lang], mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<section class="section"><div class="container content-split">
  <h2>{heading}</h2>
  <div class="faq-list">{faqs.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
</div></section>
{withSchema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
