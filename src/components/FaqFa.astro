---
/** Persian FAQ block with FAQPage structured data (Persian home page only). */
const faqs = [
  { q: 'شرکت هانیا پرسان دارو چه محصولاتی وارد می‌کند؟', a: 'هانیا پرسان دارو داروهای ساخته‌شدهٔ بیمارستانی و تخصصی، مواد اولیهٔ دارویی (API)، مواد جانبی دارویی (اکسیپیان) و مواد اولیهٔ مکمل‌های دارویی و غذایی را برای بازار ایران تأمین و وارد می‌کند.' },
  { q: 'واردات فوریتی دارو چیست و هانیا پرسان دارو چه نقشی دارد؟', a: 'واردات فوریتی، تأمین داروهایی است که برای رفع کمبود یا نیاز درمانی فوری با مجوز سازمان غذا و دارو وارد می‌شوند. هانیا پرسان دارو دارندهٔ مجوز واردات از سازمان غذا و دارو است و تأمین، ثبت و توزیع سراسری این داروها را از طریق پخش‌های معتبر دارویی انجام می‌دهد.' },
  { q: 'آیا هانیا پرسان دارو ثبت دارو در سازمان غذا و دارو را انجام می‌دهد؟', a: 'بله. تیم رگولاتوری شرکت تشکیل پرونده، اخذ کد IRC، فارماکوویژیلانس و نگه‌داری چرخهٔ عمر مجوز را برای محصولات وارداتی خود و برای تولیدکنندگان خارجی انجام می‌دهد.' },
  { q: 'مواد اولیهٔ دارویی (API) از چه کشورهایی تأمین می‌شود؟', a: 'مواد مؤثره و مواد جانبی از تولیدکنندگان دارای گواهی GMP معتبر در چین، هند، ترکیه و اروپا و همراه با مستندات لازم مانند CoA، DMF یا CEP تأمین می‌شود.' },
  { q: 'چگونه برای خرید یا استعلام دارو و مواد اولیه درخواست بدهیم؟', a: 'نام محصول یا مادهٔ مؤثره، گرید یا دوز، مقدار و بازار مقصد را از طریق فرم تماس وب‌سایت ارسال کنید یا با شمارهٔ ‎+۹۸ ۲۱ ۸۸۸۸ ۳۳۲۵ تماس بگیرید. برای امور رگولاتوری به RA@hanpars.com ایمیل بزنید.' },
];
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'fa-IR', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<section class="section"><div class="container content-split">
  <h2>پرسش‌های متداول</h2>
  <div class="faq-list">{faqs.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
</div></section>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
