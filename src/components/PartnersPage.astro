---
import Icon from './Icon.astro';
import { partners } from '../data/partners';
import portfolio from '../data/portfolio.json';
import imports from '../data/imports-2026.json';
import { langFromPath, localePath, numLocale } from '../i18n';
const lang = langFromPath(Astro.url.pathname) as 'en' | 'fa' | 'zh' | 'tr';
const c = partners[lang] || partners.en;
const L = (p: string) => localePath(p, lang);
const num = (i: number) => (lang === 'fa' ? String(i + 1) : String(i + 1).padStart(2, '0'));
const units = (imports as { units: number }[]).reduce((a, x) => a + x.units, 0);
const fmt = (n: number) => n.toLocaleString(numLocale(lang));
const million = ({ en: 'M', fa: ' میلیون', zh: ' 百万', tr: ' Mn' } as const)[lang];
const values: Record<string, string> = {
  registered: fmt(portfolio.counts.total), available: fmt(portfolio.counts.available),
  units: lang === 'zh' ? (units / 1e8).toLocaleString('zh-CN', { maximumFractionDigits: 3 }) + ' 亿' : (units / 1e6).toLocaleString(numLocale(lang), { maximumFractionDigits: 1 }) + million, molecules: fmt(imports.length), shipments: fmt((imports as { ship?: number }[]).reduce((a, x) => a + (x.ship || 0), 0)),
};
const links = ({
  en: [['/fdf#product-portfolio', 'Registered portfolio'], ['/import-activity', 'Import activity 2026'], ['/regulatory-affairs', 'Regulatory affairs'], ['/fdf-cdmo', 'Licensed manufacturing in Iran']],
  fa: [['/fdf#product-portfolio', 'سبد محصولات ثبت‌شده'], ['/import-activity', 'گزارش فعالیت ۲۰۲۶'], ['/regulatory-affairs', 'امور رگولاتوری'], ['/fdf-cdmo', 'تولید تحت لیسانس در ایران']],
  zh: [['/fdf#product-portfolio', '已注册产品组合'], ['/import-activity', '进口动态'], ['/regulatory-affairs', '注册事务'], ['/fdf-cdmo', '在伊朗授权生产']],
  tr: [['/fdf#product-portfolio', 'Ruhsatlı portföy'], ['/import-activity', '2026 ithalat faaliyeti'], ['/regulatory-affairs', 'Ruhsatlandırma'], ['/fdf-cdmo', 'İran’da lisanslı üretim']],
} as const)[lang];
const whyIcons = ['shield', 'file', 'check', 'box', 'layers', 'globe'];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<section class="section pt-intro">
  <div class="container pt-intro-grid">
    <div><p class="pt-kicker">{c.kicker}</p><h2>{c.introTitle}</h2></div>
    <div class="pt-copy">{c.intro.map(p => <p>{p}</p>)}</div>
  </div>
</section>

<section class="section section-paper pt-stats-sec">
  <div class="container">
    <div class="section-head"><h2>{c.statsTitle}</h2></div>
    <div class="pt-stats">{c.stats.map(s => <div class="pt-stat"><strong>{values[s.key]}</strong><span>{s.label}</span></div>)}</div>
    <p class="pt-note">{c.statsNote} {links.slice(0, 2).map(([h, l], i) => <><a class="text-link" href={L(h)}>{l}</a>{i === 0 ? ' · ' : ''}</>)}</p>
  </div>
</section>

<section class="section pt-why-sec">
  <div class="container">
    <div class="section-head"><h2>{c.whyTitle}</h2></div>
    <div class="pt-why">{c.why.map((w, i) => <article class="pt-card"><span class="pt-ico"><Icon name={whyIcons[i]} size={20} /></span><h3>{w.title}</h3><p>{w.text}</p></article>)}</div>
  </div>
</section>

<section class="section pt-band">
  <div class="container">
    <div class="section-head"><h2>{c.stepsTitle}</h2><p class="lede">{c.stepsLede}</p></div>
    <ol class="pt-steps">{c.steps.map((s, i) => <li><span class="pt-num" aria-hidden="true">{num(i)}</span><h3>{s.title}</h3><p>{s.text}</p></li>)}</ol>
  </div>
</section>

<section class="section pt-two-sec">
  <div class="container pt-two">
    {[[c.askTitle, c.ask], [c.giveTitle, c.give]].map(([title, items], k) => (
      <div class:list={['pt-col', { 'pt-col-accent': k === 1 }]}>
        <h3>{title}</h3>
        <ul>{(items as string[]).map(it => <li><Icon name="check" size={17} class="pt-check" /><span>{it}</span></li>)}</ul>
      </div>
    ))}
  </div>
</section>

<section class="section section-paper pt-offices-sec">
  <div class="container">
    <div class="section-head"><h2>{c.officesTitle}</h2></div>
    <div class="pt-offices">{c.offices.map(o => <div class="pt-office"><span class="pt-ico"><Icon name="pin" size={18} /></span><div><strong>{o.city}</strong><small>{o.role}</small><p>{o.text}</p></div></div>)}</div>
    <aside class="pt-limits" role="note"><Icon name="shield" size={22} /><p>{c.limits}</p></aside>
  </div>
</section>

<section class="section pt-faq-sec">
  <div class="container pt-faq-grid">
    <h2>{c.faqTitle}</h2>
    <div class="pt-faq">{c.faq.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </div>
</section>

<section class="section pt-cta-sec">
  <div class="container pt-cta">
    <p>{c.ctaNote}</p>
    <div class="pt-cta-actions"><a class="button button-navy" href={L('/contact-us-1?type=regulatory')}>{c.cta}<Icon name="arrow" size={17} class="pt-arrow" /></a>{links.slice(2).map(([h, l]) => <a class="text-link" href={L(h)}>{l}</a>)}</div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<style>
  .pt-kicker { margin:0 0 14px; font:600 13px/1.4 var(--sans); letter-spacing:.08em; text-transform:uppercase; color:var(--lapis); }
  :global([dir=rtl]) .pt-kicker, :global(html[lang^=zh]) .pt-kicker { letter-spacing:0; text-transform:none; font-size:14px; }
  .pt-intro-grid { display:grid; grid-template-columns:minmax(0,5fr) minmax(0,7fr); gap:clamp(28px,5vw,72px); align-items:start; }
  .pt-copy p { font-size:18px; } .pt-copy p:last-child { margin-bottom:0; color:var(--muted); }
  .pt-ico { display:inline-grid; place-items:center; width:42px; height:42px; flex:none; border-radius:12px; background:var(--glacier-soft); color:var(--lapis-deep); }
  .pt-check { flex:none; margin-top:4px; color:var(--lapis); }
  .pt-stats { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; }
  .pt-stat { display:flex; flex-direction:column; gap:8px; padding:24px 22px; border-radius:18px; background:var(--white); border:1px solid var(--line); }
  .pt-stat strong { font:600 clamp(30px,3vw,40px)/1 var(--display); letter-spacing:-.02em; color:var(--lapis-deep); }
  .pt-stat span { font-size:15.5px; line-height:1.5; color:var(--ink); }
  .pt-note { margin:18px 0 0; font-size:15px; color:var(--muted); }
  .pt-why { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
  .pt-card { display:flex; flex-direction:column; gap:12px; padding:22px 22px 24px; border:1px solid var(--line); border-radius:18px; background:var(--paper); }
  .pt-card h3 { font-size:19px; } .pt-card p { margin:0; font-size:16px; line-height:1.55; color:var(--muted); }
  .pt-band { background:var(--black); color:var(--on-navy); } .pt-band h2, .pt-band h3 { color:#fff; } .pt-band .lede { color:var(--on-navy-muted); }
  .pt-steps { list-style:none; padding:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:28px 24px; }
  .pt-steps li { padding-top:18px; border-top:1px solid #ffffff2e; }
  .pt-num { display:block; margin-bottom:10px; font:600 26px/1 var(--display); color:var(--glacier); }
  .pt-steps h3 { font-size:18px; margin-bottom:8px; } .pt-steps p { margin:0; font-size:15.5px; line-height:1.55; color:var(--on-navy-muted); }
  .pt-two { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; }
  .pt-col { padding:28px; border-radius:20px; border:1px solid var(--line); background:var(--white); }
  .pt-col-accent { background:var(--paper); }
  .pt-col h3 { margin-bottom:14px; } .pt-col ul { list-style:none; padding:0; display:grid; gap:10px; } .pt-col li { display:flex; gap:10px; align-items:flex-start; line-height:1.5; }
  .pt-offices { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; }
  .pt-office { display:flex; gap:14px; padding:20px; border-radius:16px; background:var(--white); border:1px solid var(--line); }
  .pt-office strong { display:block; font-family:var(--display); font-size:18px; } .pt-office small { display:block; color:var(--lapis-deep); font-weight:600; font-size:13.5px; margin:2px 0 6px; } .pt-office p { margin:0; font-size:15px; color:var(--muted); line-height:1.5; }
  .pt-limits { display:flex; gap:14px; align-items:flex-start; margin-top:20px; padding:18px 22px; border-radius:16px; border:1px dashed #b9b3a6; }
  .pt-limits :global(svg) { flex:none; color:var(--lapis); margin-top:2px; } .pt-limits p { margin:0; font-size:15.5px; line-height:1.6; }
  .pt-faq-grid { display:grid; grid-template-columns:minmax(0,4fr) minmax(0,8fr); gap:clamp(24px,4vw,56px); align-items:start; }
  .pt-faq details { border-top:1px solid var(--line); padding:16px 0; } .pt-faq details:last-child { border-bottom:1px solid var(--line); }
  .pt-faq summary { cursor:pointer; font-weight:600; font-size:17px; list-style:none; display:flex; justify-content:space-between; gap:16px; }
  .pt-faq summary::after { content:'+'; color:var(--lapis); font-weight:500; } .pt-faq details[open] summary::after { content:'–'; }
  .pt-faq p { margin:12px 0 0; color:var(--muted); line-height:1.6; max-width:70ch; }
  .pt-cta { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:24px 48px; align-items:center; padding:30px; border-radius:22px; background:var(--paper); border:1px solid var(--line); }
  .pt-cta p { margin:0; font-size:17px; } .pt-cta-actions { display:flex; flex-wrap:wrap; gap:18px; align-items:center; }
  .pt-arrow { margin-inline-start:10px; } :global([dir=rtl]) .pt-arrow { transform:scaleX(-1); }
  :global([dir=rtl]) .pt-copy p, :global([dir=rtl]) .pt-card p, :global([dir=rtl]) .pt-steps p, :global([dir=rtl]) .pt-col li, :global([dir=rtl]) .pt-office p, :global([dir=rtl]) .pt-limits p, :global([dir=rtl]) .pt-faq p, :global([dir=rtl]) .pt-stat span { line-height:1.7; }
  @media (max-width:1100px) { .pt-stats, .pt-offices { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width:860px) { .pt-intro-grid, .pt-two, .pt-faq-grid, .pt-cta { grid-template-columns:1fr; } .pt-why, .pt-steps { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width:640px) { .pt-stats, .pt-offices, .pt-why, .pt-steps { grid-template-columns:1fr; } .pt-col, .pt-cta { padding:22px; } .pt-copy p { font-size:17px; } }
</style>
