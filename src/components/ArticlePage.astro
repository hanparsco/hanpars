---
import PageHero from './PageHero.astro';
import CTA from './CTA.astro';
import articles from '../data/articles.json';
import { langFromPath, localePath, t, dateLocale } from '../i18n';
interface Props { article: { slug:string; title:string; date:string; category:string; excerpt:string; content:string } }
const { article } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const s = t(lang).insights;
const L = (p: string) => localePath(p, lang);
const date = new Date(article.date).toLocaleDateString(dateLocale(lang),{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
const sorted = [...articles].sort((a,b)=>new Date(b.date).getTime()-new Date(a.date).getTime());
const index = sorted.findIndex(a=>a.slug===article.slug);
const next = sorted[index+1];
---
<PageHero title={article.title} category={s.articleCategory} description={s.published(date, article.category)} action={s.back} href={L('/blog-1')} titleLang="en"/>
<section class="section"><div class="container article-wrap"><div class="archive-note">{s.articleNote}</div><article class="article-body" lang="en" dir="ltr" set:html={article.content}/><div class="article-navigation"><a class="text-link" href={L('/blog-1')}>{s.all}</a>{next&&<a class="text-link" href={L(`/insights/${next.slug}`)}>{s.next} <span lang="en">{next.title}</span></a>}</div></div></section>
<CTA title={s.ctaTitle} />
