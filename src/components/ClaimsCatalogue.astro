---
import Icon from './Icon.astro';
import claims from '../data/nutrition.json';
import { langFromPath, localePath, t } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const s = t(lang).claims;
const c = t(lang).catalogue;
const L = (p: string) => localePath(p, lang);
const total = claims.length.toLocaleString('en-US');
const authorised = claims.filter(x => x.status === 'authorised').length.toLocaleString('en-US');
const substances = new Set(claims.map(x => x.substance)).size.toLocaleString('en-US');
const i18n = JSON.stringify({ inList: c.inList, matching: c.matching, none: c.none, showing: c.showingTpl });
---
<div class="catalogue-panel claims-panel" id="claims" data-catalogue data-page-size="25" data-i18n={i18n} style="scroll-margin-top:40px">
  <div class="catalogue-toolbar"><div><h2>{s.title}</h2><p class="catalogue-count"><span data-filter-count>{total}</span> {s.entries} <span data-count-suffix>{c.inList}</span> · {s.summary(substances, authorised)}</p></div><label class="search-input"><Icon name="search" size={18}/><input type="search" placeholder={s.search} aria-label={s.search} data-catalogue-search autocomplete="off"/></label></div>
  <div class="claims-filters" role="group" aria-label={s.statusLabel}><button type="button" data-catalogue-filter="" aria-pressed="true">{s.all}</button><button type="button" data-catalogue-filter="authorised" aria-pressed="false">{s.authorised}</button><button type="button" data-catalogue-filter="non-authorised" aria-pressed="false">{s.nonAuthorised}</button></div>
  <div class="catalogue-scroll" tabindex="0" role="region" aria-label={s.title}>
    <table class="catalogue-table claims-table" lang="en" dir="ltr"><thead><tr><th scope="col">{s.substance}</th><th scope="col">{s.claim}</th><th scope="col">{s.relationship}</th><th scope="col">{s.status}</th></tr></thead><tbody>{claims.map((row,index)=><tr data-catalogue-row data-status={row.status} data-search={`${row.substance} ${row.claim} ${row.relationship} ${row.status}`.toLowerCase()} data-index={index}><td class="claims-substance">{row.substance}</td><td class="claims-claim">{row.claim.split('\n').map((line,i)=><>{i>0&&<br/>}{line}</>)}</td><td class="claims-rel">{row.relationship}</td><td><span class:list={['claims-status', row.status]}>{row.status==='authorised'?s.authorised:s.nonAuthorised}</span></td></tr>)}</tbody></table>
    <div class="catalogue-empty" data-catalogue-empty hidden>{c.empty} <a class="text-link" href={L('/contact-us-1?type=sourcing')}>{c.askDirect}</a>.</div>
  </div>
  <div class="catalogue-foot"><span aria-live="polite" data-catalogue-status>{c.allAvailable(total)}</span><div class="catalogue-pager" data-catalogue-pager hidden><button type="button" data-catalogue-prev>{c.prev}</button><span data-page-label></span><button type="button" data-catalogue-next>{c.next}</button></div></div>
</div>
<p class="reference-note">{s.note} <a class="text-link" href="https://ec.europa.eu/food/food-feed-portal/screen/health-claims/eu-register" target="_blank" rel="noopener noreferrer" dir="ltr">{s.source}</a></p>
