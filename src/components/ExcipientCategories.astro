---
import cats from '../data/excipient-categories.json';
import excipients from '../data/excipients.json';
import { langFromPath, t, numLocale, htmlLang } from '../i18n';
import { catalogueName } from '../data/locale';
const lang = langFromPath(Astro.url.pathname);
const topLoc = lang === 'zh' || lang === 'tr';
const s = t(lang).excipientCats;
const counts: Record<string, number> = {};
for (const e of excipients as { group?: string }[]) counts[e.group || 'other'] = (counts[e.group || 'other'] || 0) + 1;
const fmt = (n: number) => n.toLocaleString(numLocale(lang));
---
<section class="section section-paper" id="categories"><div class="container">
  <div class="section-head"><h2>{s.title}</h2><p class="lede">{s.lede}</p></div>
  <ol class="exc-index">{cats.map((c, i) => <li class="exc-tile"><a href="#excipient-list" data-exc-filter={c.id}><span class="exc-num">{(lang === 'fa' ? String(i + 1) : String(i + 1).padStart(2, '0'))}</span><span class="exc-tile-body"><span class="exc-tile-head"><strong>{(c as any)[lang] || c.en}</strong><small>{s.inList(fmt(counts[c.id] || 0))}</small></span><span class="exc-top" lang={topLoc ? htmlLang[lang] : "en"} dir="auto">{c.top.map((n: string) => (topLoc && catalogueName(lang, 'exc', n)) || n).join(lang === 'zh' ? '、' : ' · ')}</span></span></a></li>)}</ol>
</div></section>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-exc-filter]').forEach(a => a.addEventListener('click', () => {
    const list = document.getElementById('excipient-list') as (HTMLElement & { setFilter?: (v: string) => void }) | null;
    if (list?.setFilter) list.setFilter(a.dataset.excFilter || '');
  }));
</script>
