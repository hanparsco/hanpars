---
import cats from '../data/excipient-categories.json';
import excipients from '../data/excipients.json';
import { langFromPath, t } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const s = t(lang).excipientCats;
const counts: Record<string, number> = {};
for (const e of excipients as { group?: string }[]) counts[e.group || 'other'] = (counts[e.group || 'other'] || 0) + 1;
const fmt = (n: number) => n.toLocaleString(lang === 'fa' ? 'fa-IR' : 'en-US');
---
<section class="section section-paper" id="categories"><div class="container">
  <div class="section-head"><h2>{s.title}</h2><p class="lede">{s.lede}</p></div>
  <ol class="exc-index">{cats.map((c, i) => <li class="exc-tile"><a href="#excipient-list" data-exc-filter={c.id}><span class="exc-num">{String(i + 1).padStart(2, '0')}</span><span class="exc-tile-body"><span class="exc-tile-head"><strong>{lang === 'fa' ? c.fa : c.en}</strong><small>{s.inList(fmt(counts[c.id] || 0))}</small></span><span class="exc-top" lang="en" dir="ltr">{c.top.join(' · ')}</span></span></a></li>)}</ol>
</div></section>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-exc-filter]').forEach(a => a.addEventListener('click', () => {
    const btn = document.querySelector<HTMLButtonElement>(`[data-catalogue] [data-catalogue-filter="${a.dataset.excFilter}"]`);
    if (btn) btn.click();
  }));
</script>
