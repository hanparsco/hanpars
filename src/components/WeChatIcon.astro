---
/** WeChat mark drawn as two speech bubbles; `uid` keeps the mask id unique when the icon appears several times on a page. */
interface Props { size?: number; uid?: string; class?: string }
const { size = 16, uid = 'a', class: className = '' } = Astro.props;
const m = `wxm-${uid}`;
---
<svg viewBox="0 0 24 24" width={size} height={size} class={className} fill="currentColor" aria-hidden="true"><defs><mask id={m}><rect width="24" height="24" fill="#fff"/><ellipse cx="16.3" cy="14.9" rx="6.9" ry="5.7" fill="#000"/></mask></defs><path d="M1.80 8.60a7.40 5.90 0 1 0 14.80 0a7.40 5.90 0 1 0 -14.80 0ZM4.9 12.4L3.6 16.3L7.9 13.8ZM5.70 7.50a1.00 1.00 0 1 1 2.00 0a1.00 1.00 0 1 1 -2.00 0ZM10.60 7.50a1.00 1.00 0 1 1 2.00 0a1.00 1.00 0 1 1 -2.00 0Z" mask={`url(#${m})`}/><path d="M10.30 14.90a6.00 4.90 0 1 0 12.00 0a6.00 4.90 0 1 0 -12.00 0ZM19.4 18.6L21.0 21.2L17.2 19.5ZM13.45 14.00a0.85 0.85 0 1 1 1.70 0a0.85 0.85 0 1 1 -1.70 0ZM17.45 14.00a0.85 0.85 0 1 1 1.70 0a0.85 0.85 0 1 1 -1.70 0Z"/></svg>
