---
import { langFromPath, t, dateLocale } from '../i18n';
interface Props { item: { title:string; url:string; source:string; date:string; summary:string; image:string; kind?:string }; dark?: boolean; eager?: boolean; fa?: boolean; }
const { item, dark = false, eager = false, fa = false } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const tl = fa ? { lang: 'fa', dir: 'rtl' } : lang === 'zh' && /[\u4e00-\u9fff]/.test(item.title) ? { lang: 'zh-Hans', dir: 'ltr' } : { lang: 'en', dir: 'ltr' };
const s = t(lang).news;
const pressLabel = ({ en: 'Press release', fa: 'بیانیهٔ شرکت', zh: '企业公告', tr: 'Basın bülteni' } as Record<string, string>)[lang];
const date = item.date ? new Date(item.date + 'T00:00:00Z').toLocaleDateString(dateLocale(lang), { day:'numeric', month:'long', year:'numeric', timeZone:'UTC' }) : '';
const host = (() => { try { return new URL(item.url).hostname.replace(/^www\./,''); } catch { return ''; } })();
---
<article class:list={['news-card', { 'news-card-dark': dark }]}>
  <a href={item.url} target="_blank" rel="noopener noreferrer" class="news-figure" tabindex="-1" aria-hidden="true">{item.image ? <img src={item.image} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" width="1200" height="750"/> : <span class="news-placeholder"/>}</a>
  <div class="news-body">
    <p class="news-meta"><span class="news-source" {...tl}>{item.source}</span>{item.kind === 'press' && <span class="news-kind">{pressLabel}</span>}<time datetime={item.date}>{date}</time></p>
    <h3 {...tl}><a href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a></h3>
    {item.summary && <p class="news-summary" {...tl}>{item.summary}</p>}
    <a class="text-link news-link" href={item.url} target="_blank" rel="noopener noreferrer">{s.readAt} <bdi lang="en" dir="ltr">{host}</bdi></a>
  </div>
</article>
