---
import PageHero from './PageHero.astro';
import CTA from './CTA.astro';
import data from '../data/regulatory.json';
---
<PageHero title="Regulatory affairs" category="Services" description={data.intro} action="Request an assessment" href="/contact-us-1?type=regulatory" dark>
  <div class="scope-strip">{data.facts.map(fact=><div class="scope-item"><small>{fact.label}</small><strong>{fact.value}</strong></div>)}</div>
</PageHero>
<section class="section"><div class="container content-split"><h2>{data.whyTitle}</h2><div class="content-copy">{data.why.map(p=><p>{p}</p>)}</div></div></section>
<section class="section section-paper" id="services"><div class="container"><div class="section-head"><h2>What we cover</h2><p class="lede">Engage us for a single module or for the whole registration programme.</p></div><div class="detail-grid">{data.services.map(service=><article class="detail-item"><h3>{service.title}</h3><p>{service.description}</p></article>)}</div></div></section>
<section class="section"><div class="container"><div class="section-head"><h2>{data.processTitle}</h2></div><ol class="steps steps-4">{data.process.map(stage=><li class="step"><h3>{stage.title}</h3><p>{stage.description}</p></li>)}</ol></div></section>
<section class="section section-paper"><div class="container content-split"><div><h2>Where we file</h2><p class="lede" style="margin-top:20px">{data.marketIntro}</p><ul class="market-list">{data.markets.map(market=><li>{market}</li>)}</ul></div><aside class="audience-panel"><h2>Who we work with</h2>{data.audiences.map(html=><p set:html={html}/>)}</aside></div></section>
<section class="section"><div class="container faq-layout"><h2>Common questions</h2><div class="faq-list">{data.faq.map(faq=><details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></div></section>
<CTA title={data.ctaTitle} description={data.ctaText}/>
