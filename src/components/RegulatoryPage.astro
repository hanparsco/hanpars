---
import Icon from './Icon.astro';
import data from '../data/regulatory.json';
const icons = ['file','shield','molecule','box','clock','search'];
---
<section class="page-hero page-hero-dark"><div class="container"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Services</span><span>/</span><span>Regulatory Affairs</span></div><div class="page-hero-inner"><div><span class="eyebrow">DOSSIER. REGISTRATION. LIFECYCLE.</span><h1>Regulatory Affairs</h1><p>{data.intro}</p></div><a class="button button-sky" href="/contact-us-1?type=regulatory">Request an assessment<Icon name="diagonal" size={18}/></a></div><div class="scope-strip">{data.facts.map(fact=><div class="scope-item"><small>{fact.label.toUpperCase()}</small><strong>{fact.value}</strong></div>)}</div></div></section>
<section class="section"><div class="container content-split"><div><span class="eyebrow">WHY REGULATORY AT HANPARS</span><h2>{data.whyTitle}</h2></div><div class="content-copy">{data.why.map(p=><p>{p}</p>)}</div></div></section>
<section class="section section-pale" id="services"><div class="container"><div class="section-head"><div><span class="eyebrow">CONNECTED REGULATORY SUPPORT</span><h2>What we cover</h2></div><p>Engage us for a single module or the full registration programme.</p></div><div class="detail-grid">{data.services.map((service,i)=><article class="detail-card"><span class="icon-tile"><Icon name={icons[i]} size={25}/></span><h3>{service.title}</h3><p>{service.description}</p></article>)}</div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">HOW WE WORK</span><h2>{data.processTitle}</h2></div></div><div class="process-four">{data.process.map((stage,i)=><article class="step"><span class="step-num">0{i+1}</span><h3>{stage.title}</h3><p>{stage.description}</p></article>)}</div></div></section>
<section class="section section-pale"><div class="container content-split"><div><span class="eyebrow">MARKETS</span><h2>Where we file</h2><p style="color:var(--muted);margin-top:20px">{data.marketIntro}</p><ul class="market-list">{data.markets.map(market=><li>{market}</li>)}</ul></div><aside class="audience-panel"><h2>Who we work with</h2>{data.audiences.map(html=><p set:html={html}/>)}</aside></div></section>
<section class="section"><div class="container faq-layout"><div><span class="eyebrow">A LITTLE MORE CLARITY</span><h2>Common questions</h2></div><div class="faq-list">{data.faq.map(faq=><details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></div></section>
<section class="cta-section"><div class="container cta-box"><div><span class="eyebrow">YOUR PRODUCT. YOUR MARKET.</span><h2>{data.ctaTitle}</h2><p>{data.ctaText}</p></div><div class="cta-actions"><a class="button button-sky" href="/contact-us-1?type=regulatory">Contact the regulatory team<Icon name="diagonal" size={17}/></a><a class="button button-ghost" href="/contact-us-1?type=sourcing">Discuss a sourcing enquiry<Icon name="diagonal" size={17}/></a></div></div></section>
