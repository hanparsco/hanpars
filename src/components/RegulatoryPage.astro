---
import PageHero from './PageHero.astro';
import CTA from './CTA.astro';
import data from '../data/regulatory.json';
const authorities = data.tiers.flatMap(tier => tier.authorities.map(a => ({ ...a, tierName: tier.name, tierNum: tier.num })));
---
<PageHero title="Regulatory affairs" category="Services" description={data.intro} action="Request an assessment" href="/contact-us-1?type=regulatory" photo="lab-instrument" photoAlt="Analyst operating a laboratory instrument in a quality-control lab"/>

<section class="section section-paper" id="services"><div class="container">
  <div class="section-head"><h2>What we cover</h2><p class="lede">{data.coverIntro}</p></div>
  <div class="ra-services">{data.services.map(group => <article class="ra-group"><div><h3>{group.title}</h3>{group.kicker && <p class="ra-kicker">{group.kicker}</p>}</div><ul class="ra-list">{group.items.map(item => <li>{item}</li>)}</ul></article>)}</div>
</div></section>

<section class="section section-navy" id="markets" data-ra-authorities><div class="container">
  <div class="section-head"><h2>Where we file</h2><p class="lede">{data.fileIntro}</p></div>
  <div class="ra-tiers">{data.tiers.map(tier => <div class="ra-tier"><div class="ra-tier-head"><span class="ra-tier-num">{tier.num}</span><div><h3>{tier.name}</h3><p>{tier.sub}</p></div></div><div class="ra-chips" role="group" aria-label={`Authorities: ${tier.name}`}>{tier.authorities.map(a => <button type="button" data-authority={a.id} aria-pressed={a.id === 'ema' ? 'true' : 'false'}>{a.short}</button>)}</div></div>)}</div>
  <div class="ra-detail" aria-live="polite">{authorities.map(a => <article class="ra-authority" data-authority-panel={a.id} hidden={a.id !== 'ema'}><p class="ra-authority-tier">{a.tierName}</p><h3>{a.name}</h3><p class="ra-authority-meta"><span>{a.region}</span><span>Dossier format: {a.format}</span></p><h4>Submission routes we handle</h4><dl class="ra-routes">{a.procedures.map(p => <div><dt>{p.name}</dt><dd>{p.note}</dd></div>)}</dl>{a.footnote && <p class="ra-footnote">{a.footnote}</p>}</article>)}</div>
</div></section>

<section class="section section-paper" id="intelligence"><div class="container">
  <div class="section-head"><h2>Regulatory intelligence and AI in regulatory</h2><p class="lede">{data.intelligence.intro}</p></div>
  <div class="ra-services">{data.intelligence.groups.map(group => <article class="ra-group"><div><h3>{group.title}</h3></div><ul class="ra-list">{group.items.map(item => <li>{item}</li>)}</ul></article>)}</div>
  <aside class="ra-principle"><p class="kicker">Our principle on AI</p><h3>{data.intelligence.principleTitle}</h3><p>{data.intelligence.principle}</p></aside>
</div></section>

<section class="section" id="watch"><div class="container">
  <div class="section-head"><h2>What changed in the agencies</h2><p class="lede">Regulatory watch, as of {data.watchDate}. Items are summarised from the agencies' own publications; follow the source for the full text.</p></div>
  <ul class="insight-list">{data.watch.map(item => <li><a class="insight-row ra-watch-row" href={item.url} target="_blank" rel="noopener noreferrer"><time>{item.date}</time><div><p class="ra-watch-agency">{item.agency} · {item.tag}</p><h3>{item.title}</h3><p>{item.summary}</p></div><span class="cat">Source</span></a></li>)}</ul>
</div></section>

<CTA title={data.ctaTitle} description={data.ctaText}/>

<script>
  const root = document.querySelector('[data-ra-authorities]');
  if (root) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-authority]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-authority-panel]'));
    const detail = root.querySelector<HTMLElement>('.ra-detail');
    buttons.forEach(button => button.addEventListener('click', () => {
      const id = button.dataset.authority;
      buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
      panels.forEach(p => { p.hidden = p.dataset.authorityPanel !== id; });
      if (detail && window.innerWidth < 860) detail.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion:reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    }));
  }
</script>

<style>
  .ra-services { display:grid; gap:0; border-top:1px solid var(--line); }
  .ra-group { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.6fr); gap:48px; padding:36px 0; border-bottom:1px solid var(--line); }
  .ra-group h3 { font-size:21px; }
  .ra-kicker { margin:10px 0 0; font-size:13.5px; color:var(--muted); }
  .ra-list { list-style:none; padding:0; margin:0; }
  .ra-list li { position:relative; padding:9px 0 9px 22px; color:var(--ink); font-size:16.5px; line-height:1.6; }
  .ra-list li:before { content:''; position:absolute; left:0; top:17px; width:8px; height:1px; background:var(--lapis); }
  .ra-tiers { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:40px 56px; margin-bottom:48px; }
  .ra-tier-head { display:flex; gap:18px; align-items:flex-start; padding-top:18px; border-top:1px solid var(--line-dark); margin-bottom:18px; }
  .ra-tier-num { font-family:var(--display); font-weight:600; font-size:13px; letter-spacing:.12em; color:var(--glacier); padding-top:5px; }
  .ra-tier-head h3 { font-size:19px; color:#fff; margin-bottom:4px; }
  .ra-tier-head p { margin:0; color:var(--on-navy-muted); font-size:14.5px; }
  .ra-chips { display:flex; flex-wrap:wrap; gap:8px; }
  .ra-chips button { background:transparent; border:1px solid #ffffff33; border-radius:999px; color:var(--on-navy); font-family:var(--display); font-weight:500; font-size:13.5px; padding:8px 14px; min-height:40px; transition:border-color .2s,background .2s,color .2s; }
  .ra-chips button:hover { border-color:var(--glacier); color:#fff; }
  .ra-chips button[aria-pressed=true] { background:var(--glacier); border-color:var(--glacier); color:var(--black); }
  .ra-detail { border-top:1px solid var(--line-dark); padding-top:40px; scroll-margin-top:110px; }
  .ra-authority-tier { font-family:var(--display); font-weight:600; font-size:12px; letter-spacing:.12em; text-transform:uppercase; color:var(--glacier); margin-bottom:12px; }
  .ra-authority h3 { color:#fff; font-size:28px; margin-bottom:10px; }
  .ra-authority-meta { display:flex; flex-wrap:wrap; gap:8px 28px; color:var(--on-navy-muted); font-size:15px; margin-bottom:32px; }
  .ra-authority h4 { color:#fff; font-size:15px; font-weight:600; margin-bottom:8px; }
  .ra-routes { margin:0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 48px; }
  .ra-routes>div { padding:16px 0; border-top:1px solid var(--line-dark); }
  .ra-routes dt { font-family:var(--display); font-weight:600; font-size:15.5px; color:#fff; margin-bottom:6px; }
  .ra-routes dd { margin:0; color:var(--on-navy); font-size:15px; line-height:1.6; }
  .ra-footnote { margin:24px 0 0; color:var(--on-navy-muted); font-size:14px; }
  .ra-principle { margin-top:56px; padding:36px 0 0; border-top:2px solid var(--glacier); max-width:46em; }
  .ra-principle h3 { font-size:26px; margin-bottom:14px; }
  .ra-principle p:last-child { font-size:18px; color:var(--ink); margin:0; }
  .ra-watch-agency { font-family:var(--display); font-weight:600; font-size:12.5px; letter-spacing:.06em; text-transform:uppercase; color:var(--lapis-deep); margin:0 0 6px!important; }
  @media(max-width:860px) { .ra-group { grid-template-columns:1fr; gap:14px; padding:28px 0; } .ra-tiers { grid-template-columns:1fr; gap:28px; } .ra-routes { grid-template-columns:1fr; } .ra-authority h3 { font-size:24px; } }
</style>
