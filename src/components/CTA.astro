  <div class="invite-details">
    <div><strong>Telephone</strong><a href="tel:+982188856347">+98 21 8885 6347</a> · office hours 09:00–17:00, Tehran</div>
    <div><strong>Office</strong>Haniya Parsan Darou, 3rd floor, No. 326, Zafar Street, Africa Boulevard, Tehran 1968734974, Iran</div>
    <div><strong>Email</strong><a href="mailto:contact@hanpars.com">contact@hanpars.com</a></div>
  </div>
</div></section>
