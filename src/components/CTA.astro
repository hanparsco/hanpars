---
import { langFromPath, localePath, t } from '../i18n';
interface Props { title?: string; description?: string; email?: string; regulatoryOnly?: boolean; }  // email kept for callers; contact details live in the footer
const lang = langFromPath(Astro.url.pathname);
const s = t(lang);
const L = (p: string) => localePath(p, lang);
const { title = s.cta.title, description = s.cta.text, regulatoryOnly = false } = Astro.props;
---
<section class="invite"><div class="container invite-inner">
  <div><h2>{title}</h2><p class="lede">{description}</p><div class="actions">{regulatoryOnly
    ? <a class="button button-navy" href={L('/contact-us-1?type=regulatory')}>{s.cta.secondary}</a>
    : <><a class="button button-navy" href={L('/contact-us-1?type=sourcing')}>{s.cta.primary}</a><a class="text-link" href={L('/contact-us-1?type=regulatory')}>{s.cta.secondary}</a></>}</div></div>
</div></section>
