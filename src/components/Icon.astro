---
interface Props { name?: string; size?: number; class?: string; style?: string; }
const { name = 'arrow', size = 22, class: className = '', style = '' } = Astro.props;
const paths: Record<string, string[]> = {
  arrow: ['M5 12h14', 'm12 5 7 7-7 7'],
  diagonal: ['M7 17 17 7', 'M7 7h10v10'],
  down: ['m6 9 6 6 6-6'],
  search: ['M21 21l-4.35-4.35'],
  menu: ['M4 6h16', 'M4 12h16', 'M4 18h16'],
  close: ['M6 6l12 12', 'M18 6 6 18'],
  molecule: ['M8 6l8 1', 'm6 8 4 7', 'm18 9 1 7', 'm10 19 7-2'],
  capsule: ['m8.5 8.5 7 7', 'M4.5 19.5a5 5 0 0 1 0-7l8-8a5 5 0 0 1 7 7l-8 8a5 5 0 0 1-7 0Z'],
  layers: ['m12 3 9 5-9 5-9-5z', 'm3 12 9 5 9-5', 'm3 16 9 5 9-5'],
  leaf: ['M20 4c-12-3-18 3-14 12 9 4 15-2 14-12Z', 'M5 20 16 9'],
  file: ['M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z', 'M14 2v6h6', 'M8 13h8', 'M8 17h5'],
  shield: ['M12 3 3 7v5c0 5 9 9 9 9s9-4 9-9V7Z', 'm8 12 3 3 5-6'],
  globe: ['M2 12h20', 'M12 2c5 5 5 15 0 20-5-5-5-15 0-20'],
  box: ['m21 8-9 5-9-5', 'M12 13v9', 'm3 8 9-5 9 5v9l-9 5-9-5Z', 'm7.5 5.5 9 5'],
  check: ['m5 12 4 4L19 6'],
  mail: ['M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z', 'm2 6 10 7L22 6'],
  phone: ['M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z'],
  pin: ['M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z'],
  copy: ['M9 9h11v11H9Z', 'M5 15H3V3h12v2'],
  download: ['M12 3v12', 'm7 10 5 5 5-5', 'M5 17v4h14v-4'],
  clock: ['M12 6v6l4 2'],
};
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} style={style} aria-hidden="true">
  {paths[name]?.map((d) => <path d={d} />)}
  {name === 'search' && <circle cx="10.8" cy="10.8" r="7.8" />}
  {(name === 'globe' || name === 'clock') && <circle cx="12" cy="12" r="10" />}
  {name === 'pin' && <circle cx="12" cy="10" r="3" />}
  {name === 'molecule' && <><circle cx="5" cy="5" r="3"/><circle cx="19" cy="7" r="3"/><circle cx="8" cy="20" r="3"/><circle cx="20" cy="18" r="3"/></>}
</svg>
