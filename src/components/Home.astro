---
import CTA from './CTA.astro';
import Photo from './Photo.astro';
import NewsCard from './NewsCard.astro';
import FaqFa from './FaqFa.astro';
import Icon from './Icon.astro';
import news from '../data/news.json';
import newsFa from '../data/news-fa.json';
import newsZh from '../data/news-zh.json';
import portfolio from '../data/portfolio.json';
import { portfolioL } from '../data/locale';
import fdf from '../data/fdf.json';
import apis from '../data/apis.json';
import { langFromPath, localePath, t, numLocale } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const s = t(lang);
const L = (p: string) => localePath(p, lang);
const partnerBand = ({
  en: { title: 'Are you a pharmaceutical manufacturer looking at Iran?', text: 'Hanpars is an IFDA-licensed importer and registration holder with in-house regulatory affairs, nationwide distribution and offices in Istanbul, Hangzhou and Zhenjiang.', cta: 'For foreign manufacturers' },
  zh: { title: '面向中国药企的伊朗市场服务', text: '汉帕斯是 IFDA 持牌进口商和注册持有人，设有自有注册团队和全国分销网络，并在杭州、镇江设有办事处。', cta: '面向中国药企' },
  tr: { title: 'İran pazarını değerlendiren bir Türk ilaç üreticisi misiniz?', text: 'Hanpars, IFDA lisanslı ithalatçı ve ruhsat sahibidir; şirket içi ruhsatlandırma ekibi, ülke çapında dağıtım ve İstanbul’da ortak ofis.', cta: 'Türk üreticiler için' },
} as Record<string, { title: string; text: string; cta: string }>)[lang];
const todayNews = lang === 'fa' ? (newsFa.items || []).slice(0,3) : lang === 'zh' ? (newsZh.items || []).slice(0,3) : [...(news.global || []).slice(0,2), ...(news.china || []).slice(0,1)];
const fmt = (n:number) => n.toLocaleString(numLocale(lang));
const pl = lang === 'en' ? null : portfolioL[lang];
const groupTitle = (id:string, title:string) => pl ? ((pl.groups as any)[id]?.title ?? title) : title;
const tsv = (d: string) => `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const trioIcons = [
  tsv('<path d="M3 16h18l-2 4H5z"/><path d="M6 16V9h6v7M12 12h5l2 4"/><path d="M8 6h2v3H8z"/>'),
  tsv('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13l2 2 4-4"/>'),
  tsv('<path d="M3 21V10l5 3V10l5 3V6l8 4v11z"/><path d="M7 17h2M12 17h2M17 17h1"/>'),
];
const entries = [
  { href:'/fdf', name:s.home.entries.fdf, text:s.home.entries.fdfText(portfolio.counts.total, fmt(fdf.length)) },
  { href:'/api', name:s.home.entries.api, text:s.home.entries.apiText(fmt(apis.length)) },
  { href:'/excipient', name:s.home.entries.exc, text:s.home.entries.excText },
  { href:'/nutrition', name:s.home.entries.nut, text:s.home.entries.nutText },
  { href:'/precursors', name:s.home.entries.pre, text:s.home.entries.preText },
  { href:'/supplies', name:s.home.entries.sup, text:s.home.entries.supText },
];
const hqBadge = ({ en: 'Head office · Tehran', fa: 'دفتر مرکزی · تهران', zh: '总部 · 德黑兰', tr: 'Genel merkez · Tahran' } as Record<string, string>)[lang];
const areaIcons: Record<string, string> = {"area-1": "<path d=\"M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3\"/><circle cx=\"12\" cy=\"12\" r=\"3.5\"/><path d=\"M12 6.5v1.5M12 16v1.5M6.5 12H8M16 12h1.5\"/>", "area-2": "<path d=\"m8 3 4.3 2.5v5L8 13l-4.3-2.5v-5z\"/><path d=\"m16 11 4.3 2.5v5L16 21l-4.3-2.5v-5z\"/><path d=\"M12.3 10.5 11.7 13.5\"/>", "area-3": "<path d=\"M12 5a3 3 0 0 0-5.6-1.5A3 3 0 0 0 4 8a3 3 0 0 0 .5 5.5A3.5 3.5 0 0 0 8 19a3 3 0 0 0 4 1\"/><path d=\"M12 5a3 3 0 0 1 5.6-1.5A3 3 0 0 1 20 8a3 3 0 0 1-.5 5.5A3.5 3.5 0 0 1 16 19a3 3 0 0 1-4 1\"/><path d=\"M12 5v15\"/>", "area-4": "<path d=\"M19.5 12.6 12 20l-7.5-7.4A4.8 4.8 0 0 1 12 6.1a4.8 4.8 0 0 1 7.5 6.5z\"/><path d=\"M3.5 12h4l1.5-2.5 2 5 1.5-2.5h8\"/>", "area-5": "<circle cx=\"12\" cy=\"12\" r=\"5\"/><path d=\"M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.9 2.9M15.5 15.5l2.9 2.9M5.6 18.4l2.9-2.9M15.5 8.5l2.9-2.9\"/><circle cx=\"10.5\" cy=\"11\" r=\".8\"/><circle cx=\"13.5\" cy=\"13\" r=\".8\"/>", "area-6": "<path d=\"M9 3h6v6h6v6h-6v6H9v-6H3V9h6z\"/>", "area-7": "<path d=\"M12 3 4 6.5V12c0 4.5 8 9 8 9s8-4.5 8-9V6.5z\"/><path d=\"M12 9v6M9 12h6\"/>", "area-8": "<path d=\"M9 3v4.5c0 1.5-1 2.5-2.5 3S4 12.5 4 14.5C4 18 7 21 11 21h1c4.4 0 8-3 8-7.5 0-3-2-5.5-5-5.5-1.7 0-3 1-3 2.5\"/><path d=\"M9 3h3\"/>", "area-9": "<path d=\"M8.2 15.8 15.8 8.2\"/><path d=\"M15.8 8.2a2.5 2.5 0 1 1 3.5-3.5 2.5 2.5 0 1 1-3.5 3.5zM8.2 15.8a2.5 2.5 0 1 1-3.5 3.5 2.5 2.5 0 1 1 3.5-3.5z\"/>"};
---
<section class="hero hero-split">
  <div class="container hero-grid">
    <div class="hero-main">
      <h1>{s.home.title.split('\n').map((line,i)=><>{i>0&&<br/>}{line}</>)}</h1>
      <p class="lede">{s.home.lede}</p>
      {lang !== 'fa' && <div class="hero-actions"><a class="button button-light" href={L('/contact-us-1?type=sourcing')}>{s.home.primary}</a></div>}
    </div>
    <Photo name="hero-products" class="hero-photo hero-photo-tall" alt={s.home.heroAlt} priority />
  </div>
  <div class="hero-meta"><div class="container hero-meta-inner">{entries.map(entry => <a href={L(entry.href)}><strong>{entry.name}</strong><span>{entry.text}</span></a>)}</div></div>
</section>

<section class="section section-paper trio-section">
  <div class="container">
    <div class="trio-head"><h2>{s.home.threeTitle}</h2>{lang !== 'fa' && <p class="lede">{s.home.threeLede}</p>}</div>
    <div class="trio">{s.home.three.map((item, i) => <article class="trio-card">
      <div class="trio-top"><span class="trio-icon" aria-hidden="true" set:html={trioIcons[i]}/><span class="trio-num" aria-hidden="true">{(lang === 'fa' ? String(i + 1) : String(i + 1).padStart(2, '0'))}</span></div>
      <h3>{item.title}</h3>
      <p>{item.text}</p>
      <div class="trio-links"><a class="trio-link" href={L(item.href)}><span>{item.link}</span><span class="trio-arrow" aria-hidden="true">{lang === 'fa' ? '←' : '→'}</span></a>{(item as any).link2 && <a class="trio-link" href={L((item as any).href2)}><span>{(item as any).link2}</span><span class="trio-arrow" aria-hidden="true">{lang === 'fa' ? '←' : '→'}</span></a>}</div>
    </article>)}</div>
    {lang === 'fa' && <p class="lede trio-after">{s.home.threeLede}</p>}
    {partnerBand && <a class="partner-band" href={L('/partners')}><span class="partner-band-ico"><Icon name="shield" size={22}/></span><span class="partner-band-text"><strong>{partnerBand.title}</strong><span>{partnerBand.text}</span></span><span class="partner-band-cta">{partnerBand.cta}<Icon name="arrow" size={17} class="partner-band-arrow"/></span></a>}
  </div>
</section>

<section class="section section-navy">
  <div class="container spotlight sp2">
    <div class="sp2-main">
      <h2>{s.home.portfolioTitle}</h2>
      <dl class="sp2-stats">
        {[[portfolio.counts.total, s.home.figRegistered, true], [portfolio.counts.available, s.home.figAvailable, false], [portfolio.counts.launching, s.home.figLaunching, false]].map(([n, label, lead]) => <div class:list={['sp2-stat', { 'sp2-stat-lead': lead }]}><dt>{label}</dt><dd><span class="num">{fmt(n as number)}</span>{lang === 'fa' && <small> قلم</small>}</dd></div>)}
      </dl>
      <p class="sp2-text">{s.home.portfolioText}</p>
      <div class="actions"><a class="button button-light" href={L('/fdf#product-portfolio')}>{s.home.portfolioPrimary}</a>{lang !== 'fa' && <a class="text-link" href={L('/contact-us-1?type=regulatory')}>{s.home.portfolioSecondary}</a>}</div>
    </div>
    <ul class="sp2-areas">{portfolio.groups.map(group => <li><a href={L(`/fdf#portfolio-${group.id}`)} style={`--w:${Math.max(8, Math.round(100 * group.products.length / Math.max(...portfolio.groups.map(g => g.products.length))))}%`}><span class="area-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={areaIcons[group.id] || ''}/></span><span class="sp2-name">{groupTitle(group.id, group.title)}</span><span class="sp2-count num">{fmt(group.products.length)}</span><span class="sp2-bar" aria-hidden="true"></span></a></li>)}</ul>
  </div>
</section>

<section class="section section-paper">
  <div class="container company-note">
    <figure class="cn-media">
      <Photo name="tehran-alborz" class="company-photo" alt={s.home.tehranAlt} />
      <figcaption class="cn-badge"><Icon name="pin" size={15}/>{hqBadge}</figcaption>
    </figure>
    <div class="copy cn-copy">
      <span class="persian-name cn-name" lang={lang === 'zh' ? 'zh-Hans' : 'fa'}>{lang === 'zh' ? '汉尼亚帕尔桑药业有限公司' : 'شرکت هانیا پرسان دارو'}</span>
      {lang !== 'fa' && <h2>{s.home.companyTitle}</h2>}
      <p>{s.home.companyText}</p>
      <ul class="cn-facts">
        {lang !== 'fa' && <li><span class="cn-ico"><Icon name="pin" size={17}/></span><span>{s.home.companyAddress.split(' · ').slice(-1)[0]}</span></li>}
        {lang !== 'fa' && <li><span class="cn-ico"><Icon name="clock" size={17}/></span><span>{s.home.companyHours}</span></li>}
        {lang !== 'fa' && <li><span class="cn-ico"><Icon name="phone" size={17}/></span><a href="tel:+982188883325" dir="ltr" data-fa-digits>+98 21 8888 3325</a></li>}
      </ul>
      <a class="button button-navy cn-more" href={L('/about-us')}>{s.home.about}<Icon name="arrow" size={17} class="cn-arrow"/></a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head steps2-head"><h2>{s.home.stepsTitle}</h2>{s.home.stepsLede && <p class="lede">{s.home.stepsLede}</p>}</div>
    <ol class="steps2">{s.home.steps.map((step, i) => <li class="step2"><span class="step2-ico" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={['<path d="M4 4h16v12H8l-4 4z"/><path d="M8 9h8M8 12h5"/>', '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2M8.5 11l1.8 1.8 3.2-3.6"/>', '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 14l2 2 4-4"/>'][i % 3]}/></span><span class="step2-num" aria-hidden="true">{lang === 'fa' ? '۰۱۲۳۴۵۶۷۸۹'[i + 1] : String(i + 1).padStart(2, '0')}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol>
  </div>
</section>

<section class="section section-paper section-tight">
  <div class="container">
    <div class="section-head"><h2>{s.home.newsTitle}</h2><a class="text-link" href={L('/news')}>{s.home.newsAll}</a></div>
    {todayNews.length > 0 && <div class="news-grid">{todayNews.map((item, i) => <NewsCard item={item} eager={false} fa={lang === 'fa'}/>)}</div>}
  </div>
</section>
<FaqFa />
{lang !== 'fa' && <CTA />}
