---
import CTA from './CTA.astro';
import Photo from './Photo.astro';
import NewsCard from './NewsCard.astro';
import FaqFa from './FaqFa.astro';
import Icon from './Icon.astro';
import news from '../data/news.json';
import portfolio from '../data/portfolio.json';
import { portfolioL } from '../data/locale';
import fdf from '../data/fdf.json';
import apis from '../data/apis.json';
import { langFromPath, localePath, t, numLocale } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const s = t(lang);
const L = (p: string) => localePath(p, lang);
const todayNews = [...(news.global || []).slice(0,2), ...(news.china || []).slice(0,1)];
const fmt = (n:number) => n.toLocaleString(numLocale(lang));
const pl = lang === 'en' ? null : portfolioL[lang];
const groupTitle = (id:string, title:string) => pl ? ((pl.groups as any)[id]?.title ?? title) : title;
const tsv = (d: string) => `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const trioIcons = [
  tsv('<path d="M3 16h18l-2 4H5z"/><path d="M6 16V9h6v7M12 12h5l2 4"/><path d="M8 6h2v3H8z"/>'),
  tsv('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13l2 2 4-4"/>'),
  tsv('<path d="M3 21V10l5 3V10l5 3V6l8 4v11z"/><path d="M7 17h2M12 17h2M17 17h1"/>'),
];
const entries = [
  { href:'/fdf', name:s.home.entries.fdf, text:s.home.entries.fdfText(portfolio.counts.total, fmt(fdf.length)) },
  { href:'/api', name:s.home.entries.api, text:s.home.entries.apiText(fmt(apis.length)) },
  { href:'/excipient', name:s.home.entries.exc, text:s.home.entries.excText },
  { href:'/nutrition', name:s.home.entries.nut, text:s.home.entries.nutText },
];
const hqBadge = ({ en: 'Head office · Tehran', fa: 'دفتر مرکزی · تهران', zh: '总部 · 德黑兰', tr: 'Genel merkez · Tahran' } as Record<string, string>)[lang];
---
<section class="hero hero-split">
  <div class="container hero-grid">
    <div class="hero-main">
      <h1>{s.home.title.split('\n').map((line,i)=><>{i>0&&<br/>}{line}</>)}</h1>
      <p class="lede">{s.home.lede}</p>
      <div class="hero-actions"><a class="button button-light" href={L('/contact-us-1?type=sourcing')}>{s.home.primary}</a></div>
    </div>
    <Photo name="hero-products" class="hero-photo hero-photo-tall" alt={s.home.heroAlt} priority />
  </div>
  <div class="hero-meta"><div class="container hero-meta-inner">{entries.map(entry => <a href={L(entry.href)}><strong>{entry.name}</strong><span>{entry.text}</span></a>)}</div></div>
</section>

<section class="section section-paper trio-section">
  <div class="container">
    <div class="trio-head"><h2>{s.home.threeTitle}</h2><p class="lede">{s.home.threeLede}</p></div>
    <div class="trio">{s.home.three.map((item, i) => <article class="trio-card">
      <div class="trio-top"><span class="trio-icon" aria-hidden="true" set:html={trioIcons[i]}/><span class="trio-num" aria-hidden="true">{(lang === 'fa' ? String(i + 1) : String(i + 1).padStart(2, '0'))}</span></div>
      <h3>{item.title}</h3>
      <p>{item.text}</p>
      <div class="trio-links"><a class="trio-link" href={L(item.href)}><span>{item.link}</span><span class="trio-arrow" aria-hidden="true">{lang === 'fa' ? '←' : '→'}</span></a>{(item as any).link2 && <a class="trio-link" href={L((item as any).href2)}><span>{(item as any).link2}</span><span class="trio-arrow" aria-hidden="true">{lang === 'fa' ? '←' : '→'}</span></a>}</div>
    </article>)}</div>
  </div>
</section>

<section class="section section-navy">
  <div class="container spotlight">
    <div>
      <h2>{s.home.portfolioTitle}</h2>
      <div class="spotlight-figure"><div><strong class="num">{fmt(portfolio.counts.total)}{lang === 'fa' && <small class="num-unit"> قلم</small>}</strong><span>{s.home.figRegistered}</span></div><div><strong class="num">{fmt(portfolio.counts.available)}{lang === 'fa' && <small class="num-unit"> قلم</small>}</strong><span>{s.home.figAvailable}</span></div><div><strong class="num">{fmt(portfolio.counts.launching)}{lang === 'fa' && <small class="num-unit"> قلم</small>}</strong><span>{s.home.figLaunching}</span></div></div>
      <p>{s.home.portfolioText}</p>
      <div class="actions"><a class="button button-light" href={L('/fdf#product-portfolio')}>{s.home.portfolioPrimary}</a>{lang !== 'fa' && <a class="text-link" href={L('/contact-us-1?type=regulatory')}>{s.home.portfolioSecondary}</a>}</div>
    </div>
    <ul class="area-list">{portfolio.groups.map(group => <li><a href={L(`/fdf#portfolio-${group.id}`)}>{groupTitle(group.id, group.title)}<small>{fmt(group.products.length)}</small></a></li>)}</ul>
  </div>
</section>

<section class="section section-paper">
  <div class="container company-note">
    <figure class="cn-media">
      <Photo name="tehran-alborz" class="company-photo" alt={s.home.tehranAlt} />
      <figcaption class="cn-badge"><Icon name="pin" size={15}/>{hqBadge}</figcaption>
    </figure>
    <div class="copy cn-copy">
      <span class="persian-name cn-name" lang="fa">شرکت هانیا پرسان دارو</span>
      {lang !== 'fa' && <h2>{s.home.companyTitle}</h2>}
      <p>{s.home.companyText}</p>
      <ul class="cn-facts">
        {lang !== 'fa' && <li><span class="cn-ico"><Icon name="pin" size={17}/></span><span>{s.home.companyAddress.split(' · ').slice(-1)[0]}</span></li>}
        {lang !== 'fa' && <li><span class="cn-ico"><Icon name="clock" size={17}/></span><span>{s.home.companyHours}</span></li>}
        {lang !== 'fa' && <li><span class="cn-ico"><Icon name="phone" size={17}/></span><a href="tel:+982188883325" dir="ltr" data-fa-digits>+98 21 8888 3325</a></li>}
      </ul>
      <a class="button button-navy cn-more" href={L('/about-us')}>{s.home.about}<Icon name="arrow" size={17} class="cn-arrow"/></a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><h2>{s.home.stepsTitle}</h2>{s.home.stepsLede && <p class="lede">{s.home.stepsLede}</p>}</div>
    <ol class="steps">{s.home.steps.map(step => <li class="step"><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
  </div>
</section>

<section class="section section-paper section-tight">
  <div class="container">
    <div class="section-head"><h2>{s.home.newsTitle}</h2><a class="text-link" href={L('/news')}>{s.home.newsAll}</a></div>
    {todayNews.length > 0 && <div class="news-grid">{todayNews.map((item, i) => <NewsCard item={item} eager={false}/>)}</div>}
  </div>
</section>
<FaqFa />
<CTA />
