---
import CTA from './CTA.astro';
import Photo from './Photo.astro';
import InsightRow from './InsightCard.astro';
import articles from '../data/articles.json';
import portfolio from '../data/portfolio.json';
import fdf from '../data/fdf.json';
import apis from '../data/apis.json';
const featured = [...articles].sort((a,b) => new Date(b.date).getTime()-new Date(a.date).getTime()).slice(0,3);
const fmt = (n:number) => n.toLocaleString('en-US');
const entries = [
  { href:'/fdf', name:'Finished dosage forms', text:`${portfolio.counts.total} registered medicines and ${fmt(fdf.length)} reference products.` },
  { href:'/api', name:'Active ingredients', text:`${fmt(apis.length)} substances in the reference range.` },
  { href:'/excipient', name:'Excipients', text:'By grade and specification.' },
  { href:'/nutrition', name:'Nutrition ingredients', text:'Vitamins and nutrition database.' },
];
---
<section class="hero hero-split">
  <div class="container hero-grid">
    <div class="hero-main">
      <h1>Medicines and ingredients for Iran, sourced and registered by one team.</h1>
      <p class="lede">Hanpars imports active ingredients, finished medicines, excipients and nutrition ingredients, and registers them with the IFDA. Based in Tehran, with suppliers in Türkiye, China, India and Europe.</p>
      <div class="hero-actions"><a class="button button-light" href="/contact-us-1?type=sourcing">Prepare a sourcing enquiry</a><a class="text-link" href="/regulatory-affairs">Regulatory affairs</a></div>
    </div>
    <Photo name="hero-cleanroom" class="hero-photo" alt="Operator in a blue cleanroom suit working at a pharmaceutical isolator" priority />
  </div>
  <div class="hero-meta"><div class="container hero-meta-inner">{entries.map(entry => <a href={entry.href}><strong>{entry.name}</strong><span>{entry.text}</span></a>)}</div></div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><h2>Three things we do, usually together.</h2><p class="lede">A supply agreement is only useful once the product is approved and on the shelf, so sourcing, registration and project coordination sit with the same people.</p></div>
    <div class="columns-3">
      <article class="column-item"><h3>Import and sourcing</h3><p>APIs, excipients and finished products from manufacturers we already work with, brought into Iran with the certificates and stability data the authority expects.</p><a class="text-link" href="/api">API reference range</a></article>
      <article class="column-item"><h3>Regulatory affairs</h3><p>CTD, eCTD and ACTD dossiers, IFDA and TİTCK submissions, authority correspondence and lifecycle maintenance. On its own, or with the products we supply.</p><a class="text-link" href="/regulatory-affairs">What we cover</a></article>
      <article class="column-item"><h3>Development partnerships</h3><p>For finished dosage-form projects we coordinate development and manufacturing partners, with responsibilities written down at the start. We run the project; partners run the plant.</p><a class="text-link" href="/fdf-cdmo">How a project begins</a></article>
    </div>
  </div>
</section>

<section class="section section-navy">
  <div class="container spotlight">
    <div>
      <h2>The hospital and specialty portfolio</h2>
      <div class="spotlight-figure"><div><strong class="num">{portfolio.counts.total}</strong><span>medicines registered with the IFDA</span></div><div><strong class="num">{portfolio.counts.available}</strong><span>available in Iran</span></div><div><strong class="num">{portfolio.counts.launching}</strong><span>launching</span></div></div>
      <p>Contrast media, anaesthetics, antibiotics, hormones and biologics from GMP-certified manufacturers, distributed nationally through Pakhsh Razi, Darougostar Tooba and Dey Darou Omid. Hanpars is a contracted supplier to the national Strategic Medicine Reserve.</p>
      <div class="actions"><a class="button button-light" href="/fdf#product-portfolio">See the portfolio</a><a class="text-link" href="/contact-us-1?type=regulatory">Represent your products in Iran</a></div>
      <p class="spotlight-note">Status as of {portfolio.snapshot}; confirm availability when you enquire.</p>
    </div>
    <ul class="area-list">{portfolio.groups.map(group => <li><a href={`/fdf#portfolio-${group.id}`}>{group.title}<small>{group.products.length}</small></a></li>)}</ul>
  </div>
</section>

<section class="section section-paper">
  <div class="container company-note">
    <Photo name="tehran-alborz" class="company-photo" alt="Tehran beneath the snow-covered Alborz mountains" />
    <div class="copy">
      <span class="persian-name" lang="fa">شرکت هانیا پرسان دارو</span>
      <h2>A trading company in Tehran that holds its own licences.</h2>
      <p>Hanpars is the marketing authorisation holder for the medicines it imports: the dossier, the IRC licence and pharmacovigilance are handled in-house. We source, register and coordinate; manufacturers manufacture, and the authority decides. Saying precisely who does what is how we keep projects moving.</p>
      <address class="address">Haniya Parsan Darou Co. · 3rd floor, No. 326, Zafar Street, Africa Boulevard, Tehran<small>Office hours 09:00–17:00 · <a href="tel:+982188856347">+98 21 8885 6347</a></small></address>
      <a class="text-link" href="/about-us">About Hanpars</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><h2>How a request proceeds</h2><p class="lede">A product name and a destination are enough to start.</p></div>
    <ol class="steps">
      <li class="step"><h3>Tell us what you need</h3><p>The product, the strength or grade, the quantity and where it is going.</p></li>
      <li class="step"><h3>We put it in context</h3><p>Who can supply it, what the market will require, and what is realistic for timing.</p></li>
      <li class="step"><h3>We agree the scope</h3><p>Who does what, in writing, with one contact at Hanpars accountable for it.</p></li>
    </ol>
  </div>
</section>

<section class="section section-paper section-tight">
  <div class="container">
    <div class="section-head"><h2>From the archive</h2><a class="text-link" href="/blog-1">All archived articles</a></div>
    <ul class="insight-list">{featured.map(article => <li><InsightRow article={article}/></li>)}</ul>
    <p class="reference-note">Dated editorial commentary, not a current forecast or regulatory advice.</p>
  </div>
</section>
<CTA />
