---
import CTA from './CTA.astro';
import Photo from './Photo.astro';
import NewsCard from './NewsCard.astro';
import FaqFa from './FaqFa.astro';
import news from '../data/news.json';
import portfolio from '../data/portfolio.json';
import { portfolioFa } from '../data/portfolio.fa';
import fdf from '../data/fdf.json';
import apis from '../data/apis.json';
import { langFromPath, localePath, t } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const s = t(lang);
const L = (p: string) => localePath(p, lang);
const fa = lang === 'fa';
const todayNews = [...(news.global || []).slice(0,2), ...(news.china || []).slice(0,1)];
const fmt = (n:number) => n.toLocaleString(fa ? 'fa-IR' : 'en-US');
const snapshot = fa ? portfolioFa.snapshot : portfolio.snapshot;
const groupTitle = (id:string, title:string) => fa ? (portfolioFa.groups[id]?.title ?? title) : title;
const entries = [
  { href:'/fdf', name:s.home.entries.fdf, text:s.home.entries.fdfText(portfolio.counts.total, fmt(fdf.length)) },
  { href:'/api', name:s.home.entries.api, text:s.home.entries.apiText(fmt(apis.length)) },
  { href:'/excipient', name:s.home.entries.exc, text:s.home.entries.excText },
  { href:'/nutrition', name:s.home.entries.nut, text:s.home.entries.nutText },
];
---
<section class="hero hero-split">
  <div class="container hero-grid">
    <div class="hero-main">
      <h1>{s.home.title.split('\n').map((line,i)=><>{i>0&&<br/>}{line}</>)}</h1>
      <p class="lede">{s.home.lede}</p>
      <div class="hero-actions"><a class="button button-light" href={L('/contact-us-1?type=sourcing')}>{s.home.primary}</a></div>
    </div>
    <Photo name="hero-products" class="hero-photo hero-photo-tall" alt={s.home.heroAlt} priority />
  </div>
  <div class="hero-meta"><div class="container hero-meta-inner">{entries.map(entry => <a href={L(entry.href)}><strong>{entry.name}</strong><span>{entry.text}</span></a>)}</div></div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><h2>{s.home.threeTitle}</h2><p class="lede">{s.home.threeLede}</p></div>
    <div class="columns-3">{s.home.three.map(item => <article class="column-item"><h3>{item.title}</h3><p>{item.text}</p><a class="text-link" href={L(item.href)}>{item.link}</a></article>)}</div>
  </div>
</section>

<section class="section section-navy">
  <div class="container spotlight">
    <div>
      <h2>{s.home.portfolioTitle}</h2>
      <div class="spotlight-figure"><div><strong class="num">{fmt(portfolio.counts.total)}</strong><span>{s.home.figRegistered}</span></div><div><strong class="num">{fmt(portfolio.counts.available)}</strong><span>{s.home.figAvailable}</span></div><div><strong class="num">{fmt(portfolio.counts.launching)}</strong><span>{s.home.figLaunching}</span></div></div>
      <p>{s.home.portfolioText}</p>
      <div class="actions"><a class="button button-light" href={L('/fdf#product-portfolio')}>{s.home.portfolioPrimary}</a><a class="text-link" href={L('/contact-us-1?type=regulatory')}>{s.home.portfolioSecondary}</a></div>
      <p class="spotlight-note">{s.home.portfolioNote(snapshot)}</p>
    </div>
    <ul class="area-list">{portfolio.groups.map(group => <li><a href={L(`/fdf#portfolio-${group.id}`)}>{groupTitle(group.id, group.title)}<small>{fmt(group.products.length)}</small></a></li>)}</ul>
  </div>
</section>

<section class="section section-paper">
  <div class="container company-note">
    <Photo name="tehran-alborz" class="company-photo" alt={s.home.tehranAlt} />
    <div class="copy">
      <span class="persian-name" lang="fa">شرکت هانیا پرسان دارو</span>
      <h2>{s.home.companyTitle}</h2>
      <p>{s.home.companyText}</p>
      <address class="address">{s.home.companyAddress}<small>{s.home.companyHours} · <a href="tel:+982188883325" dir="ltr" data-fa-digits>+98 21 8888 3325</a></small></address>
      <a class="text-link" href={L('/about-us')}>{s.home.about}</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><h2>{s.home.stepsTitle}</h2><p class="lede">{s.home.stepsLede}</p></div>
    <ol class="steps">{s.home.steps.map(step => <li class="step"><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
  </div>
</section>

<section class="section section-paper section-tight">
  <div class="container">
    <div class="section-head"><h2>{s.home.newsTitle}</h2><a class="text-link" href={L('/news')}>{s.home.newsAll}</a></div>
    {todayNews.length > 0 && <div class="news-grid">{todayNews.map((item, i) => <NewsCard item={item} eager={false}/>)}</div>}
  </div>
</section>
{lang === 'fa' && <FaqFa />}
<CTA />
