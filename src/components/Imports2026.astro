---
/** Import activity 2026 — overall figures and the molecule bubble chart (3-D floating spheres). Data from the owner's block. */
import { langFromPath, localePath } from '../i18n';
import mols from '../data/imports-2026.json';
interface Props { variant?: 'about' | 'page' | 'bubbles' }
const { variant = 'about' } = Astro.props;
const lang = langFromPath(Astro.url.pathname) as 'en' | 'fa' | 'zh' | 'tr';
const FA = '۰۱۲۳۴۵۶۷۸۹';
const digits = (x: string) => lang === 'fa' ? x.replace(/[0-9]/g, d => FA[+d]).replace(/\./g, '٫') : lang === 'tr' ? x.replace(/\./g, ',') : x;
const n1 = (v: number, d = 1) => digits(v.toFixed(d));

const T = {
  en: {
    name: 'Import activity', more: 'See the full import activity', title: 'Imports in 2026',
    p: ['HANPARS began importing at the end of 2025 with two emergency products, misoprostol and naloxone. Through 2026 the portfolio has grown steadily as new IRC licences were granted, and the pace of imports accelerated markedly in the second half of the year.',
        'In 2026 the company has imported more than 33 million euros’ worth of medicines — over 100 million units across 30 molecules, including contrast media, hormones, CNS medicines, anti-infectives and critical-care products — sourced from manufacturers in Türkiye, China and the United Kingdom. Further registered orders are scheduled for the coming months.'],
    stats: [['€33.4 M', 'total value of imports, 2026'], ['100.8 M', 'units imported'], ['30', 'molecules imported']],
    h3: 'What we import — by molecule',
    sub: 'Each bubble is one generic molecule imported in 2026. Bubble size reflects the relative import volume; colour is the therapeutic area. Hover or tap a bubble for its quantity.',
    note: '30 molecules and 100.8 million units imported in 2026. Hydrocortisone, clopidogrel and sertraline are the largest lines, and the contrast media together form the fastest-turning part of the portfolio.',
    units: (u: number) => u >= 1e6 ? `${(u / 1e6).toFixed(1)} M` : `${Math.round(u / 1e3)} k`, unitWord: 'units',
    groups: { contrast: 'Contrast media', hormones: 'Hormones & endocrinology', cns: 'CNS & psychiatry', cardio: 'Cardiovascular', antiinf: 'Anti-infectives', emergency: 'Emergency & critical care', immuno: 'Immunology & oncology support', other: 'Other specialties' },
  },
  fa: {
    name: 'فعالیت واردات', more: 'مشاهدهٔ کامل فعالیت واردات', title: 'واردات ۲۰۲۶',
    p: ['هانیا پرسان دارو واردات را از اواخر سال ۲۰۲۵ با دو داروی فوریتی، میزوپروستول و نالوکسان، آغاز کرد. در طول ۲۰۲۶ با صدور کدهای IRC جدید، سبد وارداتی شرکت پیوسته گسترش یافت و در نیمهٔ دوم سال شتاب واردات به‌طور چشمگیری افزایش پیدا کرد.',
        'شرکت در سال ۲۰۲۶ بیش از ۳۳ میلیون یورو دارو وارد کرده است — بیش از ۱۰۰ میلیون واحد در ۳۰ مولکول، شامل داروهای حاجب، هورمون‌ها، داروهای اعصاب و روان، داروهای ضدعفونت و داروهای مراقبت‌های ویژه — که از تولیدکنندگانی در ترکیه، چین و انگلستان تأمین شده‌اند. سفارش‌های ثبت‌شدهٔ دیگری نیز برای ماه‌های آینده برنامه‌ریزی شده است.'],
    stats: [['۳۳٫۴ میلیون یورو', 'ارزش کل واردات، ۲۰۲۶'], ['۱۰۰٫۸ میلیون', 'واحد وارداتی'], ['۳۰', 'مولکول وارداتی']],
    h3: 'چه وارد می‌کنیم — به تفکیک مولکول',
    sub: 'هر حباب یک مولکول ژنریک وارداتی در ۲۰۲۶ است. اندازهٔ حباب حجم نسبی واردات و رنگ آن حوزهٔ درمانی را نشان می‌دهد. برای دیدن مقدار، نشانگر را روی حباب ببرید یا روی آن بزنید.',
    note: 'در سال ۲۰۲۶، ۳۰ مولکول و ۱۰۰٫۸ میلیون واحد دارو وارد شده است. هیدروکورتیزون، کلوپیدوگرل و سرترالین بزرگ‌ترین اقلام‌اند و داروهای حاجب در مجموع پرگردش‌ترین بخش سبد را تشکیل می‌دهند.',
    units: (u: number) => u >= 1e6 ? `${n1(u / 1e6)} میلیون` : `${digits(String(Math.round(u / 1e3)))} هزار`, unitWord: 'واحد',
    groups: { contrast: 'داروهای حاجب', hormones: 'هورمون‌ها و غدد درون‌ریز', cns: 'اعصاب و روان', cardio: 'قلب و عروق', antiinf: 'داروهای ضدعفونت', emergency: 'اورژانس و مراقبت‌های ویژه', immuno: 'ایمونولوژی و حمایت انکولوژی', other: 'سایر تخصص‌ها' },
  },
  zh: {
    name: '进口动态', more: '查看完整进口动态', title: '2026 年进口情况',
    p: ['HANPARS 于 2025 年底开始进口，首批为米索前列醇和纳洛酮两种紧急药品。2026 年，随着新的 IRC 许可陆续获批，产品组合稳步扩大，下半年进口节奏明显加快。',
        '2026 年公司已进口逾 3,300 万欧元的药品——30 种分子、超过 1 亿单位，涵盖造影剂、激素、中枢神经系统药物、抗感染药和重症监护产品——货源来自土耳其、中国和英国的生产商。另有一批已登记订单计划于未来数月到货。'],
    stats: [['€3,340 万', '2026 年进口总值'], ['1.008 亿', '进口单位'], ['30', '种进口分子']],
    h3: '我们进口什么——按分子',
    sub: '每个气泡代表 2026 年进口的一种通用名分子。气泡大小反映相对进口量，颜色代表治疗领域。将鼠标悬停或点按气泡可查看数量。',
    note: '2026 年共进口 30 种分子、1.008 亿单位。氢化可的松、氯吡格雷和舍曲林是最大的品种，造影剂整体则是组合中周转最快的部分。',
    units: (u: number) => { const w = u / 1e4; return `${w >= 100 ? Math.round(w) : +w.toFixed(1)} 万`; }, unitWord: '单位',
    groups: { contrast: '造影剂', hormones: '激素与内分泌', cns: '中枢神经与精神科', cardio: '心血管', antiinf: '抗感染', emergency: '急救与重症监护', immuno: '免疫与肿瘤支持', other: '其他专科' },
  },
  tr: {
    name: 'İthalat faaliyeti', more: 'İthalat faaliyetinin tamamını görün', title: '2026 ithalatı',
    p: ['HANPARS ithalata 2025 sonunda iki acil ürünle, misoprostol ve naloksonla başladı. 2026 boyunca yeni IRC lisansları verildikçe portföy istikrarlı biçimde büyüdü ve yılın ikinci yarısında ithalat temposu belirgin şekilde hızlandı.',
        'Şirket 2026’da 33 milyon euroyu aşan değerde ilaç ithal etti — 30 molekülde 100 milyonu aşkın birim; kontrast maddeler, hormonlar, MSS ilaçları, anti-enfektifler ve yoğun bakım ürünleri — Türkiye, Çin ve Birleşik Krallık’taki üreticilerden tedarik edildi. Kayıtlı yeni siparişler önümüzdeki aylar için planlandı.'],
    stats: [['33,4 mn €', 'toplam ithalat değeri, 2026'], ['100,8 mn', 'ithal edilen birim'], ['30', 'ithal edilen molekül']],
    h3: 'Neler ithal ediyoruz — moleküle göre',
    sub: 'Her balon, 2026’da ithal edilen bir jenerik molekülü gösterir. Balon büyüklüğü göreli ithalat hacmini, renk ise tedavi alanını yansıtır. Miktar için bir balonun üzerine gelin veya dokunun.',
    note: '2026’da 30 molekül ve 100,8 milyon birim ithal edildi. Hidrokortizon, klopidogrel ve sertralin en büyük kalemlerdir; kontrast maddeler ise birlikte portföyün en hızlı dönen bölümünü oluşturur.',
    units: (u: number) => u >= 1e6 ? `${n1(u / 1e6)} mn` : `${Math.round(u / 1e3)} bin`, unitWord: 'birim',
    groups: { contrast: 'Kontrast maddeler', hormones: 'Hormonlar ve endokrinoloji', cns: 'MSS ve psikiyatri', cardio: 'Kardiyovasküler', antiinf: 'Anti-enfektifler', emergency: 'Acil ve yoğun bakım', immuno: 'İmmünoloji ve onkoloji desteği', other: 'Diğer uzmanlık alanları' },
  },
}[lang];

const COL: Record<string, string> = { contrast: '#2a78d6', hormones: '#eb6834', cns: '#1baf7a', cardio: '#eda100', antiinf: '#e87ba4', emergency: '#008300', immuno: '#6250d6', other: '#e34948' };
// Label fitting: keep every name and value inside its sphere (≈ .58 em per Latin char, .62 for Persian/Chinese runs)
const fit = (text: string, r: number, max: number, em = .58) => Math.max(6, Math.min(max, (1.62 * r) / (text.length * em)));
const bubbles = [...mols].sort((a, b) => b.r - a.r).map((m, i) => {
  const val = T.units(m.units);
  const nameFs = m.label ? fit(m.label, m.r, m.r > 60 ? 14 : m.r > 40 ? 12.5 : 10) : 0;
  const showVal = !!m.label && m.r >= 32;
  const valFs = showVal ? fit(val, m.r, m.r > 60 ? 11.5 : 10, lang === 'en' ? .56 : .62) : 0;
  return { ...m, i, val, nameFs, showVal, valFs };
});
const mix = (hex: string, to: string, t: number) => { const a = hex.match(/\w\w/g)!.map(h => parseInt(h, 16)), b = to.match(/\w\w/g)!.map(h => parseInt(h, 16)); return '#' + a.map((v, i) => Math.round(v + (b[i] - v) * t).toString(16).padStart(2, '0')).join(''); };
const grads = Object.entries(COL).map(([k, c]) => ({ id: `imp-g-${k}`, hi: mix(c, '#ffffff', .62), mid: c, lo: mix(c, '#000000', .38) }));
const L = (p: string) => localePath(p, lang);
const rtl = lang === 'fa';
---
<section class:list={['section', 'imp', { 'imp-solo': variant === 'bubbles' }]} id="imports-2026">
  <div class="container">
    {variant !== 'bubbles' && <div class="imp-top">
      <div class="imp-copy">
        {variant === 'about' ? <><span class="kicker">{T.title}</span><h2>{T.name}</h2></> : <h2>{T.title}</h2>}
        {T.p.map(p => <p>{p}</p>)}
      </div>
      <dl class="imp-stats">
        {T.stats.map(([b, l]) => <div><dt>{b}</dt><dd>{l}</dd></div>)}
      </dl>
    </div>}

    <div class="imp-mol">
      {variant === 'bubbles' ? <><span class="kicker">{T.name}</span><h2>{T.h3}</h2></> : <h3>{T.h3}</h3>}
      <p class="imp-sub">{T.sub}</p>
      <div class="imp-bwrap">
        <figure class="imp-fig imp-bub">
          <svg viewBox="0 0 560 563" role="img" aria-label={T.h3}>
            <defs>{grads.map(g => <radialGradient id={g.id} cx="36%" cy="30%" r="75%" fx="32%" fy="26%"><stop offset="0" stop-color={g.hi}/><stop offset=".48" stop-color={g.mid}/><stop offset="1" stop-color={g.lo}/></radialGradient>)}</defs>
            {bubbles.map(m => <g class="imp-b" data-t={m.name} data-v={`${T.groups[m.group as keyof typeof T.groups]}|${m.val} ${T.unitWord}`} tabindex="0"><g class="imp-ball" style={`--d:${-((m.i * 1.37) % 6).toFixed(2)}s;--t:${(5 + (m.i % 5) * .7).toFixed(1)}s;--a:${(m.r > 60 ? 2.5 : m.r > 25 ? 3.5 : 4.5)}px`}>
              <circle cx={m.cx} cy={m.cy} r={m.r} fill={`url(#imp-g-${m.group})`} />
              <ellipse class="imp-spec" cx={m.cx - m.r * .34} cy={m.cy - m.r * .42} rx={m.r * .32} ry={m.r * .19} transform={`rotate(-28 ${m.cx - m.r * .34} ${m.cy - m.r * .42})`} />
              {m.label && <text class="imp-bl" x={m.cx} y={m.showVal ? m.cy - m.valFs * .25 : m.cy + m.nameFs * .35} style={`font-size:${m.nameFs.toFixed(1)}px`} lang="en">{m.label}</text>}
              {m.showVal && <text class="imp-bv" x={m.cx} y={m.cy + m.nameFs * .3 + m.valFs} style={`font-size:${m.valFs.toFixed(1)}px`} direction={rtl ? 'rtl' : undefined} unicode-bidi={rtl ? 'embed' : undefined}>{m.val}</text>}
            </g></g>)}
          </svg>
          <div class="imp-tip" role="status" aria-live="polite"></div>
        </figure>
        <div class="imp-legend">
          <ul>{Object.entries(T.groups).map(([k, v]) => <li><i style={`background-color:${COL[k]}`}></i>{v}</li>)}</ul>
          <p>{T.note}</p>
          {variant === 'bubbles' && <a class="button button-navy imp-more" href={L('/import-activity')}>{T.more}</a>}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('#imports-2026 .imp-fig').forEach(fig => {
    const tip = fig.querySelector<HTMLElement>('.imp-tip')!;
    let pinned: Element | null = null;
    const show = (el: HTMLElement, x: number, y: number) => {
      const r = fig.getBoundingClientRect();
      tip.replaceChildren(Object.assign(document.createElement('b'), { textContent: el.dataset.t || '' }));
      (el.dataset.v || '').split('|').forEach(line => tip.append(document.createElement('br'), line));
      const left = Math.min(Math.max(x - r.left, 90), r.width - 90);
      tip.style.left = left + 'px'; tip.style.top = (y - r.top - 10) + 'px'; tip.classList.add('on');
    };
    const hide = () => { tip.classList.remove('on'); pinned = null; };
    fig.querySelectorAll<HTMLElement>('[data-t]').forEach(el => {
      el.addEventListener('pointermove', e => { if (e.pointerType === 'mouse') show(el, e.clientX, e.clientY); });
      el.addEventListener('pointerleave', e => { if (e.pointerType === 'mouse') hide(); });
      el.addEventListener('click', e => { e.stopPropagation(); if (pinned === el) return hide(); pinned = el; show(el, e.clientX, e.clientY); });
      el.addEventListener('focus', () => { const b = el.getBoundingClientRect(); show(el, b.left + b.width / 2, b.top); });
      el.addEventListener('blur', hide);
    });
    document.addEventListener('click', hide);
  });
</script>
