        const body = ctx.createRadialGradient(sx - sr * .15, sy - sr * .55, sr * .05, sx, sy, sr);
        body.addColorStop(0, `rgba(${Math.min(255, r + 110)},${Math.min(255, g + 110)},${Math.min(255, b + 110)},.78)`);
        body.addColorStop(.55, `rgba(${r},${g},${b},.55)`);
        body.addColorStop(1, `rgba(${r * .45 | 0},${g * .45 | 0},${b * .45 | 0},.7)`);
        ctx.shadowColor = `rgba(${r},${g},${b},.35)`; ctx.shadowBlur = sr * .25;
        ctx.fillStyle = body; ctx.beginPath(); ctx.arc(sx, sy, sr, 0, Math.PI * 2); ctx.fill();
        ctx.shadowBlur = 0;
        ctx.strokeStyle = `rgba(255,255,255,.28)`; ctx.lineWidth = Math.max(.8, sr * .025); ctx.stroke();
        // overhead highlight + bounce light from the desk
        const hl = ctx.createRadialGradient(sx - sr * .12, sy - sr * .62, 0, sx - sr * .12, sy - sr * .62, sr * .5);
        hl.addColorStop(0, 'rgba(255,250,240,.8)'); hl.addColorStop(1, 'rgba(255,250,240,0)');
        ctx.fillStyle = hl; ctx.beginPath(); ctx.arc(sx, sy, sr, 0, Math.PI * 2); ctx.fill();
        const bo = ctx.createRadialGradient(sx, sy + sr * .9, 0, sx, sy + sr * .9, sr * .7);
        bo.addColorStop(0, 'rgba(255,215,170,.18)'); bo.addColorStop(1, 'rgba(255,215,170,0)');
        ctx.fillStyle = bo; ctx.beginPath(); ctx.arc(sx, sy, sr, 0, Math.PI * 2); ctx.fill();
        ctx.restore();
        if (it.l && sr > 19 && blur < 1.4) {
          ctx.save(); ctx.fillStyle = '#fff'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.shadowColor = 'rgba(0,0,0,.6)'; ctx.shadowBlur = 4;
          let fs = Math.min(14, sr * .32); ctx.font = `600 ${fs}px ${font}`; ctx.direction = 'ltr';
          const w = ctx.measureText(it.l).width; if (w > sr * 1.7) { fs *= sr * 1.7 / w; ctx.font = `600 ${fs}px ${font}`; }
          const showV = sr > 30;
          ctx.fillText(it.l, sx, showV ? sy - fs * .45 : sy);
          if (showV) {
            let vs = Math.min(12, fs * .85); ctx.font = `400 ${vs}px ${font}`; ctx.direction = data.rtl ? 'rtl' : 'ltr';
            const vw = ctx.measureText(it.v).width; if (vw > sr * 1.6) { vs *= sr * 1.6 / vw; ctx.font = `400 ${vs}px ${font}`; }
            ctx.globalAlpha = .9; ctx.fillText(it.v, sx, sy + fs * .75);
          }
          ctx.restore();
        }
      }
      // soft vignette
      const vg = ctx.createRadialGradient(W / 2, H * .45, Math.min(W, H) * .4, W / 2, H * .45, Math.max(W, H) * .8);
      vg.addColorStop(0, 'rgba(0,0,0,0)'); vg.addColorStop(1, 'rgba(0,0,0,.5)');
      ctx.fillStyle = vg; ctx.fillRect(0, 0, W, H);
      frame++;
    };
    const loop = (now: number) => { draw(now); if (running) raf = requestAnimationFrame(loop); };
    const start = () => { if (running || reduce) return; running = true; raf = requestAnimationFrame(loop); };
    const stop = () => { running = false; cancelAnimationFrame(raf); };
    size(); draw(performance.now());
    new ResizeObserver(() => { size(); draw(performance.now()); }).observe(cv);
    new IntersectionObserver(es => es.forEach(e => e.isIntersecting ? start() : stop()), { threshold: .05 }).observe(cv);
    const hit = (cx: number, cy: number) => {
      const r = cv.getBoundingClientRect(), x = cx - r.left, y = cy - r.top;
      return [...items].sort((a, b) => a.d - b.d).find(it => (x - it.sx) ** 2 + (y - it.sy) ** 2 <= Math.max(it.sr, 8) ** 2) || null;
    };
    const show = (it: any, cx: number, cy: number) => {
      const r = fig.getBoundingClientRect();
      tip.replaceChildren(Object.assign(document.createElement('b'), { textContent: it.n }), document.createElement('br'), it.t, document.createElement('br'), `${it.v} ${it.u}`);
      tip.style.left = Math.min(Math.max(cx - r.left, 90), r.width - 90) + 'px'; tip.style.top = (cy - r.top - 12) + 'px'; tip.classList.add('on');
    };
    const hide = () => { tip.classList.remove('on'); hoverIt = null; };
    let moved = false;
    cv.addEventListener('pointerdown', e => { drag = { x: e.clientX, y: e.clientY, yaw, pitch }; moved = false; cv.setPointerCapture(e.pointerId); });
    cv.addEventListener('pointermove', e => {
      if (drag) {
        const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
        if (Math.abs(dx) + Math.abs(dy) > 4) { moved = true; hide(); }
        yaw = drag.yaw + dx * .008; pitch = Math.max(-.9, Math.min(-.08, drag.pitch + dy * .004));
        if (reduce) draw(performance.now());
        return;
      }
      if (e.pointerType !== 'mouse') return;
      const it = hit(e.clientX, e.clientY); hoverIt = it; cv.style.cursor = it ? 'pointer' : 'grab';
      it ? show(it, e.clientX, e.clientY) : hide();
    });
    cv.addEventListener('pointerup', e => {
      const wasDrag = moved;
      if (drag && wasDrag) base = yaw - Math.sin(((performance.now() - t0) / 1000) * .12) * .32; // keep the sway centred where the user left it
      drag = null;
      if (!wasDrag) { const it = hit(e.clientX, e.clientY); if (it) { hoverIt = it; show(it, e.clientX, e.clientY); } else hide(); }
    });
    cv.addEventListener('pointerleave', e => { if (e.pointerType === 'mouse' && !drag) hide(); });
  });
</script>
