---
import PageHero from './PageHero.astro';
import CTA from './CTA.astro';
import Catalogue from './Catalogue.astro';
import FdfPortfolio from './FdfPortfolio.astro';
import { pages, type PageKey } from '../data/pages';
import fdf from '../data/fdf.json';
import apis from '../data/apis.json';
interface Props { page:PageKey; }
const { page } = Astro.props;
const data = pages[page];
const isProduct = ['api','fdf','excipient','nutrition'].includes(page);
const cards = 'cards' in data ? data.cards : [];
const database = 'database' in data ? data.database : '';
const databaseLabel = 'databaseLabel' in data ? data.databaseLabel : '';
const photo = 'photo' in data ? data.photo : undefined;
const photoAlt = 'photoAlt' in data ? data.photoAlt : '';
const cdmoSteps = [
  {title:'The product',text:'API, dosage form, strength and intended presentation.'},
  {title:'The stage',text:'Existing formulation, dossier, technical data and development status.'},
  {title:'The market',text:'Where it will be registered, and what that authority will require.'},
  {title:'The support',text:'Formulation, scale-up, technology transfer, or a defined partner activity.'},
];
---
<PageHero title={data.title} category={data.category} description={data.description} href={`/contact-us-1?type=${page==='fdf-cdmo'?'cdmo':'sourcing'}`} action={page==='fdf-cdmo'?'Discuss a project':isProduct?'Prepare an enquiry':'Start a conversation'} dark={page==='fdf-cdmo'} photo={photo} photoAlt={photoAlt}/>
<section class="section"><div class="container content-split"><h2>{data.introTitle}</h2><div class="content-copy">{data.intro.map(p=><p>{p}</p>)}</div></div></section>
{page==='fdf'&&<FdfPortfolio/>}
{(page==='fdf'||page==='api')&&<section class="section section-paper" id={page==='fdf'?'fdf-reference':undefined} style="scroll-margin-top:40px"><div class="container"><Catalogue type={page} entries={page==='fdf'?fdf:apis.map(name=>({name}))}/>{database&&<p style="margin-top:28px"><a class="text-link" href={database} target="_blank" rel="noopener noreferrer">{databaseLabel}</a> <span class="form-hint" style="display:inline;margin-left:10px">Opens the external database in a new tab.</span></p>}</div></section>}
{(page==='excipient'||page==='nutrition')&&<section class="section-tight"><div class="container"><div class="database-card"><div><h2>{page==='excipient'?'The excipient database':'The nutrition database'}</h2><p>Browse the existing reference, then come back with the ingredient and specification you need. It opens in a new tab.</p></div><a class="button button-navy" href={database} target="_blank" rel="noopener noreferrer">{databaseLabel}</a></div></div></section>}
{cards.length>0&&<section class="section section-paper"><div class="container"><div class="section-head"><h2>{page==='fdf-cdmo'?'Dosage forms we take on':page==='about-us'?'What that looks like in practice':page==='culture'?'Three habits':'What to include in an enquiry'}</h2></div><div class="detail-grid">{cards.map(card=><article class="detail-item"><h3>{card.title}</h3><p>{card.text}</p>{'href' in card&&<a class="text-link" href={card.href}>{card.link}</a>}</article>)}</div></div></section>}
{isProduct&&<section class="section"><div class="container content-split"><h2>What makes an enquiry easy to answer</h2><ul class="check-list"><li>The product, ingredient or INN name</li><li>Specification, grade, dosage form or strength</li><li>Quantity, destination market and timing</li><li>Documentation and certificate requirements, where relevant</li></ul></div></section>}
{page==='fdf-cdmo'&&<section class="section"><div class="container"><div class="section-head"><h2>What we ask at the first meeting</h2><p class="lede">The activities and partners depend on the answers, so we start here.</p></div><ol class="steps steps-4">{cdmoSteps.map(item=><li class="step"><h3>{item.title}</h3><p>{item.text}</p></li>)}</ol><p style="margin-top:40px"><a class="text-link" href="/regulatory-affairs">How the regulatory requirements fit in</a></p></div></section>}
{!isProduct&&page!=='fdf-cdmo'&&<section class="section"><div class="container content-split"><h2>Where to go next</h2><ul class="link-list"><li><a href="/fdf">Finished dosage forms<small>Registered portfolio and reference list</small></a></li><li><a href="/api">Active ingredients<small>1,503 substances</small></a></li><li><a href="/regulatory-affairs">Regulatory affairs<small>Dossiers and IFDA submissions</small></a></li><li><a href="/fdf-cdmo">Development projects<small>Partner-coordinated FDF work</small></a></li></ul></div></section>}
<CTA title={isProduct?'Tell us the product and the market. We will tell you the next step.':page==='fdf-cdmo'?'Tell us where the project stands.':undefined}/>
