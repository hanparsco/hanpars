---
import PageHero from './PageHero.astro';
import Icon from './Icon.astro';
import CTA from './CTA.astro';
import Catalogue from './Catalogue.astro';
import FdfPortfolio from './FdfPortfolio.astro';
import { pages, type PageKey } from '../data/pages';
import fdf from '../data/fdf.json';
import apis from '../data/apis.json';
interface Props { page:PageKey; }
const { page } = Astro.props;
const data = pages[page];
const isProduct = ['api','fdf','excipient','nutrition'].includes(page);
const cards = 'cards' in data ? data.cards : [];
const database = 'database' in data ? data.database : '';
const databaseLabel = 'databaseLabel' in data ? data.databaseLabel : '';
---
<PageHero title={data.title} category={data.category} description={data.description} href={`/contact-us-1?type=${page==='fdf-cdmo'?'cdmo':'sourcing'}`} action={page==='fdf-cdmo'?'Discuss your CDMO project':isProduct?'Prepare a sourcing enquiry':'Let’s start a conversation'} dark={page==='fdf-cdmo'}/>
<section class="section"><div class="container content-split"><div><span class="eyebrow">{isProduct?'A CLEARER STARTING POINT':'THE HANPARS APPROACH'}</span><h2>{data.introTitle}</h2></div><div class="content-copy">{data.intro.map(p=><p>{p}</p>)}</div></div></section>
{page==='fdf'&&<FdfPortfolio/>}
{(page==='fdf'||page==='api')&&<section class="section section-pale" id={page==='fdf'?'fdf-reference':undefined} style="padding-top:52px;scroll-margin-top:40px"><div class="container"><Catalogue type={page} entries={page==='fdf'?fdf:apis.map(name=>({name}))}/>{database&&<a class="text-link" href={database} target="_blank" rel="noopener noreferrer" style="margin-top:20px">{databaseLabel} <Icon name="diagonal" size={17}/><span class="form-hint">External database</span></a>}</div></section>}
{(page==='excipient'||page==='nutrition')&&<section class="section section-pale"><div class="container"><div class="database-card"><div><span class="eyebrow">EXISTING REFERENCE DATABASE</span><h2>{page==='excipient'?'Explore excipient references.':'Explore nutrition references.'}</h2><p>Browse the existing external database, then prepare an enquiry with the ingredient and specification you need.</p><span class="form-hint">Opens the existing Hanpars database in a new tab.</span></div><a class="button button-navy" href={database} target="_blank" rel="noopener noreferrer">{databaseLabel}<Icon name="diagonal" size={17}/></a></div></div></section>}
{cards.length>0&&<section class="section section-pale"><div class="container"><div class="section-head"><div><span class="eyebrow">{page==='fdf-cdmo'?'PROJECT PATHWAYS':'PRINCIPLES IN PRACTICE'}</span><h2>{page==='fdf-cdmo'?'Define the dosage form.':'Keep the conversation focused.'}</h2></div></div><div class="detail-grid">{cards.map(card=><article class="detail-card"><span class="icon-tile"><Icon name={card.icon} size={25}/></span><h3>{card.title}</h3><p>{card.text}</p>{'href' in card&&<a class="text-link" href={card.href}>{card.link}<Icon name="diagonal" size={17}/></a>}</article>)}</div></div></section>}
{isProduct&&<section class="section"><div class="container content-split"><div><span class="eyebrow">PREPARE A USEFUL ENQUIRY</span><h2>The right details make a better brief.</h2></div><div><ul class="check-list"><li><Icon name="check" size={20}/>Product, ingredient or INN name</li><li><Icon name="check" size={20}/>Specification, grade, dosage form or strength</li><li><Icon name="check" size={20}/>Quantity, destination market and requested timing</li><li><Icon name="check" size={20}/>Documentation and COA requirements, where relevant</li></ul></div></div></section>}
{page==='fdf-cdmo'&&<section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">FROM BRIEF TO SCOPE</span><h2>Build the project conversation.</h2></div><p>Development activities depend on the project and partner scope. Begin with the information that matters.</p></div><div class="process-four">{[{title:'The product',text:'API, dosage form, strength and intended presentation.'},{title:'The project stage',text:'Existing formulation, dossier, technical data and development status.'},{title:'The target market',text:'Market requirements, documentation and regulatory context.'},{title:'The support needed',text:'Formulation, scale-up, technology transfer or a defined partner activity.'}].map((item,i)=><article class="step"><span class="step-num">0{i+1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div><a class="text-link" href="/regulatory-affairs" style="margin-top:30px">Connect the regulatory requirements <Icon name="arrow" size={17}/></a></div></section>}
{!isProduct&&page!=='fdf-cdmo'&&<section class="section"><div class="container content-split"><div><span class="eyebrow">PRODUCTS & SERVICES</span><h2>Explore the connected pathways.</h2></div><div><p style="color:var(--muted)">Continue with a product reference, a regulatory requirement or your project brief.</p><div class="hero-actions"><a class="button button-outline" href="/api">Explore APIs<Icon name="diagonal" size={16}/></a><a class="button button-outline" href="/regulatory-affairs">Regulatory Affairs<Icon name="diagonal" size={16}/></a><a class="button button-outline" href="/fdf-cdmo">FDF CDMO<Icon name="diagonal" size={16}/></a></div></div></div></section>}
<CTA title={isProduct?'Tell us the product and the market.':page==='fdf-cdmo'?'Tell us where your project stands.':undefined}/>
