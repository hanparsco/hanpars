---
import PageHero from './PageHero.astro';
import Icon from './Icon.astro';
import CTA from './CTA.astro';
import FaqFa from './FaqFa.astro';
import Imports2026 from './Imports2026.astro';
import Catalogue from './Catalogue.astro';
import FdfPortfolio from './FdfPortfolio.astro';
import SupplementCatalogue from './SupplementCatalogue.astro';
import ExcipientCategories from './ExcipientCategories.astro';
import ApiClasses from './ApiClasses.astro';
import CdmoPage from './CdmoPage.astro';
import PartnersPage from './PartnersPage.astro';
import ChinaIranPage from './ChinaIranPage.astro';
import apiClasses from '../data/api-classes.json';
import excCats from '../data/excipient-categories.json';
import { pages, type PageKey } from '../data/pages';
import { pagesL } from '../data/locale';
import fdf from '../data/fdf.json';
import portfolioData from '../data/portfolio.json';
import apis from '../data/apis.json';
import excipients from '../data/excipients.json';
import { langFromPath, localePath, t } from '../i18n';
import { fdfSlug } from '../data/fdf-parse';
interface Props { page:PageKey; }
const { page } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const s = t(lang);
const L = (p: string) => localePath(p, lang);
const en = pages[page];
const fa: any = lang === 'en' ? {} : ((pagesL[lang] as Record<string, any>)[page] || {});
const data = lang === 'en' ? en : { ...en, ...fa };
const isProduct = ['api','fdf','excipient','nutrition','precursors','supplies'].includes(page);
const enCards = 'cards' in en ? en.cards : [];
const cards = lang !== 'en' && fa.cards ? fa.cards.map((c: any, i: number) => ({ ...c, href: enCards[i] && 'href' in enCards[i] ? (enCards[i] as any).href : undefined })) : enCards.map(c => ({ title:c.title, text:c.text, link:'link' in c ? c.link : undefined, href:'href' in c ? c.href : undefined }));
const database = 'database' in en ? en.database : '';
const databaseLabel = lang !== 'en' && fa.databaseLabel ? fa.databaseLabel : ('databaseLabel' in en ? en.databaseLabel : '');
const photo = 'photo' in en ? en.photo : undefined;
const photoAlt = lang === 'fa' ? `${data.title} — هانیا پرسان دارو` : lang !== 'en' ? `${data.title} — Hanpars` : ('photoAlt' in en ? en.photoAlt : '');
const preorder = ['api','excipient','nutrition','precursors','supplies'].includes(page) ? ({
  en: { t: 'Pre-order only', p: 'All products listed in this section are available on pre-order only.' },
  fa: { t: 'فقط پیش‌سفارش', p: 'تمامی محصولات مندرج در این بخش فقط بر اساس پیش‌سفارش در دسترس خواهند بود.' },
  zh: { t: '仅接受预订', p: '本栏目所列全部产品仅接受预订。' },
  tr: { t: 'Yalnızca ön sipariş', p: 'Bu bölümde yer alan tüm ürünler yalnızca ön sipariş ile temin edilebilir.' },
} as const)[lang] : null;
const jump = page === 'fdf' ? (() => { const n = portfolioData.counts.total.toLocaleString('en-US'), m = fdf.length.toLocaleString('en-US'); return ({
  en: [['The Hanpars portfolio', `${n} registered medicines`], ['Reference list', `${m} finished products`]],
  fa: [['سبد محصولات', `${n} داروی ثبت‌شده`], ['فهرست مرجع', `${m} فرآوردهٔ دارویی`]],
  zh: [['Hanpars 产品组合', `${n} 个已注册药品`], ['参考清单', `${m} 个成品药`]],
  tr: [['Hanpars portföyü', `${n} ruhsatlı ilaç`], ['Referans listesi', `${m} bitmiş ürün`]],
} as Record<string, string[][]>)[lang]; })() : null;
const action = page==='partners'||page==='china-to-iran' ? s.standard.startConversation : page==='fdf-cdmo' ? s.standard.discussProject : isProduct ? s.standard.prepare : s.standard.startConversation;
---
<PageHero title={data.title} category={data.category} description={data.description} href={`/contact-us-1?type=${page==='fdf-cdmo'?'cdmo':(page==='partners'||page==='china-to-iran')?'regulatory':'sourcing'}`} action={action} photo={photo} photoAlt={photoAlt} hideAction={lang === 'fa' && page === 'culture'}/>
{preorder&&<div class="container"><aside class="preorder-note" role="note"><span class="preorder-ico"><Icon name="clock" size={22}/></span><p><strong>{preorder.t}</strong>{preorder.p}</p></aside></div>}
{page!=='fdf-cdmo'&&page!=='partners'&&page!=='china-to-iran'&&<section class="section"><div class="container content-split"><h2>{data.introTitle}</h2><div class="content-copy">{data.intro.map((p: string)=><p>{p}</p>)}{jump&&<div class="fdf-jump"><a href="#product-portfolio"><span class="fdf-jump-ico"><Icon name="capsule" size={20}/></span><span><strong>{jump[0][0]}</strong><small>{jump[0][1]}</small></span><Icon name="down" size={18} class="fdf-jump-arr"/></a><a href="#fdf-reference"><span class="fdf-jump-ico"><Icon name="layers" size={20}/></span><span><strong>{jump[1][0]}</strong><small>{jump[1][1]}</small></span><Icon name="down" size={18} class="fdf-jump-arr"/></a></div>}</div></div></section>}
{page==='fdf-cdmo'&&<CdmoPage/>}
{page==='partners'&&<PartnersPage/>}
{page==='china-to-iran'&&<ChinaIranPage/>}
{page==='about-us'&&<Imports2026/>}
{page==='fdf'&&<FdfPortfolio/>}
{page==='fdf'&&<Imports2026 variant="bubbles"/>}
{page==='excipient'&&<ExcipientCategories/>}
{page==='api'&&<ApiClasses/>}
{(page==='fdf'||page==='api'||page==='excipient')&&<section class="section section-paper" id={page==='fdf'?'fdf-reference':undefined} style="scroll-margin-top:40px"><div class="container"><Catalogue type={page==='excipient'?'exc':page} filters={page==='excipient'?[['',s.excipientCats.all],...excCats.map(c=>[c.id,(c as any)[lang]||c.en] as [string,string]),['other',s.excipientCats.other]]:page==='api'?[['',s.excipientCats.all],...apiClasses.map(c=>[c.id,`${c.id} — ${(c as any)[lang]||c.en}`] as [string,string])]:[]} entries={page==='fdf'?(fdf as {name:string;code:string}[]).map(e=>({...e,slug:fdfSlug(e)})):page==='excipient'?excipients.map(e=>({name:e.name,code:e.cas,extra:e.function,group:e.group})):apis.map(a=>({name:a.name,code:a.cas,group:(a as any).class||'other',slug:a.name.normalize('NFKD').replace(/[^\x00-\x7F]/g,'').replace(/[^a-zA-Z0-9]+/g,'-').replace(/^-|-$/g,'').toLowerCase()}))}/>{database&&<p style="margin-top:28px"><a class="text-link" href={database} target="_blank" rel="noopener noreferrer">{databaseLabel}</a> <span class="form-hint" style="display:inline;margin-inline-start:10px">{s.catalogue.externalNote}</span></p>}</div></section>}
{page==='nutrition'&&<section class="section section-paper"><div class="container"><SupplementCatalogue/></div></section>}
{cards.length>0&&page!=='fdf-cdmo'&&<section class="section section-paper"><div class="container"><div class="section-head"><h2>{s.standard.cardsTitle[page]}</h2></div><div class="detail-grid">{cards.map((card: any)=><article class="detail-item"><h3>{card.title}</h3><p>{card.text}</p>{card.href&&card.link&&<a class="text-link" href={L(card.href)}>{card.link}</a>}</article>)}</div></div></section>}
{isProduct&&<section class="section easy-sec"><div class="container">
  <div class="easy-head"><h2>{s.standard.easyTitle}</h2><a class="button button-navy easy-cta" href={L('/contact-us-1?type=sourcing')}>{s.nav.enquiry}<Icon name="arrow" size={17} class="easy-arrow"/></a></div>
  <ol class="easy-grid">{s.standard.easy.map((item, i)=><li class="easy-card"><span class="easy-ico"><Icon name={(['capsule','layers','globe','file'] as const)[i % 4]} size={22}/></span><span class="easy-num" aria-hidden="true">{lang === 'fa' ? String(i + 1) : String(i + 1).padStart(2, '0')}</span><p>{item}</p></li>)}</ol>
</div></section>}
{!isProduct&&page!=='fdf-cdmo'&&page!=='partners'&&page!=='china-to-iran'&&<section class="section"><div class="container content-split">{lang !== 'fa' && <h2>{s.standard.nextTitle}</h2>}<ul class:list={['link-list', { 'link-list-solo': lang === 'fa' }]}>{s.standard.nextLinks.map(item=><li><a href={L(item.href)}>{item.label}<small>{item.note}</small></a></li>)}</ul></div></section>}
{page==='about-us'&&<FaqFa schema={false} />}
{!(lang === 'fa' && (page === 'culture' || page === 'fdf')) && page!=='fdf-cdmo' && page!=='partners' && page!=='china-to-iran' && <CTA title={isProduct?s.standard.ctaProduct:undefined}/>}
