---
/** Homepage hero carousel: three product collages (injectables, tablets, specialty range), cross-fading every 6 s. */
import { langFromPath } from '../i18n';
const lang = langFromPath(Astro.url.pathname) as 'en' | 'fa' | 'zh' | 'tr';
const t = ({
  en: { label: 'Product highlights', go: 'Show slide', alts: ['Injectable products: calcium folinate, iodixanol, calcitonin and ampicillin/sulbactam', 'Tablet products from the Hanpars portfolio', 'Specialty products from the Hanpars portfolio'] },
  fa: { label: 'نمونه محصولات', go: 'نمایش اسلاید', alts: ['محصولات تزریقی: کلسیم فولینات، یدیکسانول، کلسی‌تونین و آمپی‌سیلین/سولباکتام', 'قرص‌های سبد محصولات هانیا پرسان دارو', 'محصولات تخصصی سبد هانیا پرسان دارو'] },
  zh: { label: '产品展示', go: '显示幻灯片', alts: ['注射剂产品：亚叶酸钙、碘克沙醇、降钙素、氨苄西林舒巴坦', '汉帕斯片剂产品', '汉帕斯专科产品'] },
  tr: { label: 'Ürünlerden örnekler', go: 'Slaydı göster', alts: ['Enjektabl ürünler: kalsiyum folinat, iyodiksanol, kalsitonin ve ampisilin/sulbaktam', 'Hanpars portföyünden tabletler', 'Hanpars portföyünden özel ürünler'] },
} as const)[lang];
---
<div class="hero-slides" data-hero-slides role="region" aria-roledescription="carousel" aria-label={t.label}>
  {[1, 2, 3].map((n, i) => (
    <img class:list={['hs-slide', { 'is-active': i === 0 }]} src={`/images/hero/slide-${n}-1800.webp`} srcset={`/images/hero/slide-${n}-1000.webp 1000w, /images/hero/slide-${n}-1800.webp 1800w`} sizes="(max-width: 860px) 100vw, 50vw" width="1800" height="1120" alt={t.alts[i]} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" aria-hidden={i === 0 ? undefined : 'true'} />
  ))}
  <div class="hs-dots">{[0, 1, 2].map(i => <button type="button" class:list={['hs-dot', { 'is-active': i === 0 }]} aria-label={`${t.go} ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} data-hs-dot={i}></button>)}</div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-hero-slides]').forEach(root => {
    const slides = Array.from(root.querySelectorAll<HTMLImageElement>('.hs-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hs-dot]'));
    let cur = 0, timer: number | undefined;
    const show = (n: number) => {
      cur = (n + slides.length) % slides.length;
      slides.forEach((s, i) => { s.classList.toggle('is-active', i === cur); if (i === cur) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true'); });
      dots.forEach((d, i) => { d.classList.toggle('is-active', i === cur); if (i === cur) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
    };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = () => { if (!reduce) { clearInterval(timer); timer = window.setInterval(() => show(cur + 1), 6000); } };
    const stop = () => clearInterval(timer);
    dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));
    root.addEventListener('mouseenter', stop); root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop); root.addEventListener('focusout', start);
    let x0: number | null = null;
    root.addEventListener('touchstart', e => { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', e => { if (x0 == null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) { const rtl = document.dir === 'rtl'; show(cur + ((dx < 0) !== rtl ? 1 : -1)); start(); } x0 = null; });
    document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
    start();
  });
</script>
<style>
  .hero-slides { position:relative; aspect-ratio:2624/1632; border-radius:18px; overflow:hidden; background:#fff; align-self:center; box-shadow:0 30px 70px -40px #000a; }
  .hs-slide { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transition:opacity .9s ease; }
  .hs-slide.is-active { opacity:1; }
  .hs-dots { position:absolute; inset-inline:0; bottom:10px; display:flex; justify-content:center; gap:8px; }
  .hs-dot { width:9px; height:9px; padding:0; border:0; border-radius:50%; background:#ffffffa6; box-shadow:0 0 0 1px #0000002e; cursor:pointer; transition:width .25s, background .25s; }
  .hs-dot.is-active { width:24px; border-radius:6px; background:#fff; }
  .hs-dot:focus-visible { outline:2px solid var(--glacier, #9cd); outline-offset:2px; }
  @media (prefers-reduced-motion: reduce) { .hs-slide { transition:none; } }
  @media (max-width:860px) { .hero-slides { margin-bottom:40px; } }
</style>
