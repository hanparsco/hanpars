---
/** Homepage hero carousel: twelve single-product slides, cross-fading every 5 s, soft faded edges. */
import { langFromPath } from '../i18n';
const lang = langFromPath(Astro.url.pathname) as 'en' | 'fa' | 'zh' | 'tr';
const t = ({
  en: { label: 'Product highlights', go: 'Show slide', alts: [] as string[] },
  fa: { label: 'نمونه محصولات', go: 'نمایش اسلاید', alts: [] as string[] },
  zh: { label: '产品展示', go: '显示幻灯片', alts: [] as string[] },
  tr: { label: 'Ürünlerden örnekler', go: 'Slaydı göster', alts: [] as string[] },
} as const)[lang];
const ALTS = ['Asentrix (sertraline) tablets', 'CalFolin (calcium folinate) for injection', 'Iodixanol injection', 'Calcitonin (salmon) injection', 'Ampicillin and sulbactam for injection', 'Exemestane tablets', 'Planor (clopidogrel) tablets', 'Olanova (olanzapine) tablets', 'Selectra 100 mg (sertraline) tablets', 'Daiana (cyproterone acetate and ethinylestradiol) tablets', 'Alendrohan (alendronate sodium) tablets', 'Hexarin (heparin sodium) injection'];
const N = ALTS.length;
---
<div class="hero-slides" data-hero-slides role="region" aria-roledescription="carousel" aria-label={t.label}>
  {ALTS.map((alt, i) => (
    <img class:list={['hs-slide', { 'is-active': i === 0 }]} src={i === 0 ? `/images/hero/p01-1600.webp` : 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=='} srcset={i === 0 ? `/images/hero/p01-900.webp 900w, /images/hero/p01-1600.webp 1600w` : undefined} data-src={i === 0 ? undefined : `/images/hero/p${String(i + 1).padStart(2, '0')}-1600.webp`} data-srcset={i === 0 ? undefined : `/images/hero/p${String(i + 1).padStart(2, '0')}-900.webp 900w, /images/hero/p${String(i + 1).padStart(2, '0')}-1600.webp 1600w`} sizes="(max-width: 860px) 100vw, 58vw" width="1600" height="1000" alt={alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" aria-hidden={i === 0 ? undefined : 'true'} />
  ))}
  <div class="hs-dots">{ALTS.map((_, i) => <button type="button" class:list={['hs-dot', { 'is-active': i === 0 }]} aria-label={`${t.go} ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} data-hs-dot={i}></button>)}</div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-hero-slides]').forEach(root => {
    const slides = Array.from(root.querySelectorAll<HTMLImageElement>('.hs-slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hs-dot]'));
    let cur = 0, timer: number | undefined;
    const load = (s: HTMLImageElement) => { if (s.dataset.src) { s.srcset = s.dataset.srcset || ''; s.src = s.dataset.src; delete s.dataset.src; delete s.dataset.srcset; } };
    const show = (n: number) => {
      cur = (n + slides.length) % slides.length;
      load(slides[cur]); load(slides[(cur + 1) % slides.length]);
      slides.forEach((s, i) => { s.classList.toggle('is-active', i === cur); if (i === cur) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true'); });
      dots.forEach((d, i) => { d.classList.toggle('is-active', i === cur); if (i === cur) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current'); });
    };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const start = () => { if (!reduce) { clearInterval(timer); timer = window.setInterval(() => show(cur + 1), 5000); } };
    const stop = () => clearInterval(timer);
    dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));
    root.addEventListener('mouseenter', stop); root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop); root.addEventListener('focusout', start);
    let x0: number | null = null;
    root.addEventListener('touchstart', e => { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', e => { if (x0 == null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) { const rtl = document.dir === 'rtl'; show(cur + ((dx < 0) !== rtl ? 1 : -1)); start(); } x0 = null; });
    document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
    load(slides[1]);
    start();
  });
</script>
<style>
  .hero-slides { position:relative; aspect-ratio:16/10; align-self:center; margin-inline:-3%;
    -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 4%,#000 96%,transparent 100%),linear-gradient(180deg,transparent 0,#000 4%,#000 96%,transparent 100%);
    mask-image:linear-gradient(90deg,transparent 0,#000 4%,#000 96%,transparent 100%),linear-gradient(180deg,transparent 0,#000 4%,#000 96%,transparent 100%);
    -webkit-mask-composite:source-in; mask-composite:intersect; }
  .hs-slide { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0; transition:opacity 1s ease; }
  .hs-slide.is-active { opacity:1; }
  .hs-dots { position:absolute; inset-inline:0; bottom:11%; display:flex; justify-content:center; gap:6px; z-index:2; }
  .hs-dot { width:7px; height:7px; padding:0; border:0; border-radius:50%; background:#ffffff99; box-shadow:0 0 0 1px #0000002e; cursor:pointer; transition:width .25s, background .25s; }
  .hs-dot.is-active { width:20px; border-radius:5px; background:#fff; }
  .hs-dot:focus-visible { outline:2px solid var(--glacier, #9cd); outline-offset:2px; }
  :global(.hero-split .hero-grid:has(.hero-slides)) { grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr); gap:40px; }
  @media (prefers-reduced-motion: reduce) { .hs-slide { transition:none; } }
  @media (max-width:860px) { .hero-slides { margin-inline:-18px; margin-bottom:28px; } :global(.hero-split .hero-grid:has(.hero-slides)) { grid-template-columns:1fr; } }
</style>
