---
import Icon from './Icon.astro';
import CTA from './CTA.astro';
import molecules from '../data/molecules.json';
import { molDescL } from '../data/locale-info';
import { langFromPath, localePath, t, htmlLang, dir } from '../i18n';
import { locName } from '../data/locale';
interface Props { slug: string }
const { slug } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const s = t(lang);
const m = s.molecule;
const viaPubchem: string = ({ en: ', via PubChem.', fa: '، به نقل از PubChem.', zh: '（经由 PubChem）。', tr: ' (PubChem üzerinden).' } as Record<string, string>)[lang];
const L = (p: string) => localePath(p, lang);
type Mol = { name:string; cas:string; cid:number|null; formula?:string; mw?:string; iupac?:string; smiles?:string; inchikey?:string; xlogp?:number|null; hbd?:number|null; hba?:number|null; tpsa?:number|null; rotb?:number|null; synonyms?:string[]; otherCas?:string[]; description?:string; descriptionSource?:string; image?:string; parentMatch?:boolean; matched?:string };
const all = molecules as Record<string, Mol>;
const mol = all[slug];
const faDesc = lang === 'en' ? '' : molDescL[lang][slug] || '';
const title = mol.name.replace(/\bHCl\b/g, 'HCl');
const pretty = (n: string) => n.charAt(0) + n.slice(1).toLowerCase().replace(/\bhcl\b/g, 'HCl').replace(/\bdihcl\b/g, 'DiHCl');
const displayName = /[a-z]/.test(mol.name) ? mol.name : pretty(mol.name);
// formula from PubChem: keep only formula characters before adding <sub>/<sup>, so upstream data can never inject markup
const formulaHtml = String(mol.formula || '').replace(/[^A-Za-z0-9().+\-·]/g, '').replace(/(\d+)/g, '<sub>$1</sub>').replace(/([+-])$/, '<sup>$1</sup>');
const mw = mol.mw ? Number(mol.mw).toLocaleString('en-US', { maximumFractionDigits: 2 }) : '';
const stem = slug.split('-')[0];
const related = Object.entries(all).filter(([k, v]) => k !== slug && k.split('-')[0] === stem && v.cid).slice(0, 8);
const enquiry = L(`/contact-us-1?type=sourcing&product=${encodeURIComponent(mol.name)}`);
const num = (v: number | null | undefined, d = 1) => (v === null || v === undefined) ? '—' : Number(v).toLocaleString('en-US', { maximumFractionDigits: d });
const locTitle0 = lang === 'en' ? '' : (locName(lang, displayName) || locName(lang, mol.name) || '');
const locTitle = lang === 'tr' && locTitle0 ? locTitle0.charAt(0).toLocaleUpperCase('tr') + locTitle0.slice(1) : locTitle0;
const nmL = (lang !== 'en' && locTitle) ? locTitle : displayName;
const supplyH = ({ en: `${displayName} API manufacturers and suppliers`, fa: `تأمین مادهٔ مؤثرهٔ ${nmL}: تولیدکنندگان و تأمین‌کنندگان`, zh: `${nmL}原料药生产厂家与供应商`, tr: `${nmL} etkin madde üreticileri ve tedarikçileri` } as Record<string, string>)[lang];
const supplyP = ({
  en: `Hanpars sources ${displayName} API from GMP manufacturers in China, India, Türkiye and Europe for pharmaceutical companies in Iran. Each offer comes with the supplier's documentation (DMF or CEP where available, GMP certificate and certificate of analysis), and we handle import and the IFDA paperwork. Send the grade, quantity and specification you need. Manufacturers of ${displayName} who want to supply Iran are also welcome to contact us.`,
  fa: `هانیا پرسان دارو مادهٔ مؤثرهٔ ${nmL} را از تولیدکنندگان دارای GMP در چین، هند، ترکیه و اروپا برای شرکت‌های داروسازی ایران تأمین می‌کند. هر پیشنهاد همراه با مستندات تأمین‌کننده (DMF یا CEP در صورت وجود، گواهی GMP و COA) است و واردات و امور سازمان غذا و دارو با ماست. گرید، مقدار و مشخصات مورد نیاز را برای استعلام بفرستید.`,
  zh: `汉帕斯为伊朗制药企业采购${nmL}原料药，货源来自中国、印度、土耳其和欧洲的 GMP 生产厂家。每份报价均附供应商文件（如有 DMF 或 CEP、GMP 证书和分析证书 COA），进口及伊朗食品药品监督管理局（IFDA）相关手续由我们办理。欢迎${nmL}原料药生产厂家与我们联系，向伊朗市场供货。`,
  tr: `Hanpars, İran’daki ilaç şirketleri için ${nmL} etkin maddesini Çin, Hindistan, Türkiye ve Avrupa’daki GMP üreticilerinden tedarik eder. Her teklif tedarikçinin belgeleriyle (varsa DMF veya CEP, GMP sertifikası ve analiz sertifikası) gelir; ithalatı ve IFDA işlemlerini biz yürütürüz. ${nmL} üreten ve İran’a tedarik etmek isteyen üreticiler de bizimle iletişime geçebilir.`,
} as Record<string, string>)[lang];
const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const nameBoth = locTitle ? (lang === 'zh' ? `${locTitle}（${displayName}）` : `${locTitle} (${displayName})`) : displayName;
const seoNote = ({
  en: `${displayName}${mol.cas ? ' (CAS ' + mol.cas + ')' : ''}: sourcing and import of this active pharmaceutical ingredient (API) for manufacturers in Iran on request, with DMF/CEP and GMP documentation, through Haniya Parsan Darou Co. (Hanpars), importer of pharmaceutical raw materials and excipients. Availability is confirmed per enquiry.`,
  fa: `${esc(nameBoth)}${mol.cas ? '، شمارهٔ CAS <bdi lang="en" dir="ltr">' + esc(mol.cas) + '</bdi>' : ''}: تأمین و واردات مادهٔ اولیهٔ دارویی (API) ${esc(locTitle || displayName)} با مستندات DMF/CEP و GMP برای تولیدکنندگان ایرانی، در صورت استعلام؛ شرکت هانیا پرسان دارو واردکنندهٔ مواد اولیهٔ دارویی و مواد اولیهٔ جانبی (اکسیپینت) است. موجود بودن هر ماده هنگام استعلام اعلام می‌شود.`,
  zh: `${nameBoth}${mol.cas ? '，CAS号 ' + mol.cas : ''}：汉帕斯（汉尼亚帕尔桑药业有限公司）可应要求为伊朗制药企业采购和进口该原料药，并提供 DMF/CEP 和 GMP 文件；供应情况以询盘确认为准。`,
  tr: `${nameBoth}${mol.cas ? ', CAS ' + mol.cas : ''}: Bu etkin maddenin (API) İran’daki üreticiler için DMF/CEP ve GMP belgeleriyle tedariki ve ithalatı talep üzerine Haniya Parsan Darou Co. (Hanpars) aracılığıyla yapılır; temin durumu her talepte teyit edilir.`,
} as Record<string, string>)[lang];

---
<section class="hero page-hero mol-hero"><div class="container mol-grid">
  <div class="hero-main">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={L('/')}>{s.breadcrumbHome}</a><span aria-hidden="true">/</span><a href={L('/api')}>{m.range}</a><span aria-hidden="true">/</span><span lang="en" dir="ltr">{displayName}</span></nav>
    <p class="ph-badges"><span class="ph-badge">{m.kicker}</span></p>
    <h1>{locTitle ? <><span lang={htmlLang[lang]} dir={dir(lang)}>{locTitle}</span><span class="h1-en" lang="en" dir="ltr">{displayName}</span></> : <span lang="en" dir="ltr">{displayName}</span>}</h1>
    <dl class="mol-keyfacts">
      {mol.cas && <div><dt>{m.cas}</dt><dd lang="en" dir="ltr">{mol.cas}</dd></div>}
      {mol.formula && <div><dt>{m.formula}</dt><dd lang="en" dir="ltr" set:html={formulaHtml}/></div>}
      {mw && <div><dt>{m.mw}</dt><dd lang="en" dir="ltr">{mw} g/mol</dd></div>}
    </dl>
    <div class="hero-actions"><a class="button button-light" href={enquiry}>{m.enquire}</a><a class="text-link" href={L('/api')}>{m.back}</a></div>
    <p class="prod-seo-note" lang={htmlLang[lang]} dir={dir(lang)} set:html={lang === 'fa' ? seoNote : esc(seoNote)} />
  </div>
  <figure class="mol-structure">{mol.image ? <img src={mol.image} alt={`${displayName} — 2D structure`} width="320" height="320" loading="eager" decoding="async"/> : <div class="mol-nostructure">{m.noStructure}</div>}<figcaption>{m.structureCaption}</figcaption></figure>
</div></section>

{(mol.cid || mol.description) && <section class="section"><div class="container mol-body">
  <div class="mol-main api-main">
    {(faDesc || mol.description) && <section class="pd-sec pd-moa mol-about"><h2><span class="pd-ico"><Icon name="molecule" size={18}/></span>{m.about}</h2>{faDesc ? <p>{faDesc}</p> : <p lang="en" dir="ltr">{mol.description}</p>}{mol.descriptionSource && <p class="form-hint">{m.source}: {mol.descriptionSource}{viaPubchem}</p>}</section>}
    {mol.parentMatch && <p class="archive-note">{m.parentNote(mol.matched || '')}</p>}
    <section class="pd-sec mol-supply"><h2><span class="pd-ico"><Icon name="globe" size={18}/></span>{supplyH}</h2><p>{supplyP}</p></section>
    <section class="pd-sec api-ids"><h2><span class="pd-ico"><Icon name="file" size={18}/></span>{m.identifiers}</h2>
    <dl class="mol-table">
      {mol.iupac && <div><dt>{m.iupac}</dt><dd lang="en" dir="ltr" class="mol-wrap">{mol.iupac}</dd></div>}
      {mol.inchikey && <div><dt>InChIKey</dt><dd lang="en" dir="ltr" class="mol-mono">{mol.inchikey}</dd></div>}
      {mol.smiles && <div><dt>SMILES</dt><dd lang="en" dir="ltr" class="mol-mono mol-wrap">{mol.smiles}</dd></div>}
      {mol.otherCas && mol.otherCas.length > 0 && <div><dt>{m.otherCas}</dt><dd lang="en" dir="ltr">{mol.otherCas.join(' · ')}</dd></div>}
      {mol.cid && <div><dt>PubChem CID</dt><dd lang="en" dir="ltr"><a class="text-link" href={`https://pubchem.ncbi.nlm.nih.gov/compound/${mol.cid}`} target="_blank" rel="noopener noreferrer">{mol.cid}</a></dd></div>}
    </dl></section>
    {mol.synonyms && mol.synonyms.length > 0 && <section class="pd-sec"><h2><span class="pd-ico"><Icon name="layers" size={18}/></span>{m.synonyms}</h2><ul class="mol-syn-chips">{mol.synonyms.map(x => <li lang="en" dir="ltr">{x}</li>)}</ul></section>}
  </div>
  <aside class="mol-aside">
    <h3>{m.properties}</h3>
    <dl class="mol-props">
      <div><dt>XLogP</dt><dd dir="ltr" lang="en">{num(mol.xlogp)}</dd></div>
      <div><dt>TPSA</dt><dd dir="ltr" lang="en">{num(mol.tpsa)} Å²</dd></div>
      <div><dt>{m.hbd}</dt><dd dir="ltr" lang="en">{num(mol.hbd, 0)}</dd></div>
      <div><dt>{m.hba}</dt><dd dir="ltr" lang="en">{num(mol.hba, 0)}</dd></div>
      <div><dt>{m.rotb}</dt><dd dir="ltr" lang="en">{num(mol.rotb, 0)}</dd></div>
    </dl>
    <p class="form-hint">{m.propsNote}</p>
    <h3>{m.sourcing}</h3>
    <ul class="check-list mol-checks">{m.sourcingPoints.map(p => <li>{p}</li>)}</ul>
    <a class="button button-navy" href={enquiry}>{m.enquire}</a>
  </aside>
</div></section>}

{related.length > 0 && <section class="section section-paper section-tight"><div class="container">
  <div class="section-head"><h2>{m.related}</h2></div>
  <ul class="link-list" lang="en" dir="ltr">{related.map(([k, v]) => <li><a href={L(`/api/${k}`)}>{/[a-z]/.test(v.name) ? v.name : pretty(v.name)}<small>{v.cas}</small></a></li>)}</ul>
</div></section>}

<section class="section-tight"><div class="container"><p class="reference-note">{m.note}</p></div></section>
<CTA title={m.ctaTitle} />
