---
import Icon from './Icon.astro';
import rowsEn from '../data/supplements.json';
import supZh from '../data/supplements.zh.json';
import { langFromPath, localePath, t } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const locSup: Record<string, Record<string, { name?: string; category?: string; forms?: string; use?: string }>> = { zh: supZh as any };
const rows = rowsEn.map(r => { const z = locSup[lang]?.[r.name]; return { ...r, loc: z?.name || '', category: z?.category || r.category, forms: z?.forms || r.forms, use: z?.use || r.use }; });
const localized = !!locSup[lang] && Object.keys(locSup[lang]).length > 0;
const s = t(lang).supplements;
const c = t(lang).catalogue;
const L = (p: string) => localePath(p, lang);
const total = rows.length.toLocaleString('en-US');
const groups: [string, string][] = [['', s.all], ['vitamins', s.g.vitamins], ['minerals', s.g.minerals], ['lipids', s.g.lipids], ['amino-protein', s.g.amino], ['gut', s.g.gut], ['botanicals', s.g.botanicals], ['nutraceuticals', s.g.nutraceuticals], ['blends-formats', s.g.blends]];
const i18n = JSON.stringify({ inList: c.inList, matching: c.matching, none: c.none, showing: c.showingTpl });
---
<div class="catalogue-panel claims-panel" id="ingredients" data-catalogue data-page-size="30" data-i18n={i18n} style="scroll-margin-top:40px">
  <div class="catalogue-toolbar"><div><h2>{s.title}</h2><p class="catalogue-count"><span data-filter-count>{total}</span> {s.entries} <span data-count-suffix>{c.inList}</span></p></div><label class="search-input"><Icon name="search" size={18}/><input type="search" placeholder={s.search} aria-label={s.search} data-catalogue-search autocomplete="off"/></label></div>
  <div class="claims-filters" role="group" aria-label={s.filterLabel}>{groups.map(([id, label]) => <button type="button" data-catalogue-filter={id} aria-pressed={id === '' ? 'true' : 'false'}>{label}</button>)}</div>
  <div class="catalogue-scroll" tabindex="0" role="region" aria-label={s.title}>
    <table class="catalogue-table claims-table" lang={localized ? undefined : "en"} dir={localized ? undefined : "ltr"}><thead><tr><th scope="col">{s.ingredient}</th><th scope="col">{s.category}</th><th scope="col">{s.forms}</th><th scope="col">{s.use}</th><th scope="col">{c.enquiry}</th></tr></thead><tbody>{rows.map((row,index)=><tr data-catalogue-row data-status={row.group} data-search={`${row.name} ${row.loc} ${row.category} ${row.forms} ${row.use}`.toLowerCase()} data-index={index}><td class="claims-substance"><span lang="en" dir="ltr">{row.name}</span>{row.loc && <span class="cat-loc">{row.loc}</span>}</td><td class="claims-rel">{row.category}</td><td class="claims-claim">{row.forms}</td><td class="claims-rel">{row.use}</td><td><a class="table-request" href={L(`/contact-us-1?type=sourcing&product=${encodeURIComponent(row.name)}`)} aria-label={`${c.enquire}: ${row.name}`}>{c.enquire}</a></td></tr>)}</tbody></table>
    <div class="catalogue-empty" data-catalogue-empty hidden>{c.empty} <a class="text-link" href={L('/contact-us-1?type=sourcing')}>{c.askDirect}</a>.</div>
  </div>
  <div class="catalogue-foot"><span aria-live="polite" data-catalogue-status>{c.allAvailable(total)}</span><div class="catalogue-pager" data-catalogue-pager hidden><button type="button" data-catalogue-prev>{c.prev}</button><span data-page-label></span><button type="button" data-catalogue-next>{c.next}</button></div></div>
</div>
<p class="reference-note">{s.note}</p>
