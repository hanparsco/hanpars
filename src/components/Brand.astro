---
import { langFromPath, localePath } from '../i18n';
interface Props { variant?: 'default' | 'regulatory' }
const { variant = 'default' } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const regulatory = variant === 'regulatory';
---
<a href={localePath('/', lang)} class:list={['brand', { 'brand-regulatory': regulatory }]} aria-label={regulatory ? 'Hanpars Regulatory — home' : 'Hanpars home'}>
  {regulatory
    ? <img src="/brand/hanpars-regulatory-light.png" alt="Hanpars Regulatory" width="811" height="539" class="original-logo" />
    : <img src="/brand/hanpars-logo-transparent.png" alt="Hanpars" width="222" height="123" class="original-logo" />}
</a>
