---
import PageHero from './PageHero.astro';
import CTA from './CTA.astro';
import NewsCard from './NewsCard.astro';
import news from '../data/news.json';
import newsFa from '../data/news-fa.json';
import newsZh from '../data/news-zh.json';
import { langFromPath, localePath, t, dateLocale } from '../i18n';
const lang = langFromPath(Astro.url.pathname);
const s = t(lang).news;
const L = (p: string) => localePath(p, lang);
type Story = { title:string; url:string; source:string; date:string; summary:string; image:string };
const isFa = lang === 'fa';
const isLocal = isFa || lang === 'zh';
const localItems = ((isFa ? newsFa.items : lang === 'zh' ? newsZh.items : []) || []) as Story[];
const global = isLocal ? localItems : (news.global || []) as Story[];
const china = isLocal ? [] : (news.china || []) as Story[];
const fmt = (d: string) => d ? new Date(d + 'T00:00:00Z').toLocaleDateString(dateLocale(lang), { day:'numeric', month:'long', year:'numeric', timeZone:'UTC' }) : '';
const upd = isFa ? newsFa.updated : lang === 'zh' ? newsZh.updated : news.updated;
const newest = isLocal && localItems.length ? localItems.map(i => i.date).sort().slice(-1)[0] : '';
const updated = upd ? (isLocal ? new Date((newest || upd.slice(0, 10)) + 'T00:00:00Z').toLocaleDateString(dateLocale(lang), { day:'numeric', month:'long', year:'numeric', timeZone:'UTC' }) : new Date(upd).toLocaleDateString(dateLocale(lang), { day:'numeric', month:'long', year:'numeric', timeZone:'Asia/Tehran' })) : '';
---
<PageHero title={s.title} category={s.category} description={updated ? s.lede(updated) : s.ledeEmpty} action={s.action} href="/blog-1"/>

<section class="section" id="global"><div class="container">
  <div class="section-head"><h2>{s.globalTitle}</h2>{lang !== 'fa' && <p class="lede">{s.globalLede}</p>}</div>
  {global.length ? <div class="news-grid">{global.map((item, i) => <NewsCard item={item} eager={i===0} fa={isFa}/>)}</div> : <p class="archive-note">{s.empty}</p>}
</div></section>

{!isLocal && <section class="section section-navy" id="china"><div class="container">
  <div class="section-head"><div><p class="kicker kicker-light">{s.chinaKicker}</p><h2>{s.chinaTitle}</h2></div></div>
  {china.length ? <div class="news-grid">{china.map(item => <NewsCard item={item} dark/>)}</div> : <p class="archive-note archive-note-dark">{s.empty}</p>}
</div></section>}

<section class="section-tight"><div class="container"><p class="reference-note">{s.note} <a class="text-link" href={L('/blog-1')}>{s.archiveLink}</a></p></div></section>
<CTA />
