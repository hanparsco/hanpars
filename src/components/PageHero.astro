---
import Icon from './Icon.astro';
interface Props { category?: string; title: string; description: string; action?: string; href?: string; dark?: boolean; }
const { category = 'HANPARS', title, description, action = 'Start an enquiry', href = '/contact-us-1', dark = false } = Astro.props;
---
<section class:list={['page-hero', { 'page-hero-dark': dark }]}>
  <div class="container"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>{category}</span></div><div class="page-hero-inner"><div><span class="eyebrow">{category.toUpperCase()}</span><h1>{title}</h1><p>{description}</p></div><a class:list={['button', dark ? 'button-sky' : 'button-navy']} href={href} target={href.startsWith('https://')?'_blank':undefined} rel={href.startsWith('https://')?'noopener noreferrer':undefined}>{action}<Icon name="diagonal" size={18}/></a></div></div>
</section>
