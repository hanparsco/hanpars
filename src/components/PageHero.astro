---
interface Props { category?: string; title: string; description: string; action?: string; href?: string; dark?: boolean; }
const { category = 'Hanpars', title, description, action = 'Start an enquiry', href = '/contact-us-1', dark = false } = Astro.props;
const external = href.startsWith('https://');
---
<section class:list={['page-hero', { 'page-hero-dark': dark }]}>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>{category}</span></nav>
    <div class="page-hero-inner">
      <div><h1>{title}</h1><p class="lede">{description}</p></div>
      <a class:list={['button', dark ? 'button-light' : 'button-navy']} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{action}</a>
    </div>
    <slot />
  </div>
</section>
