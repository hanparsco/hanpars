---
import Icon from './Icon.astro';
import { chinaIran } from '../data/china-iran';
import { langFromPath, localePath } from '../i18n';
const lang = langFromPath(Astro.url.pathname) as 'en' | 'zh';
const c = chinaIran[lang] || chinaIran.en;
const L = (p: string) => localePath(p, lang);
const num = (i: number) => String(i + 1).padStart(2, '0');
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const factIcons = ['clock', 'file', 'box', 'shield', 'capsule', 'globe'];
---
<section class="section gd-quick-sec">
  <div class="container">
    <div class="gd-quick"><span class="gd-ico"><Icon name="check" size={22} /></span><div><p class="gd-kicker">{c.kicker} · {c.quickTitle}</p><p class="gd-quick-text">{c.quick}</p></div></div>
  </div>
</section>

<section class="section gd-intro-sec">
  <div class="container gd-grid">
    <h2>{c.introTitle}</h2>
    <div class="gd-copy">{c.intro.map(p => <p>{p}</p>)}</div>
  </div>
</section>

<section class="section section-paper">
  <div class="container">
    <div class="section-head"><h2>{c.routesTitle}</h2></div>
    <div class="gd-routes">{c.routes.map(r => <article class="gd-route"><h3>{r.title}</h3><p>{r.text}</p><ol>{r.steps.map((s, i) => <li><span aria-hidden="true">{num(i)}</span>{s}</li>)}</ol></article>)}</div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><h2>{c.docsTitle}</h2><p class="lede">{c.docsLede}</p></div>
    <div class="gd-docs">{c.docs.map(d => <div class="gd-doc"><h3>{d.title}</h3><ul>{d.items.map(it => <li><Icon name="check" size={17} class="gd-check" /><span>{it}</span></li>)}</ul></div>)}</div>
  </div>
</section>

<section class="section gd-band">
  <div class="container">
    <div class="section-head"><h2>{c.factsTitle}</h2></div>
    <div class="gd-facts">{c.facts.map((f, i) => <article><span class="gd-ico gd-ico-dark"><Icon name={factIcons[i]} size={20} /></span><h3>{f.title}</h3><p>{f.text}</p></article>)}</div>
  </div>
</section>

<section class="section">
  <div class="container gd-two">
    <div class="gd-col"><h3>{c.mistakesTitle}</h3><ul>{c.mistakes.map(m => <li><Icon name="close" size={16} class="gd-x" /><span>{m}</span></li>)}</ul></div>
    <div class="gd-col gd-col-accent"><h3>{c.roleTitle}</h3><ul>{c.role.map(r => <li><Icon name="check" size={17} class="gd-check" /><span>{r}</span></li>)}</ul></div>
  </div>
</section>

<section class="section section-paper">
  <div class="container gd-faq-grid">
    <h2>{c.faqTitle}</h2>
    <div class="gd-faq">{c.faq.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
  </div>
</section>

<section class="section">
  <div class="container gd-cta">
    <p>{c.ctaNote}</p>
    <a class="button button-navy" href={L('/contact-us-1?type=regulatory')}>{c.cta}<Icon name="arrow" size={17} class="gd-arrow" /></a>
  </div>
  <div class="container gd-sources"><strong>{c.sourcesTitle}</strong><ul>{c.sources.map(s => <li>{s.url.startsWith('/') ? <a class="text-link" href={L(s.url)}>{s.label}</a> : <a class="text-link" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>}</li>)}</ul></div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<style>
  .gd-quick-sec { padding-bottom:0; }
  .gd-quick { display:flex; gap:18px; align-items:flex-start; padding:26px 28px; border-radius:20px; background:var(--paper); border:1px solid var(--line); }
  .gd-kicker { margin:0 0 8px; font:600 13px/1.4 var(--sans); letter-spacing:.08em; text-transform:uppercase; color:var(--lapis); }
  :global(html[lang^=zh]) .gd-kicker { letter-spacing:0; text-transform:none; font-size:14px; }
  .gd-quick-text { margin:0; font-size:18px; line-height:1.6; }
  .gd-ico { display:inline-grid; place-items:center; width:42px; height:42px; flex:none; border-radius:12px; background:var(--glacier-soft); color:var(--lapis-deep); }
  .gd-ico-dark { background:#ffffff14; color:var(--glacier); }
  .gd-grid { display:grid; grid-template-columns:minmax(0,5fr) minmax(0,7fr); gap:clamp(28px,5vw,72px); align-items:start; }
  .gd-copy p { font-size:18px; } .gd-copy p:last-child { margin-bottom:0; color:var(--muted); }
  .gd-routes { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; }
  .gd-route { padding:28px; border-radius:20px; background:var(--white); border:1px solid var(--line); }
  .gd-route p { color:var(--muted); } .gd-route ol { list-style:none; padding:16px 0 0; margin:0; display:grid; gap:10px; border-top:1px solid var(--line); }
  .gd-route li { display:flex; gap:12px; align-items:baseline; line-height:1.5; } .gd-route li span { font:600 13px/1 var(--display); color:var(--lapis); min-width:22px; }
  .gd-docs { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; }
  .gd-doc { padding:26px; border-radius:20px; background:var(--paper); border:1px solid var(--line); }
  .gd-doc h3 { margin-bottom:14px; } .gd-doc ul, .gd-col ul { list-style:none; padding:0; margin:0; display:grid; gap:10px; } .gd-doc li, .gd-col li { display:flex; gap:10px; align-items:flex-start; line-height:1.5; }
  .gd-check { flex:none; margin-top:4px; color:var(--lapis); } .gd-x { flex:none; margin-top:5px; color:#b4532f; }
  .gd-band { background:var(--black); color:var(--on-navy); } .gd-band h2, .gd-band h3 { color:#fff; }
  .gd-facts { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:22px; }
  .gd-facts article { display:flex; flex-direction:column; gap:10px; padding-top:18px; border-top:1px solid #ffffff2e; }
  .gd-facts h3 { font-size:18px; } .gd-facts p { margin:0; font-size:15.5px; line-height:1.55; color:var(--on-navy-muted); }
  .gd-two { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20px; }
  .gd-col { padding:28px; border-radius:20px; border:1px solid var(--line); background:var(--white); } .gd-col-accent { background:var(--paper); } .gd-col h3 { margin-bottom:14px; }
  .gd-faq-grid { display:grid; grid-template-columns:minmax(0,4fr) minmax(0,8fr); gap:clamp(24px,4vw,56px); align-items:start; }
  .gd-faq details { border-top:1px solid var(--line); padding:16px 0; } .gd-faq details:last-child { border-bottom:1px solid var(--line); }
  .gd-faq summary { cursor:pointer; font-weight:600; font-size:17px; list-style:none; display:flex; justify-content:space-between; gap:16px; } .gd-faq summary::after { content:'+'; color:var(--lapis); } .gd-faq details[open] summary::after { content:'–'; }
  .gd-faq p { margin:12px 0 0; color:var(--muted); line-height:1.6; max-width:70ch; }
  .gd-cta { display:flex; justify-content:space-between; align-items:center; gap:24px; padding:28px; border-radius:22px; background:var(--paper); border:1px solid var(--line); } .gd-cta p { margin:0; font-size:17px; }
  .gd-arrow { margin-inline-start:10px; }
  .gd-sources { margin-top:28px; font-size:15px; color:var(--muted); } .gd-sources ul { list-style:none; padding:0; margin:8px 0 0; display:flex; flex-wrap:wrap; gap:8px 22px; }
  @media (max-width:860px) { .gd-grid, .gd-routes, .gd-docs, .gd-two, .gd-faq-grid { grid-template-columns:1fr; } .gd-facts { grid-template-columns:repeat(2,minmax(0,1fr)); } .gd-cta { flex-direction:column; align-items:flex-start; } }
  @media (max-width:640px) { .gd-facts { grid-template-columns:1fr; } .gd-quick, .gd-route, .gd-doc, .gd-col, .gd-cta { padding:22px; } .gd-quick-text, .gd-copy p { font-size:17px; } }
</style>
