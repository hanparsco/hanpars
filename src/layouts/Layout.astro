---
import { verification } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langFromPath, stripLang, localePath, dir, langs, htmlLang, hreflangOf, ogLocale, t, type Lang } from '../i18n';
import '../styles/global.css';
interface Props { title?: string; description?: string; noindex?: boolean; brand?: 'default' | 'regulatory'; schema?: Record<string, unknown>[]; breadcrumbs?: { name: string; path: string }[]; canonicalPath?: string; ogType?: string; image?: string; onlyLang?: Lang; skipLangs?: Lang[]; keywords?: string; }
const lang = langFromPath(Astro.url.pathname);
const rtl = lang === 'fa';
const defaults = {
  en: { title: 'Hanpars | Pharmaceutical sourcing and regulatory affairs, Tehran', description: 'Hanpars imports active ingredients, finished medicines, excipients and nutrition ingredients for Iran and prepares their IFDA registration. Based in Tehran.' },
  zh: { title: '汉帕斯 | 伊朗药品进口、原料药供应与药品注册服务（德黑兰）', description: '汉帕斯（汉尼亚帕尔桑药业有限公司）为伊朗市场进口原料药、制剂、药用辅料和营养原料，并负责伊朗食品药品监督管理局（IFDA）注册。总部位于德黑兰。' },
  tr: { title: 'Hanpars | İran’a ilaç ithalatı, etkin madde tedariki ve ruhsatlandırma, Tahran', description: 'Hanpars (Haniya Parsan Darou), İran pazarı için etkin madde, bitmiş ürün, yardımcı madde ve besin takviyesi hammaddeleri ithal eder ve İran Gıda ve İlaç Kurumu (IFDA) nezdinde ruhsat başvurularını hazırlar. Merkez: Tahran.' },
  fa: { title: 'هانیا پرسان دارو | واردات دارو، مواد اولیهٔ دارویی و امور رگولاتوری', description: 'هانیا پرسان دارو مواد مؤثره، فرآورده‌های دارویی، مواد جانبی و مواد اولیهٔ غذایی و مکمل را برای ایران وارد می‌کند و ثبت آن‌ها در سازمان غذا و دارو را انجام می‌دهد. مستقر در تهران.' },
};
const { title = defaults[lang].title, description = defaults[lang].description, noindex = false, brand = 'default', schema = [], breadcrumbs = [], canonicalPath, ogType = 'website', image, onlyLang, skipLangs = [], keywords } = Astro.props;
const site = Astro.site ?? new URL('https://hanpars.com');
const socialImage = new URL(image || '/brand/hanpars-logo-transparent.png', site).href;
const cleanPathEarly = (p: string) => (p.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/');
const basePath = stripLang(Astro.url.pathname);
const isEnHome = lang === 'en' && cleanPathEarly(Astro.url.pathname) === '/';
const cleanPath = (p: string) => (p.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/');
const canonical = new URL(cleanPath(canonicalPath || Astro.url.pathname), site).href;
const siteName = rtl ? 'هانیا پرسان دارو' : lang === 'zh' ? '汉帕斯' : 'Hanpars';
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', '@id': `${site.origin}/#organization`,
  name: rtl ? 'شرکت هانیا پرسان دارو' : lang === 'zh' ? '汉尼亚帕尔桑药业有限公司' : 'Haniya Parsan Darou Co.', alternateName: ['Hanpars', 'HANPARS', 'هانیا پرسان دارو', 'Haniya Parsan Darou', 'Haniya Parsan Darou Co.', '汉帕斯', '汉尼亚帕尔桑药业有限公司', 'Hanpars İran'],
  description: lang === 'zh' ? '汉帕斯 是位于伊朗德黑兰、持有 IFDA 进口许可的药品进口商和注册持有人：进口制剂、原料药、药用辅料和营养原料，自有团队负责 IFDA 注册与药物警戒；杭州、镇江设有办公室，伊斯坦布尔设有合作办公室。' : lang === 'tr' ? 'Hanpars, Tahran merkezli, IFDA lisanslı ilaç ithalatçısı ve ruhsat sahibidir: bitmiş ürün, etkin madde, yardımcı madde ve takviye hammaddesi ithal eder; ruhsatlandırma ve farmakovijilansı kendi ekibiyle yürütür. İstanbul’da ortak ofis.' : lang === 'fa' ? 'هانیا پرسان دارو واردکنندهٔ دارای مجوز سازمان غذا و دارو و دارندهٔ پروانهٔ فرآورده‌های وارداتی در تهران است؛ فرآورده‌های دارویی، مواد مؤثره، مواد جانبی و مواد اولیهٔ مکمل را وارد و ثبت می‌کند.' : 'Hanpars is an IFDA-licensed pharmaceutical importer and marketing authorisation holder in Tehran, Iran: it imports finished medicines, APIs, excipients and supplement ingredients, registers them with the Iran Food and Drug Administration with its own regulatory team, and works with foreign manufacturers through offices in Hangzhou and Zhenjiang (China) and a partner office in Istanbul (Türkiye).',
  areaServed: { '@type': 'Country', name: 'Iran' },
  knowsAbout: ['Pharmaceutical import into Iran', 'IFDA drug registration', 'IRC code', 'Active pharmaceutical ingredients sourcing', 'Finished dosage forms', 'Excipients', 'Pharmacovigilance', 'Licensed manufacturing in Iran', 'China–Iran pharmaceutical trade', 'Türkiye–Iran pharmaceutical trade'],
  knowsLanguage: ['fa', 'en', 'zh', 'tr'],
  location: [{ '@type': 'Place', name: 'Hanpars Tehran head office', address: { '@type': 'PostalAddress', addressLocality: 'Tehran', addressCountry: 'IR' } }, { '@type': 'Place', name: 'Hanpars Hangzhou office', address: { '@type': 'PostalAddress', addressLocality: 'Hangzhou', addressCountry: 'CN' } }, { '@type': 'Place', name: 'Hanpars Zhenjiang exclusive wholesaler office', address: { '@type': 'PostalAddress', addressLocality: 'Zhenjiang', addressCountry: 'CN' } }, { '@type': 'Place', name: 'Hanpars Istanbul partner office', address: { '@type': 'PostalAddress', addressLocality: 'Istanbul', addressCountry: 'TR' } }],
  url: site.origin, logo: new URL('/brand/hanpars-logo-transparent.png', site).href, email: 'contact@hanpars.com', ...(rtl ? {} : { telephone: '+98-21-8888-3325' }), sameAs: ['https://www.linkedin.com/company/hanpars/', 'https://t.me/hanpars'],
  ...(rtl ? {} : { address: { '@type': 'PostalAddress', streetAddress: rtl ? 'بلوار آفریقا، خیابان ظفر، پلاک ۳۲۶، طبقهٔ سوم' : '3rd floor, No. 326, Zafar Street, Africa Boulevard', addressLocality: rtl ? 'تهران' : 'Tehran', postalCode: '1968734974', addressCountry: 'IR' } }),
  contactPoint: [{ '@type': 'ContactPoint', ...(rtl ? {} : { telephone: '+98-21-8888-3325' }), email: 'contact@hanpars.com', contactType: 'sales', availableLanguage: ['fa', 'en', 'zh', 'tr'] }, { '@type': 'ContactPoint', url: `${site.origin}/contact-us-1?type=regulatory`, contactType: 'regulatory affairs', availableLanguage: ['fa', 'en', 'zh', 'tr'] }],
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site.origin}/#website`, url: site.origin, name: siteName, inLanguage: hreflangOf[lang], publisher: { '@id': `${site.origin}/#organization` } };
const crumbs = breadcrumbs.length ? { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.path, site).href })) } : null;
const ldBlocks = [org, website, ...(crumbs ? [crumbs] : []), ...schema];
const altEn = new URL(cleanPath(basePath), site).href;
const alternates = langs.filter(l => (!onlyLang || l === onlyLang) && !skipLangs.includes(l)).map(l => ({ l, href: new URL(cleanPath(localePath(cleanPath(basePath), l)), site).href }));
---
<!doctype html>
<html lang={htmlLang[lang]} dir={dir(lang)}>
  <head>
    {isEnHome && <script is:inline set:html={`(function(){try{var p=null;try{p=localStorage.getItem('hp-lang')}catch(e){}
if(p){if(p!=='en')location.replace('/'+p+location.search+location.hash);return}
if(/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent))return;
var tz=(Intl.DateTimeFormat().resolvedOptions().timeZone||'');var t=null;
if(/^Asia\\/(Shanghai|Chongqing|Chungking|Harbin|Urumqi|Kashgar)$/.test(tz)||tz==='PRC')t='zh';
else if(tz==='Europe/Istanbul'||tz==='Asia/Istanbul'||tz==='Turkey')t='tr';
else if(tz==='Asia/Tehran'||tz==='Iran')t='fa';
if(t)location.replace('/'+t+location.search+location.hash)}catch(e){}})();`} />}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="theme-color" content="#141414" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {langs.filter(l => l !== lang).map(l => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={canonical} />
    {!noindex && alternates.map(a => <link rel="alternate" hreflang={hreflangOf[a.l]} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={altEn} />}
    {ldBlocks.map(b => <script type="application/ld+json" set:html={JSON.stringify(b)} />)}
    <link rel="icon" href="/brand/hanpars-logo-transparent.png" type="image/png" />
    {(lang === 'en' || lang === 'tr') && <link rel="preload" href="/fonts/sora/Sora-SemiBold.woff2" as="font" type="font/woff2" crossorigin />}
    {(lang === 'en' || lang === 'tr') && <link rel="preload" href="/fonts/inter/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />}
    {lang === 'zh' && <meta http-equiv="Content-Language" content="zh-CN" />}
    {lang === 'zh' && <link rel="stylesheet" href="/fonts/noto-sc/noto-sc.css" />}
    {lang === 'zh' && <meta name="applicable-device" content="pc,mobile" />}
    {lang === 'zh' && <meta http-equiv="Cache-Control" content="no-transform" />}
    {verification.baidu && <meta name="baidu-site-verification" content={verification.baidu} />}
    {verification.bing && <meta name="msvalidate.01" content={verification.bing} />}
    {verification.so360 && <meta name="360-site-verification" content={verification.so360} />}
    {verification.sogou && <meta name="sogou_site_verification" content={verification.sogou} />}
    {rtl && <link rel="preload" href="/fonts/narengi/NarengiNonEn-Regular.woff2" as="font" type="font/woff2" crossorigin />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(lang).skip}</a>
    <Header brand={brand} />
    <main id="main-content" class:list={[{ 'hanpars-zh-hans': lang === 'zh' }]}><slot /></main>
    <Footer brand={brand} />
    <script>import '../scripts/site';</script>
  </body>
</html>
