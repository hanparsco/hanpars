---
import Layout from '../../../layouts/Layout.astro';
import AzIndex from '../../../components/AzIndex.astro';
import { azPaths } from '../../../data/az';
export function getStaticPaths() { return azPaths('fdf'); }
const { letter } = Astro.params;
const label = letter === '0-9' ? '0–9' : String(letter).toUpperCase();
---
<Layout noindex title={`Finished products A–Z: ${label} | Hanpars`} description={`Finished product reference list, entries starting with ${label}`}><AzIndex type="fdf" letter={letter!} /></Layout>
