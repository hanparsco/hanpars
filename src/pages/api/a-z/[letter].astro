---
import Layout from '../../../layouts/Layout.astro';
import AzIndex from '../../../components/AzIndex.astro';
import { azPaths } from '../../../data/az';
export function getStaticPaths() { return azPaths('api'); }
const { letter } = Astro.params;
const label = letter === '0-9' ? '0–9' : String(letter).toUpperCase();
---
<Layout noindex title={`Active ingredients A–Z: ${label} | Hanpars`} description={`Active pharmaceutical ingredients starting with ${label}`}><AzIndex type="api" letter={letter!} /></Layout>
