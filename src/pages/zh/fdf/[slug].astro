---
import { fdfHasInfo } from '../../../data/fdf-hasinfo';
import Layout from '../../../layouts/Layout.astro';
import ProductPage from '../../../components/ProductPage.astro';
import fdf from '../../../data/fdf.json';
import info from '../../../data/fdf-info.json';
import { infoL } from '../../../data/locale-info';
import { fdfSlug } from '../../../data/fdf-parse';
import { productSeo } from '../../../data/seo-schema';
import { t } from '../../../i18n';
export function getStaticPaths() {
  return (fdf as { name: string; code: string }[]).map(entry => ({ params: { slug: fdfSlug(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
const lang = 'zh' as const;
const s = t(lang);
const seo = productSeo(entry, lang, info as any, infoL[lang] as any);
const fdfName = s.groups[0].items[0].label;
const crumbs = [{ name: s.breadcrumbHome, path: '/zh' }, { name: fdfName, path: '/zh/fdf' }, { name: seo.nameFa || seo.name, path: '/zh/fdf/' + fdfSlug(entry) }];
---
<Layout noindex={!fdfHasInfo(entry)} title={seo.title} description={seo.description} keywords={seo.keywords} schema={[seo.schema]} breadcrumbs={crumbs} ogType="product"><ProductPage entry={entry} /></Layout>
