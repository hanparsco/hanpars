---
import Layout from '../../../layouts/Layout.astro';
import MoleculePage from '../../../components/MoleculePage.astro';
import molecules from '../../../data/molecules.json';
import { molDescL } from '../../../data/locale-info';
import { moleculeSeo, canonicalMolecule } from '../../../data/seo-schema';
import { t } from '../../../i18n';
export function getStaticPaths() {
  return Object.keys(molecules).map(slug => ({ params: { slug } }));
}
const { slug } = Astro.params;
const lang = 'zh' as const;
const s = t(lang);
const mol = (molecules as Record<string, any>)[slug!];
const desc = molDescL[lang][slug!] || '';
const seo = moleculeSeo(slug!, mol, lang, desc);
const primary = canonicalMolecule(slug!, molecules as any);
const isDup = primary !== slug;
const crumbs = [{ name: s.breadcrumbHome, path: '/zh' }, { name: s.groups[0].items[1].label, path: '/zh/api' }, { name: seo.nameFa || seo.name, path: '/zh/api/' + slug }];
---
<Layout title={seo.title} description={seo.description} keywords={seo.keywords} noindex={isDup} canonicalPath={isDup ? `/zh/api/${primary}` : undefined} schema={seo.schema ? [seo.schema] : []} breadcrumbs={crumbs} image={mol.image || undefined}><MoleculePage slug={slug!} /></Layout>
