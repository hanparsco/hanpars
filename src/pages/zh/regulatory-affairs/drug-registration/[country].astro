---
import Layout from '../../../../layouts/Layout.astro';
import RaServicePage from '../../../../components/RaServicePage.astro';
import { raUi } from '../../../../data/ra-services';
import { raCountries, raCountryBySlug, raRegHub } from '../../../../data/ra-countries';
export function getStaticPaths() { return raCountries.map(s => ({ params: { country: s.slug } })); }
const svc = raCountryBySlug[Astro.params.country!];
const c = svc.t.zh;
const crumbs = [{ name: '首页', path: '/zh' }, { name: raUi.zh.crumb, path: '/zh/regulatory-affairs' }, { name: raRegHub.zh.nav, path: '/zh/regulatory-affairs/drug-registration' }, { name: c.nav, path: '/zh/regulatory-affairs/drug-registration/' + svc.slug }];
---
<Layout title={c.metaTitle} description={c.metaDesc} breadcrumbs={crumbs} brand="regulatory">
  <RaServicePage service={svc}/>
</Layout>
