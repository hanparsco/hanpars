---
import Layout from '../../layouts/Layout.astro';
import StandardPage from '../../components/StandardPage.astro';
import RegulatoryPage from '../../components/RegulatoryPage.astro';
import ContactPage from '../../components/ContactPage.astro';
import InsightsPage from '../../components/InsightsPage.astro';
import ImportActivityPage from '../../components/ImportActivityPage.astro';
import NewsPage from '../../components/NewsPage.astro';
import { pages, type PageKey } from '../../data/pages';
import { pagesL } from '../../data/locale';
import { pageKeywords } from '../../data/seo-keywords';
import { t } from '../../i18n';

export function getStaticPaths() {
  return [...Object.keys(pages), 'regulatory-affairs', 'contact-us-1', 'blog-1', 'news', 'import-activity'].map(page=>({params:{page}}));
}
const lang = 'zh' as const;
const s = t(lang);
const page = Astro.params.page!;
const data = (pagesL[lang] as any)[page as PageKey];
const extra: Record<string, { title: string; description: string }> = {
  'regulatory-affairs': { title: s.regulatory.title, description: '伊朗药品注册法规事务：IFDA注册策略、CTD资料、GMP检查准备及生命周期维护，服务进入伊朗市场的生产企业。' },
  'contact-us-1': { title: s.contact.title, description: '联系德黑兰的Hanpars：制剂、原料药、辅料、营养原料及IFDA注册咨询。邮箱：contact@hanpars.com' },
  'blog-1': { title: s.insights.title, description: '行业洞察档案：中国原料药与制剂产业、供应链及监管趋势分析，面向伊朗医药市场。' },
  'import-activity': { title: '进口动态', description: 'Hanpars 2026 年进口动态：逾 3,300 万欧元、超过 1 亿单位药品，涵盖 30 种分子，货源来自土耳其、中国和英国。' },
  'news': { title: s.news.title, description: '每日全球医药要闻及中国制剂/原料药资讯，每天早晨更新，附来源与链接。' },
};
const name = data?.title || extra[page]?.title || page;
const str = (...v: unknown[]) => (v.find(x => typeof x === 'string' && x) as string) || '';
const seo = { title: `${name} | Hanpars`, description: str(data?.meta, data?.description, extra[page]?.description, s.footer.intro) };
const crumbs = [{ name: s.breadcrumbHome, path: '/zh' }, { name, path: `/zh/${page}` }];
---
<Layout title={seo.title} description={seo.description.slice(0, 200)} breadcrumbs={crumbs} keywords={pageKeywords(page, lang)} brand={page==='regulatory-affairs'?'regulatory':'default'}>
  {page==='regulatory-affairs'?<RegulatoryPage/>:page==='contact-us-1'?<ContactPage/>:page==='blog-1'?<InsightsPage/>:page==='news'?<NewsPage/>:page==='import-activity'?<ImportActivityPage/>:<StandardPage page={page as PageKey}/>}
</Layout>
