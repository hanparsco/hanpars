---
import Layout from '../../../../layouts/Layout.astro';
import AzIndex from '../../../../components/AzIndex.astro';
import { azPaths } from '../../../../data/az';
export function getStaticPaths() { return azPaths('api'); }
const { letter } = Astro.params;
const label = letter === '0-9' ? '0–9' : String(letter).toUpperCase();
---
<Layout noindex title={`Etkin maddeler A–Z: ${label} | Hanpars`} description={`Etkin maddeler, harf ${label}`}><AzIndex type="api" letter={letter!} /></Layout>
