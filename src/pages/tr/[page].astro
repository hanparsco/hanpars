---
import Layout from '../../layouts/Layout.astro';
import StandardPage from '../../components/StandardPage.astro';
import RegulatoryPage from '../../components/RegulatoryPage.astro';
import ContactPage from '../../components/ContactPage.astro';
import InsightsPage from '../../components/InsightsPage.astro';
import NewsPage from '../../components/NewsPage.astro';
import { pages, type PageKey } from '../../data/pages';
import { pagesL } from '../../data/locale';
import { pageKeywords } from '../../data/seo-keywords';
import { t } from '../../i18n';

export function getStaticPaths() {
  return [...Object.keys(pages), 'regulatory-affairs', 'contact-us-1', 'blog-1', 'news'].map(page=>({params:{page}}));
}
const lang = 'tr' as const;
const s = t(lang);
const page = Astro.params.page!;
const data = (pagesL[lang] as any)[page as PageKey];
const extra: Record<string, { title: string; description: string }> = {
  'regulatory-affairs': { title: s.regulatory.title, description: (s.regulatory as any).lede || '' },
  'contact-us-1': { title: s.contact.title, description: (s.contact as any).lede || '' },
  'blog-1': { title: s.insights.title, description: (s.insights as any).lede || '' },
  'news': { title: s.news.title, description: (s.news as any).lede || (s.news as any).intro || '' },
};
const name = data?.title || extra[page]?.title || page;
const seo = { title: `${name} | Hanpars`, description: data?.meta || data?.description || extra[page]?.description || '' };
const crumbs = [{ name: s.breadcrumbHome, path: '/tr' }, { name, path: `/tr/${page}` }];
---
<Layout title={seo.title} description={seo.description.slice(0, 200)} breadcrumbs={crumbs} keywords={pageKeywords(page, lang)} brand={page==='regulatory-affairs'?'regulatory':'default'}>
  {page==='regulatory-affairs'?<RegulatoryPage/>:page==='contact-us-1'?<ContactPage/>:page==='blog-1'?<InsightsPage/>:page==='news'?<NewsPage/>:<StandardPage page={page as PageKey}/>}
</Layout>
