---
import Layout from '../../layouts/Layout.astro';
import StandardPage from '../../components/StandardPage.astro';
import RegulatoryPage from '../../components/RegulatoryPage.astro';
import ContactPage from '../../components/ContactPage.astro';
import InsightsPage from '../../components/InsightsPage.astro';
import NewsPage from '../../components/NewsPage.astro';
import { pages, type PageKey } from '../../data/pages';
import { pagesL } from '../../data/locale';
import { pageKeywords } from '../../data/seo-keywords';
import { t } from '../../i18n';

export function getStaticPaths() {
  return [...Object.keys(pages), 'regulatory-affairs', 'contact-us-1', 'blog-1', 'news'].map(page=>({params:{page}}));
}
const lang = 'tr' as const;
const s = t(lang);
const page = Astro.params.page!;
const data = (pagesL[lang] as any)[page as PageKey];
const extra: Record<string, { title: string; description: string }> = {
  'regulatory-affairs': { title: s.regulatory.title, description: 'İran için düzenleyici işler: IFDA ruhsat stratejisi, CTD dosyaları, GMP denetim hazırlığı ve yaşam döngüsü yönetimi; İran pazarına girecek üreticiler için.' },
  'contact-us-1': { title: s.contact.title, description: 'Hanpars Tahran’da: bitmiş ilaç, API, yardımcı madde, takviye hammaddeleri ve IFDA ruhsatlandırma talepleriniz için iletişime geçin. contact@hanpars.com' },
  'blog-1': { title: s.insights.title, description: 'Bilgi arşivi: Çin API ve bitmiş doz sanayisi, tedarik zincirleri ve düzenleyici eğilimler üzerine İran ilaç pazarına yönelik analizler.' },
  'news': { title: s.news.title, description: 'Günün önemli küresel ilaç haberleri ve Çin FDF/API gelişmeleri; her sabah kaynak ve bağlantıyla birlikte güncellenir.' },
};
const name = data?.title || extra[page]?.title || page;
const str = (...v: unknown[]) => (v.find(x => typeof x === 'string' && x) as string) || '';
const seo = { title: `${name} | Hanpars`, description: str(data?.meta, data?.description, extra[page]?.description, s.footer.intro) };
const crumbs = [{ name: s.breadcrumbHome, path: '/tr' }, { name, path: `/tr/${page}` }];
---
<Layout title={seo.title} description={seo.description.slice(0, 200)} breadcrumbs={crumbs} keywords={pageKeywords(page, lang)} brand={page==='regulatory-affairs'?'regulatory':'default'}>
  {page==='regulatory-affairs'?<RegulatoryPage/>:page==='contact-us-1'?<ContactPage/>:page==='blog-1'?<InsightsPage/>:page==='news'?<NewsPage/>:<StandardPage page={page as PageKey}/>}
</Layout>
