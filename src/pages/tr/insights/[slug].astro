---
import Layout from '../../../layouts/Layout.astro';
import Article from '../../../components/ArticlePage.astro';
import articles from '../../../data/articles.json';
import { articleSummary } from '../../../data/text';
export function getStaticPaths() {
  return articles.map(article=>({params:{slug:article.slug},props:{article}}));
}
const { article } = Astro.props;
---
<Layout title={`${article.title} | Hanpars`} description={articleSummary(article).slice(0,155)} noindex canonicalPath={`/insights/${article.slug}`}><Article article={article}/></Layout>
