---
import Layout from '../../layouts/Layout.astro';
import Home from '../../components/Home.astro';
import { pageKeywords } from '../../data/seo-keywords';
const lang = 'tr' as const;
const meta = {
  zh: { title: 'Hanpars | 伊朗药品进口、原料药供应与药品注册服务', description: 'Hanpars（Haniya Parsan Darou）总部位于德黑兰，为伊朗市场进口制剂、原料药（API）、药用辅料和营养原料，并负责伊朗食品药品监督管理局（IFDA）注册。' },
  tr: { title: 'Hanpars | İran’a ilaç ithalatı, etkin madde tedariki ve ruhsatlandırma', description: 'Tahran merkezli Hanpars (Haniya Parsan Darou), İran pazarı için bitmiş ürün, etkin madde (API), yardımcı madde ve takviye hammaddesi ithal eder; İran Gıda ve İlaç İdaresi (IFDA) ruhsatlarını hazırlar.' },
}[lang];
---
<Layout title={meta.title} description={meta.description} keywords={pageKeywords('home', lang)}><Home /></Layout>
