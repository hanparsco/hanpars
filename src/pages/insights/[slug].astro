---
import Layout from '../../layouts/Layout.astro';
import Article from '../../components/ArticlePage.astro';
import articles from '../../data/articles.json';
import { articleSummary } from '../../data/text';
import { fullLangs } from '../../data/articles-i18n';
export function getStaticPaths() {
  return articles.map(article=>({params:{slug:article.slug},props:{article}}));
}
const { article } = Astro.props;
const langsWithBody = fullLangs(article.slug);   // en + any language with a full translated body
const skip = ['fa', 'zh', 'tr'].filter(l => !langsWithBody.includes(l));
---
<Layout title={`${article.title} | Hanpars Insights`} description={articleSummary(article).slice(0,155)} onlyLang={langsWithBody.length > 1 ? undefined : "en"} skipLangs={langsWithBody.length > 1 ? skip as any : []}><Article article={article}/></Layout>
