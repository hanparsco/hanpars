---
import Layout from '../../layouts/Layout.astro';
import Article from '../../components/ArticlePage.astro';
import articles from '../../data/articles.json';
import zhArt from '../../data/articles.zh.json';
import { articleSummary } from '../../data/text';
export function getStaticPaths() {
  return articles.map(article=>({params:{slug:article.slug},props:{article}}));
}
const { article } = Astro.props;
const zhFull = !!(zhArt.articles as Record<string, { content?: string }>)[article.slug]?.content;
---
<Layout title={`${article.title} | Hanpars Insights`} description={articleSummary(article).slice(0,155)} onlyLang={zhFull ? undefined : "en"} skipLangs={zhFull ? ["fa", "tr"] : []}><Article article={article}/></Layout>
