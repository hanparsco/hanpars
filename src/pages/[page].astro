---
import Layout from '../layouts/Layout.astro';
import StandardPage from '../components/StandardPage.astro';
import RegulatoryPage from '../components/RegulatoryPage.astro';
import ContactPage from '../components/ContactPage.astro';
import InsightsPage from '../components/InsightsPage.astro';
import ImportActivityPage from '../components/ImportActivityPage.astro';
import NewsPage from '../components/NewsPage.astro';
import { pages, type PageKey } from '../data/pages';

export function getStaticPaths() {
  return [...Object.keys(pages), 'regulatory-affairs', 'contact-us-1', 'blog-1', 'news', 'import-activity'].map(page=>({params:{page}}));
}
const page = Astro.params.page!;
import { pageKeywords } from '../data/seo-keywords';
const special: Record<string, { title: string; description: string }> = {
  'fdf': { title: 'Finished medicines: urgent import and supply in Iran | Hanpars', description: 'Urgent (emergency) import and supply of hospital, specialty and generic medicines for Iran: the Hanpars registered portfolio and a reference list of 3,885 products.' },
  'api': { title: 'Active pharmaceutical ingredients (API) supplier in Iran | Hanpars', description: 'API sourcing and import from GMP-certified manufacturers in China, India and Europe: 1,582 substances with CAS numbers, structures and DMF/CEP support.' },
  'excipient': { title: 'Pharmaceutical excipients supplier in Iran | Hanpars', description: 'Excipient sourcing and import: fillers, binders, disintegrants, lubricants, coatings and solvents. A reference list of 1,240 excipients with function and CAS number.' },
  'precursors': { title: 'Chemical precursors and API intermediates supplier for Iran | Hanpars', description: 'API starting materials, advanced intermediates and process reagents from qualified manufacturers, with CoA, route of synthesis and licences for controlled precursors.' },
  'supplies': { title: 'Pharmaceutical supplies and primary packaging for Iran | Hanpars', description: 'Vials, ampoules, rubber closures, blister foil, empty hard gelatin and HPMC capsules and production consumables, sourced to specification for manufacturers in Iran.' },
  'nutrition': { title: 'Supplement and nutrition ingredients supplier | Hanpars', description: 'Ingredients for pharmaceutical and food supplements: vitamins, minerals, omega-3, probiotics, botanicals and nutraceuticals — 295 ingredients.' },
  'china-to-iran': { title: 'How to export medicines and APIs from China to Iran: IFDA registration, importer, documents | Hanpars', description: 'Guide for Chinese manufacturers: products enter Iran through an IFDA-licensed importer that registers them (IRC), imports and distributes. Routes for FDF and API, documents, timelines, local manufacturing, common mistakes.' },
  'partners': { title: 'For foreign pharmaceutical manufacturers: your licensed importer and partner in Iran | Hanpars', description: 'IFDA-licensed importer and marketing authorisation holder, in-house registration and pharmacovigilance, nationwide distribution and written responsibilities. Offices in Tehran, Istanbul, Hangzhou and Zhenjiang.' },
  'fdf-cdmo': { title: 'Finished dosage form CDMO for Iran: development, manufacturing and IFDA registration | Hanpars', description: 'Contract development and manufacturing of finished dosage forms with qualified GMP partners, from formulation and technology transfer to CTD dossier, IFDA registration and supply in Iran.' },
  'about-us': { title: 'About Hanpars: pharmaceutical importer in Tehran, Iran', description: 'Haniya Parsan Darou Co. (Hanpars), Tehran: importer of medicines, APIs, excipients and supplement ingredients, and regulatory contact for foreign manufacturers.' },
  'markets': { title: 'Markets and suppliers: China, India, Türkiye, Europe | Hanpars', description: 'The Hanpars supply network: GMP-certified manufacturers in China, India, Türkiye and Europe, with nationwide distribution in Iran.' },
  'culture': { title: 'How we work: sourcing, import and registration | Hanpars', description: 'The principles behind every Hanpars sourcing, import and registration request: clear scope, complete documentation and one accountable contact.' },
  'regulatory-affairs': { title: 'Regulatory affairs and drug registration in Iran (IFDA) | Hanpars', description: 'Drug and API registration with the Iran FDA (IRC), CTD/eCTD dossiers, GMP, variations and renewals, plus filings with EMA, FDA, TİTCK and regional authorities.' },
  'contact-us-1': { title: 'Contact Hanpars: medicine and API enquiries, Tehran', description: 'Send a sourcing, regulatory or CDMO enquiry for medicines, APIs, excipients or supplement ingredients, or call the Tehran office on +98 21 8888 3325.' },
  'import-activity': { title: 'Import activity 2026: medicines imported into Iran | Hanpars', description: 'Hanpars import activity in 2026: over €33 million and 100 million units of medicines across 30 molecules, from Türkiye, China and the United Kingdom.' },
  'news': { title: 'Pharma news today: global and China API and finished dosage form news | Hanpars', description: 'The day’s key global pharmaceutical stories and China finished dosage form and API news, refreshed every morning with source and link.' },
  'blog-1': { title: 'Insights archive: China API market and sourcing | Hanpars', description: 'Archived Hanpars articles on the pharmaceutical market, China’s API industry, sourcing and regulation, with their original 2025 publication dates.' },
};
const crumbName: Record<string, string> = { fdf: 'Finished dosage forms', api: 'Active pharmaceutical ingredients', excipient: 'Excipients', nutrition: 'Supplement ingredients', precursors: 'Chemical precursors', supplies: 'Pharmaceutical supplies', 'fdf-cdmo': 'Finished dosage form CDMO', partners: 'For foreign manufacturers', 'china-to-iran': 'China to Iran export guide', 'about-us': 'About us', markets: 'Markets and sourcing', culture: 'How we work', 'regulatory-affairs': 'Regulatory affairs', 'contact-us-1': 'Contact', news: 'Pharma news today', 'import-activity': 'Import activity', 'blog-1': 'Insights archive' };
const data = pages[page as PageKey];
const seo = special[page] || {title:`${data?.title} | Hanpars`,description:data?.meta};
const crumbs = [{ name: 'Home', path: '/' }, { name: crumbName[page] || data?.title || page, path: `/${page}` }];
---
<Layout skipLangs={page==='partners'?['fa']:page==='china-to-iran'?['fa','tr']:[]} title={seo.title} description={seo.description} breadcrumbs={crumbs} keywords={pageKeywords(page, 'en')} brand={page==='regulatory-affairs'?'regulatory':'default'}>
  {page==='regulatory-affairs'?<RegulatoryPage/>:page==='contact-us-1'?<ContactPage/>:page==='blog-1'?<InsightsPage/>:page==='news'?<NewsPage/>:page==='import-activity'?<ImportActivityPage/>:<StandardPage page={page as PageKey}/>}
</Layout>
